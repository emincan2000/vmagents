# Maintainer: EminY <57416756+emincan2000@users.noreply.github.com>
pkgname=vmforai
pkgver=0.26.0
pkgrel=1
pkgdesc="Run AI coding agents (Claude Code, Codex, Gemini CLI, OpenCode, aider) inside a virtual machine"
arch=('any')
url="https://github.com/emincan2000/vmforai"
license=('MIT')
depends=('bash' 'openssh' 'curl' 'util-linux' 'python' 'git'
         'libvirt' 'virt-install' 'qemu-system-x86' 'qemu-img' 'libisoburn' 'dnsmasq')
provides=('vmagents')
conflicts=('vmagents')
replaces=('vmagents')
optdepends=('uv: fetches the terminal UI'"'"'s Python packages'
            'github-cli: pull requests (vmforai take --pr, vmforai fix)'
            'libnotify: desktop notifications'
            'xclip: the shared clipboard on X11'
            'wl-clipboard: the shared clipboard on Wayland'
            'sshfs: vmforai mount')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1ed3003b51dcc06d8f60f1a30df06331f3824cd3d5744cf9fca5f4c1f6f12e29')

check() {
  cd "$pkgname-$pkgver"
  [[ $(bash ./vmforai --version) == "vmforai $pkgver" ]]
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 vmforai "$pkgdir/usr/bin/vmforai"
  ln -s vmforai "$pkgdir/usr/bin/vmf"
  ln -s vmforai "$pkgdir/usr/bin/vmagents"
  ln -s vmforai "$pkgdir/usr/bin/vmclaude"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 README.tr.md "$pkgdir/usr/share/doc/$pkgname/README.tr.md"
}
