if [ "$(id -u)" = 0 ]; then su_=
elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then su_="sudo -n"
else echo "vmforai: no sudo on the VM: only the agents started by vmforai use the proxy" >&2; exit 0
fi
$su_ sh -c '\''
p=$1 n=localhost,127.0.0.1,::1
f=/etc/environment
if [ -f $f ]; then sed -i "/^# vmforai proxy (/,/^# vmforai proxy end$/d" $f; fi
{ echo "# vmforai proxy (vmforai net NAME open removes it)"
  for v in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do echo "$v=$p"; done
  echo "no_proxy=$n"; echo "NO_PROXY=$n"; echo "# vmforai proxy end"; } >>$f
if [ -d /etc/apt/apt.conf.d ]; then
  printf "Acquire::http::Proxy \"%s\";\nAcquire::https::Proxy \"%s\";\n" "$p" "$p" >/etc/apt/apt.conf.d/95vmforai-proxy
fi
if [ -d /etc/sudoers.d ]; then
  echo "Defaults env_keep += \"http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY\"" >/etc/sudoers.d/vmforai-proxy
  chmod 440 /etc/sudoers.d/vmforai-proxy
  if command -v visudo >/dev/null 2>&1 && ! visudo -cf /etc/sudoers.d/vmforai-proxy >/dev/null 2>&1; then rm -f /etc/sudoers.d/vmforai-proxy; fi
fi
'\'' vmforai "$p"
'

# shellcheck disable=SC2016
NET_GUEST_OFF_SH='rm -f "$HOME/.config/vmforai/proxy-env"
if [ "$(id -u)" = 0 ]; then su_=
elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then su_="sudo -n"
else exit 0
fi
$su_ sh -c '\''
[ -f /etc/environment ] && sed -i "/^# vmforai proxy (/,/^# vmforai proxy end$/d" /etc/environment
rm -f /etc/apt/apt.conf.d/95vmforai-proxy /etc/sudoers.d/vmforai-proxy
'\''
'

allow_file() { printf '%s/net/%s.allow' "$CONF_DIR" "$1"; }
net_log_file() { printf '%s/net-%s.log' "$CACHE_DIR" "$1"; }

NET_NAME='' NET_GW=''
net_gateway() { # the loaded VM's libvirt network and its address on this computer
  read -r NET_NAME < <(vsh domiflist "$C_DOMAIN" 2>/dev/null | awk '$2 == "network" { print $3; exit }') || true
  [[ -n $NET_NAME ]] || die "$NAME has no card on a libvirt network; its network cannot be restricted"
  NET_GW=$(vsh net-dumpxml "$NET_NAME" 2>/dev/null | sed -n "s/.*<ip address=['\"]\([0-9.]*\)['\"].*/\1/p" | head -n 1)
  [[ -n $NET_GW ]] || die "libvirt network $NET_NAME has no IPv4 address on this computer"
}

# The VM's network cards on libvirt networks, with the filter ($1 = on) or without.
set_net_filter() { # on|off
  local xml tmp out
  xml=$(vsh dumpxml --inactive "$C_DOMAIN") || die "libvirt: cannot read VM $C_DOMAIN"
  tmp=$(mktemp)
  ON=$1 FILTER=$NET_FILTER GW=$NET_GW PORT=${P[NETPORT]} awk '
    /^ *<interface type=.network./ { inif = 1 }
    inif && /<filterref / { skip = 1 }
    skip { if (/<\/filterref>/ || /<filterref [^>]*\/>/) skip = 0; next }
    inif && /^ *<\/interface>/ {
      if (ENVIRON["ON"] == "on") {
        print "      <filterref filter=\x27" ENVIRON["FILTER"] "\x27>"
        print "        <parameter name=\x27GATEWAY\x27 value=\x27" ENVIRON["GW"] "\x27/>"
        print "        <parameter name=\x27PROXY_PORT\x27 value=\x27" ENVIRON["PORT"] "\x27/>"
        print "      </filterref>"
      }
      inif = 0
    }
    { print }
  ' <<<"$xml" >"$tmp"
  out=$(vsh define "$tmp" 2>&1) || { rm -f "$tmp"; die "libvirt: $out"; }
  if [[ $(domstate) == running ]]; then
    # The running VM too: its card, with the new filter.
    # (Reads to the end: an early exit would make vsh fail on a closed pipe.)
    vsh dumpxml "$C_DOMAIN" | awk '!done && /^ *<interface type=.network./ { p = 1 } p { print } p && /<\/interface>/ { p = 0; done = 1 }' |
      ON=$1 FILTER=$NET_FILTER GW=$NET_GW PORT=${P[NETPORT]} awk '
        /<filterref / { skip = 1 }
        skip { if (/<\/filterref>/ || /<filterref [^>]*\/>/) skip = 0; next }
        /<\/interface>/ && ENVIRON["ON"] == "on" {
          print "<filterref filter=\x27" ENVIRON["FILTER"] "\x27><parameter name=\x27GATEWAY\x27 value=\x27" ENVIRON["GW"] "\x27/><parameter name=\x27PROXY_PORT\x27 value=\x27" ENVIRON["PORT"] "\x27/></filterref>"
        }
        { print }' >"$tmp"
    out=$(vsh update-device "$C_DOMAIN" "$tmp" --live 2>&1) || { rm -f "$tmp"; die "libvirt: $out"; }
  fi
  rm -f "$tmp"
}

# Starts the VM's proxy when its network is restricted (one per VM).
start_proxy() {
  [[ ${P[NET]:-open} == restricted && -n $C_DOMAIN && -n ${P[NETPORT]:-} ]] || return 0
  command -v python3 >/dev/null || die "the restricted network of $NAME needs python3 on this computer (for its proxy)"
  local self
  self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
  if command -v setsid >/dev/null; then
    setsid -f "$self" __proxy "$NAME" </dev/null >/dev/null 2>&1 || true
  else
    nohup "$self" __proxy "$NAME" </dev/null >/dev/null 2>&1 &
  fi
  sleep 0.3
}

cmd___proxy() {
  load "$1"
  command -v flock >/dev/null || return 0
  [[ ${P[NET]:-open} == restricted && -n ${P[NETPORT]:-} ]] || return 0
  local lock
  lock=${XDG_RUNTIME_DIR:-/tmp}/vmforai-proxy-$(id -u)-$NAME.lock
  exec 9>>"$lock"
  flock -n 9 || return 0  # one proxy per VM
  printf '%s\n' "$$" >"$lock.pid"
  net_gateway
  mkdir -p "$CACHE_DIR"
  exec python3 -c "$PROXY_PY" "$(allow_file "$NAME")" "$(net_log_file "$NAME")" "$NET_GW" "${P[NETPORT]}" \
    "$C_URI" "$C_DOMAIN"
}

stop_proxy() {
  local f pid
  f=${XDG_RUNTIME_DIR:-/tmp}/vmforai-proxy-$(id -u)-$NAME.lock.pid
  [[ -f $f ]] || return 0
  pid=$(<"$f")
  [[ $pid =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null
  rm -f "$f"
  return 0
}

net_blocked() { # the hosts refused lately, newest first, once each
  local f
  f=$(net_log_file "$NAME")
  [[ -f $f ]] || return 0
  tail -n 500 "$f" | awk '{ print $2 }' | tac | awk '!seen[$0]++' | head -n "${1:-15}" || true  # (head may close early)
}

cmd_net() {
  local name=${1:-} what=${2:-} p f port n out
  [[ -n $name ]] || usage_error "net: missing NAME"
  load "$name"
  f=$(allow_file "$NAME")
  case $what in
    "")
      say "Network of $NAME: ${P[NET]:-open}"
      if [[ ${P[NET]:-open} == restricted ]]; then
        say "Allowed (vmforai net $NAME allow HOST / deny HOST; the list: $f):"
        grep -v '^[[:space:]]*\(#\|$\)' "$f" 2>/dev/null | sed 's/^/  /' | paste -sd ' ' | fold -s -w 100 | sed 's/^/  /'
        out=$(net_blocked)
        if [[ -n $out ]]; then
          say "Refused lately:"
          say "  ${out//$'\n'/$'\n'  }"
        fi
      fi
      return 0 ;;
    allow | deny)
      (($# >= 3)) || usage_error "net: $what which host? e.g. $PROG net $NAME $what example.com"
      mkdir -p "${f%/*}"
      [[ -f $f ]] || printf '%s' "$NET_ALLOW_DEFAULT" >"$f"
      shift 2
      for p in "$@"; do
        p=${p,,}
        [[ $p =~ ^(\*\.)?[a-z0-9.-]+(:[0-9]+)?$ ]] || die "not a host name: $p (e.g. example.com, *.example.com, example.com:8443)"
        if [[ $what == allow ]]; then
          grep -qxF "$p" "$f" || printf '%s\n' "$p" >>"$f"
        else
          grep -vxF "$p" "$f" >"$f.tmp" || true
          mv -f "$f.tmp" "$f"
        fi
      done
      if [[ $what == allow ]]; then say "Allowed from $NAME: $*"; else say "Not allowed from $NAME any more: $*"; fi
      [[ ${P[NET]:-open} == restricted ]] || say "(The network of $NAME is open now; the list counts once it is restricted: $PROG net $NAME restricted)"
      return 0 ;;
    blocked)
      out=$(net_blocked 50)
      if [[ -n $out ]]; then say "$out"; else say "Nothing refused lately."; fi
      return 0 ;;
    restricted | open) ;;
    *) usage_error "net: open, restricted, allow HOST, deny HOST or blocked" ;;
  esac
  need_domain "a restricted network"
  [[ -n $C_DOMAIN ]] || die "$NAME is not a libvirt VM"
  [[ ${P[OS]:-linux} != windows ]] || die "the restricted network works with Linux VMs only"
  command -v python3 >/dev/null || die "the restricted network needs python3 on this computer (for its proxy)"
  if [[ $what == restricted ]]; then
    mkdir -p "${f%/*}"
    [[ -f $f ]] || printf '%s' "$NET_ALLOW_DEFAULT" >"$f"
    if [[ -z ${P[NETPORT]:-} ]]; then
      local used
      used=$(cat "$HOSTS_DIR"/*.conf 2>/dev/null | sed -n 's/^NETPORT=//p')
      for ((port = 18080; port < 18180; port++)); do
        [[ " $(tr '\n' ' ' <<<"$used") " == *" $port "* ]] && continue
        port_free "$port" && break
      done
      P[NETPORT]=$port
    fi
    port=${P[NETPORT]}
    net_gateway
    local tmp
    tmp=$(mktemp)
    printf '%s\n' "$NET_FILTER_XML" >"$tmp"
    out=$(vsh nwfilter-define "$tmp" 2>&1) || { rm -f "$tmp"; die "libvirt: $out"; }
    rm -f "$tmp"
    P[NET]=restricted
    write_profile "$NAME"
    set_net_filter on
    project_connect
    start_proxy
    run_ssh -T -- "$TARGET" "$(remote_cmd "$NET_GUEST_ON_SH" "http://$NET_GW:$port")" </dev/null ||
      warn "could not set the proxy on the VM"
    say "The network of $NAME is restricted: it reaches only the hosts on its list, through a proxy here"
    say "($NET_GW:$port). See and change the list: $PROG net $NAME; $PROG net $NAME allow HOST"
    say "Agents already running keep their old settings until they are started again."
    project_done
  else
    net_gateway
    P[NET]=open
    write_profile "$NAME"
    set_net_filter off
    project_connect  # (started if off: the proxy settings on the VM have to go)
    run_ssh -T -- "$TARGET" "$(remote_cmd "$NET_GUEST_OFF_SH")" </dev/null || warn "could not remove the proxy settings on the VM"
    stop_proxy
    say "The network of $NAME is open again."
    project_done
  fi
}

# ------------------------------------------------------------------ templates

# A template is what a new VM gets: system, RAM, CPUs, disk, agents, ports,
# packages (node, python, go, rust, build, or the distribution's own names)
# and a command run on it at the end (SETUP). Built in below; your own in
# ~/.config/vmforai/templates/NAME.conf (KEY=VALUE, the same keys).
TEMPLATE_KEYS=" DESCRIPTION IMAGE MEMORY CPUS DISK AGENTS PORTS PACKAGES SETUP "
TEMPLATES_BUILTIN='node|Node.js web app: Node, npm, build tools|debian13|4096|2|20|claude|3000,5173|node build|
python|Python: venv, pip, build tools|debian13|4096|2|20|claude|8000|python build|
ml|Python for data and ML: more RAM, CPUs and disk, Jupyter port|debian13|16384|8|60|claude|8888|python build|
go|Go: the go toolchain|debian13|4096|2|20|claude|8080|go build|
rust|Rust: rustup with stable Rust, build tools|debian13|4096|4|30|claude|8080|rust build|'

template_names() {
  local f
  cut -d'|' -f1 <<<"$TEMPLATES_BUILTIN"
  for f in "$CONF_DIR"/templates/*.conf; do [[ -f $f ]] && { f=${f##*/}; printf '%s\n' "${f%.conf}"; }; done
  return 0
}

# Loads template NAME into T[...] (DESCRIPTION IMAGE MEMORY CPUS DISK AGENTS PORTS PACKAGES SETUP).
declare -A T=()
load_template() { # NAME
  local name=$1 line k v f n=0
  T=()
  f=$CONF_DIR/templates/$name.conf
  if valid_name "$name" && [[ -f $f ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      n=$((n + 1))
      [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
      [[ $line =~ ^([A-Z_]+)=(.*)$ ]] || die "$f:$n: expected KEY=VALUE"
      k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
      [[ $TEMPLATE_KEYS == *" $k "* ]] || die "$f:$n: unknown key $k (keys:$TEMPLATE_KEYS)"
      T[$k]=$v
    done <"$f"
    return 0
  fi
  local d i m c dk ag po pk se
  while IFS='|' read -r k d i m c dk ag po pk se; do
    [[ $k == "$name" ]] || continue
    T=([DESCRIPTION]=$d [IMAGE]=$i [MEMORY]=$m [CPUS]=$c [DISK]=$dk [AGENTS]=$ag [PORTS]=$po [PACKAGES]=$pk [SETUP]=$se)
    return 0
  done <<<"$TEMPLATES_BUILTIN"
  T=()
  die "no template named '$name' (see: $PROG templates)"
}

# On the VM, after setup: the template's packages, then its SETUP command.
# $1 the SETUP command (or empty), then package names.
# shellcheck disable=SC2016
# A tool's packages, by package manager: node, python, go, java, build (a C
# compiler and make); rust comes from rustup; anything else is a package name.
# shellcheck disable=SC2016
TOOL_PKGS_SH='pkg_manager() {
  for m_ in apt-get dnf pacman zypper apk; do
    command -v "$m_" >/dev/null 2>&1 && { echo "${m_%-get}"; return 0; }
  done
  echo other
}
tool_pkgs() {
  case $1:$2 in
    dnf:node) echo nodejs nodejs-npm ;;
    zypper:node) echo nodejs-default npm-default ;;
    *:node) echo nodejs npm ;;
    apt:python) echo python3 python3-venv python3-pip ;;
    pacman:python) echo python python-pip ;;
    apk:python) echo python3 py3-pip ;;
    *:python) echo python3 python3-pip ;;
    apt:build) echo build-essential ;;
    pacman:build) echo base-devel ;;
    apk:build) echo build-base ;;
    *:build) echo gcc gcc-c++ make ;;
    apt:go | dnf:go) echo golang ;;
    *:go) echo go ;;
    apt:java) echo default-jdk ;;
    pacman:java) echo jdk-openjdk ;;
    dnf:java) echo java-latest-openjdk-devel ;;
    zypper:java) echo java-devel ;;
    apk:java) echo openjdk21 ;;
    *) echo "$2" ;;
  esac
}
'
TOOLS_KNOWN="node python go rust java build"

# On the VM: tools (above), then a command ($1, or empty; a template's SETUP).
# shellcheck disable=SC2016
TEMPLATE_SH=$REMOTE_ENV$PKG_SH$TOOL_PKGS_SH'setup=$1; shift
list= rust=
m=$(pkg_manager)
for p in "$@"; do
  case $p in
    rust) rust=1 list="$list $(tool_pkgs "$m" build)" ;;  # (crates want a C compiler)
    *) list="$list $(tool_pkgs "$m" "$p")" ;;
  esac
done
if [ -n "$list" ]; then
  # shellcheck disable=SC2086
  pkg $list || exit 1
fi
if [ -n "$rust" ] && ! command -v cargo >/dev/null 2>&1 && ! [ -x "$HOME/.cargo/bin/cargo" ]; then
  echo "Installing Rust (rustup, stable)..."
  curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal >/dev/null || exit 1
  echo "Installed $("$HOME/.cargo/bin/rustc" --version)"
fi
if [ -n "$setup" ]; then
  echo "Running the template'"'"'s setup: $setup"
  [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
  sh -c "$setup" || exit 1
fi
exit 0
'

# The same on Windows VMs, through Scoop (for the user; winget does not work
# over SSH): installed first when missing. Then each tool's Scoop package.
win_tools_ps() { # TOOL...
  local t names=''
  for t in "$@"; do names+="$(psq "$t"),"; done
  # shellcheck disable=SC2016 # PowerShell's $
  printf '$tools = @(%s)\n' "${names%,}"
  cat <<'EOF'
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
$shims = "$env:USERPROFILE\scoop\shims"
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
  if (Test-Path "$shims\scoop.ps1") { $env:PATH = "$shims;$env:PATH" }
}
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
  Write-Output "Installing Scoop (a package manager, for this user)..."
  $f = Join-Path $env:TEMP "install-scoop.ps1"
  & curl.exe -fsSL -o $f https://get.scoop.sh
  if ($LASTEXITCODE -ne 0) { [Console]::Error.WriteLine("vmforai: could not download Scoop"); exit 1 }
  $admin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator)
  # (*>&1: Write-Host would come through SSH as PowerShell's XML.)
  if ($admin) { & $f -RunAsAdmin *>&1 | Out-Null } else { & $f *>&1 | Out-Null }
  $env:PATH = "$shims;$env:PATH"
}
$pkgs = @()
foreach ($t in $tools) {
  switch ($t) {
    "node" { $pkgs += "nodejs-lts" }
    "python" { $pkgs += "python" }
    "go" { $pkgs += "go" }
    "rust" { $pkgs += "rustup-gnu" }
    "java" { & scoop bucket add java *>&1 | Out-Null; $pkgs += "java/temurin-lts-jdk" }
    "build" { $pkgs += "gcc" }
    default { $pkgs += $t }
  }
}
& scoop install @pkgs *>&1 | ForEach-Object { "$_" }
$bad = @()
foreach ($p in $pkgs) {
  $n = ($p -split "/")[-1]
  if (-not (& scoop prefix $n 2>$null 6>$null)) { $bad += $n }
}
if ($bad) { [Console]::Error.WriteLine("vmforai: not installed: " + ($bad -join ", ")); exit 1 }
Write-Output ("Installed: " + ($pkgs -join ", ") + ". New shells find them (Scoop's shims are on the PATH).")
exit 0
EOF
}

cmd_tools() {
  local name='' t
  local -a tools=()
  while (($#)); do
    case $1 in
      -*) usage_error "tools: unknown option $1" ;;
      *) if [[ -z $name ]]; then name=$1; else tools+=("$1"); fi ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "tools: missing NAME"
  if ((!${#tools[@]})); then
    say "Tools for a VM: $TOOLS_KNOWN (or a package's own name)."
    say "  $PROG tools $name node python    Linux: the distribution's packages; Windows: Scoop"
    return 0
  fi
  for t in "${tools[@]}"; do
    [[ $t =~ ^[A-Za-z0-9][A-Za-z0-9._+/-]*$ ]] || usage_error "tools: not a tool or package name: $t"
  done
  load "$name"
  project_connect
  info "Installing on $NAME: ${tools[*]}"
  local rc=0
  if [[ $C_OS == windows ]]; then
    win_run "$(win_tools_ps "${tools[@]}")" || rc=$?
  else
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$TEMPLATE_SH" "" "${tools[@]}")" </dev/null || rc=$?
  fi
  project_done
  ((rc == 0)) || die "installing them on $NAME failed (see above)"
  say "Done: ${tools[*]} on $NAME."
}

cmd_templates() {
  local json=0 n sep=''
  [[ ${1-} == --json ]] && json=1
  if ((json)); then
    printf '['
    while IFS= read -r n; do
      [[ -n $n ]] || continue
      load_template "$n"
      printf '%s\n {"name": %s, "description": %s, "image": %s, "memory": %s, "cpus": %s, "disk": %s, "agents": %s, "ports": %s, "packages": %s, "setup": %s}' \
        "$sep" "$(json_str "$n")" "$(json_str "${T[DESCRIPTION]:-}")" "$(json_str "${T[IMAGE]:-debian13}")" \
        "${T[MEMORY]:-4096}" "${T[CPUS]:-2}" "${T[DISK]:-20}" "$(json_list "${T[AGENTS]:-claude}")" \
        "$(json_list "${T[PORTS]:-}" NUM)" "$(json_list "${T[PACKAGES]// /,}")" "$(json_str "${T[SETUP]:-}")"
      sep=,
    done < <(template_names)
    printf '\n]\n'
    return 0
  fi
  printf '%-10s %-12s %-6s %-5s %-6s %-14s %s\n' TEMPLATE SYSTEM RAM CPUS DISK PORTS WHAT
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    load_template "$n"
    printf '%-10s %-12s %-6s %-5s %-6s %-14s %s\n' "$n" "${T[IMAGE]:-debian13}" "$(( ${T[MEMORY]:-4096} / 1024 )) GB" \
      "${T[CPUS]:-2}" "${T[DISK]:-20} GB" "${T[PORTS]:--}" "${T[DESCRIPTION]:-}"
  done < <(template_names)
  say ""
  say "Use one: $PROG create NAME --template node   (other options change it, e.g. --memory 8192)"
  say "Your own: ${CONF_DIR/#$HOME/\~}/templates/NAME.conf with lines like IMAGE=arch, MEMORY=8192,"
  say "PACKAGES=node build htop, SETUP=npm install -g pnpm"
}

# ------------------------------------------------------------------ history: Claude's sessions on the VM

# Claude Code keeps each conversation in ~/.claude/projects/DIR/ID.jsonl on
# the VM. "list": a JSON line per session, newest first; "show ID": one,
# readable (what you asked, what it answered, a line per tool it used).
HISTORY_PY='import glob, json, os, sys
root = os.path.expanduser("~/.claude/projects")
files = sorted(glob.glob(os.path.join(root, "*", "*.jsonl")), key=os.path.getmtime, reverse=True)

def entries(f):
    with open(f, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict):
                yield e

def text(content):
    if isinstance(content, str):
        return content
    return "\n".join(c.get("text", "") for c in content or [] if isinstance(c, dict) and c.get("type") == "text")

def asked(e):
    """What you typed, or None (tool results, commands, notes)."""
    if e.get("type") != "user" or e.get("isMeta"):
        return None
    t = text((e.get("message") or {}).get("content")).strip()
    return t if t and not t.startswith("<") else None

def short(v, n=110):
    v = " ".join(str(v).split())
    return v if len(v) <= n else v[:n - 1] + "…"

if sys.argv[1] == "list":
    for f in files:
        first, cwd, start, n = "", "", "", 0
        for e in entries(f):
            cwd = cwd or e.get("cwd") or ""
            start = start or e.get("timestamp") or ""
            if e.get("type") == "assistant":
                n += 1
            q = asked(e)
            if q is not None:
                n += 1
                first = first or short(q, 200)
        if n:
            print(json.dumps({"id": os.path.basename(f)[:-6], "time": int(os.path.getmtime(f)), "start": start,
                              "dir": cwd, "messages": n, "first": first}))
else:
    f = next((f for f in files if os.path.basename(f)[:-6] == sys.argv[2]), None)
    if f is None:
        sys.exit(4)
    for e in entries(f):
        q = asked(e)
        if q is not None:
            print("> " + q.replace("\n", "\n  ") + "\n")
        elif e.get("type") == "assistant":
            for c in (e.get("message") or {}).get("content") or []:
                if not isinstance(c, dict):
                    continue
                if c.get("type") == "text" and c.get("text", "").strip():
                    print(c["text"].strip() + "\n")
                elif c.get("type") == "tool_use":
                    i = c.get("input") or {}
                    arg = i.get("command") or i.get("file_path") or i.get("pattern") or i.get("url") or \
                        i.get("description") or ""
                    print("* %s(%s)" % (c.get("name"), short(arg)))
'

# shellcheck disable=SC2016
HISTORY_SH=$REMOTE_ENV'command -v python3 >/dev/null 2>&1 || { echo "vmforai: history needs python3 on the VM" >&2; exit 3; }
exec python3 -c "$1" "$2" "${3-}"
'

history_list() { # prints the sessions' JSON lines
  run_ssh -T -- "$TARGET" "$(remote_cmd "$HISTORY_SH" "$HISTORY_PY" list)" </dev/null
}

cmd_history() {
  local name='' which='' json=0 out line id rc=0 i=0 sep=''
  while (($#)); do
    case $1 in
      --json) json=1 ;;
      -*) usage_error "history: unknown option $1" ;;
      *) if [[ -z $name ]]; then name=$1; elif [[ -z $which ]]; then which=$1; else usage_error "history: too many arguments"; fi ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "history: missing NAME"
  load "$name"
  project_connect
  out=$(history_list) || rc=$?
  ((rc == 0)) || { project_done; die "could not read the sessions on $NAME (exit code $rc)"; }
  if [[ -n $which ]]; then
    # A number from the list, or a session ID.
    if [[ $which =~ ^[0-9]+$ ]]; then
      id=$(sed -n "${which}p" <<<"$out" | sed -n 's/^{"id": "\([^"]*\)".*/\1/p')
      [[ -n $id ]] || { project_done; die "no session $which on $NAME (see: $PROG history $NAME)"; }
    else
      id=$which
    fi
    run_ssh -T -- "$TARGET" "$(remote_cmd "$HISTORY_SH" "$HISTORY_PY" show "$id")" </dev/null || rc=$?
    project_done
    ((rc == 0)) || die "no session $which on $NAME"
    say ""
    say "Go on with it: $PROG $NAME --resume $id"
    return 0
  fi
  project_done
  if ((json)); then
    printf '['
    while IFS= read -r line; do [[ $line == "{"* ]] && { printf '%s\n %s' "$sep" "$line"; sep=,; }; done <<<"$out"
    printf '\n]\n'
    return 0
  fi
  [[ -n $out ]] || { say "No Claude Code sessions on $NAME yet."; return 0; }
  printf '%-3s %-17s %-5s %-22s %s\n' N WHEN MSGS FOLDER "FIRST ASKED"
  while IFS= read -r line; do
    [[ $line == "{"* ]] || continue
    i=$((i + 1))
    python3 -c 'import json, sys, time
e = json.loads(sys.argv[1])
d = e["dir"].replace(sys.argv[3], "~", 1) if sys.argv[3] and e["dir"].startswith(sys.argv[3]) else e["dir"]
print("%-3s %-17s %-5s %-22s %s" % (sys.argv[2], time.strftime("%Y-%m-%d %H:%M", time.localtime(e["time"])),
      e["messages"], d[-22:], e["first"][:70]))' "$line" "$i" "/home/$C_USER" 2>/dev/null || printf '%s\n' "$line"
  done <<<"$out"
  say ""
  say "Read one: $PROG history $NAME N    go on with one: $PROG $NAME --resume ID ($PROG history $NAME N shows it)"
}

# ------------------------------------------------------------------ phone

# The phone opens the VMs in its browser: a small web server here (PHONE_PY)
# lists them and gives each a terminal on the page, which runs "vmforai
# NAME" (or "vmforai shell NAME") on this computer. It listens on this
# computer's Tailscale address (encrypted end to end, nothing open to the
# internet), or with --lan on the local network, and answers only who has
# its key (in the link and the QR code). SSH apps get a port per VM, which
# leads to the VM's SSH server and starts the VM when it is off.

PHONE_DIR=$CONF_DIR/phone
PHONE_PORT=7700

phone_conf() { # LISTEN (tailscale|lan) and PORT, from the phone folder
  PHONE_LISTEN=tailscale
  local k v
  [[ -f $PHONE_DIR/conf ]] || return 0
  while IFS='=' read -r k v; do
    case $k in
      LISTEN) [[ $v == lan || $v == tailscale ]] && PHONE_LISTEN=$v ;;
      PORT) [[ $v =~ ^[0-9]+$ ]] && ((v > 0 && v < 65536)) && PHONE_PORT=$v ;;
    esac
  done <"$PHONE_DIR/conf"
}

phone_save() {
  mkdir -p "$PHONE_DIR"
  printf 'LISTEN=%s\nPORT=%s\n' "$PHONE_LISTEN" "$PHONE_PORT" >"$PHONE_DIR/conf"
}

PHONE_ADDR=''
phone_addr() { # sets PHONE_ADDR, this computer's address the phone reaches
  if [[ -n ${VMFORAI_PHONE_ADDR:-} ]]; then  # tests
    PHONE_ADDR=$VMFORAI_PHONE_ADDR
    return 0
  fi
  if [[ $PHONE_LISTEN == lan ]]; then
    PHONE_ADDR=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p') || PHONE_ADDR=''
    [[ -n $PHONE_ADDR ]] || die "this computer has no local network address (is it on a network?)"
    return 0
  fi
  local hint="the phone reaches this computer over Tailscale (free; encrypted; works from anywhere):
  this computer: curl -fsSL https://tailscale.com/install.sh | sh && sudo tailscale up
  the phone:     the Tailscale app, signed in with the same account
Only on the same Wi-Fi, without Tailscale: $PROG phone --lan"
  command -v tailscale >/dev/null || die "Tailscale is not installed; $hint"
  PHONE_ADDR=$(tailscale ip -4 2>/dev/null | head -n 1) || PHONE_ADDR=''
  [[ $PHONE_ADDR =~ ^[0-9.]+$ ]] || die "Tailscale is not connected on this computer (sudo tailscale up); $hint"
}

phone_pid_file() { printf '%s/vmforai-phone-%s.lock.pid' "${XDG_RUNTIME_DIR:-/tmp}" "$(id -u)"; }

PHONE_RUNNING=''
phone_running() { # 0 when the server runs; PHONE_RUNNING: its "ADDRESS PORT"
  local f pid addr port
  f=$(phone_pid_file)
  [[ -f $f ]] || return 1
  read -r pid addr port <"$f" || return 1
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  PHONE_RUNNING="$addr $port"
}

phone_stop() {
  local f pid
  # (and one started under the old name, vmagents)
  for f in "$(phone_pid_file)" "${XDG_RUNTIME_DIR:-/tmp}/vmagents-phone-$(id -u).lock.pid"; do
    [[ -f $f ]] || continue
    read -r pid _ <"$f" || true
    [[ $pid =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null
    rm -f -- "${f:?}"
  done
  return 0
}

# Starts the server (again, when its address or port changed).
phone_ensure() {
  if phone_running; then
    [[ $PHONE_RUNNING == "$PHONE_ADDR $PHONE_PORT" ]] && return 0
    phone_stop
    sleep 0.3
  fi
  local self i
  self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
  setsid -f "$self" __phone "$PHONE_ADDR" "$PHONE_PORT" </dev/null >/dev/null 2>&1 || die "could not start the phone server"
  for ((i = 0; i < 50; i++)); do
    (exec 3<>"/dev/tcp/$PHONE_ADDR/$PHONE_PORT") 2>/dev/null && return 0
    sleep 0.1
  done
  die "the phone server does not answer on $PHONE_ADDR:$PHONE_PORT (port taken? another one: $PROG phone --port N; log: $CACHE_DIR/phone.log)"
}

cmd___phone() { # ADDRESS PORT
  command -v flock >/dev/null || die "the phone server needs flock (util-linux)"
  local lock self
  lock=$(phone_pid_file)
  lock=${lock%.pid}
  exec 9>>"$lock"
  flock -n 9 || return 0  # one at a time
  printf '%s %s %s\n' "$$" "$1" "$2" >"$lock.pid"
  self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
  mkdir -p "$CACHE_DIR"
  VMFORAI_CACHE=$CACHE_DIR exec python3 -c "$PHONE_PY" "$self" "$PHONE_DIR" "$1" "$2"
}

# __addr NAME: the VM's SSH address and port (started first when needed).
cmd___addr() {
  load "$1"
  resolve_target >/dev/null
  printf '%s %s\n' "$TARGET" "$C_PORT"
}

phone_token() { # [new]: prints the key, made when there is none (or new)
  if [[ ${1:-} == new || ! -s $PHONE_DIR/token ]]; then
    (umask 077 && mkdir -p "$PHONE_DIR" && head -c 24 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n' >"$PHONE_DIR/token") ||
      die "could not write $PHONE_DIR/token"
  fi
  chmod 700 "$PHONE_DIR"
  cat "$PHONE_DIR/token"
}

# shellcheck disable=SC2016
RMKEY_SH='umask 077
k=$(cat)
f=$HOME/.ssh/authorized_keys
[ -f "$f" ] || exit 0
grep -vxF "$k" "$f" >"$f.vmforai"
mv "$f.vmforai" "$f" && chmod 600 "$f"
'

win_rmkey_ps() { # PUBKEY
  cat <<EOF
\$k = $(psq "$1")
foreach (\$f in @("\$env:USERPROFILE\.ssh\authorized_keys", "\$env:ProgramData\ssh\administrators_authorized_keys")) {
  if (Test-Path -LiteralPath \$f) {
    \$lines = @(Get-Content -LiteralPath \$f | Where-Object { \$_ -ne "" -and \$_ -ne \$k })
    try { Set-Content -LiteralPath \$f -Value \$lines -Encoding Ascii } catch { }
  }
}
exit 0
EOF
}

phone_ssh_lines() { [[ -f $PHONE_DIR/ssh ]] && cat "$PHONE_DIR/ssh"; return 0; }

phone_user() { # NAME: the VM's user
  read_profile "$1" 2>/dev/null
  printf '%s' "${P[USER]:-$(id -un)}"
}

phone_ssh() { # NAME KEY|FILE|off
  local name=${1:-} what=${2:-} key port used
  [[ -n $name && -n $what && $# -eq 2 ]] ||
    usage_error "phone ssh: give NAME and the SSH app's public key (or a file with it), or off"
  load "$name"
  phone_conf
  if [[ $what == off ]]; then
    [[ -f $PHONE_DIR/$NAME.pub ]] || die "no SSH app is let into $NAME"
    key=$(<"$PHONE_DIR/$NAME.pub")
    project_connect
    if [[ $C_OS == windows ]]; then
      run_ssh -T -- "$TARGET" "$(win_cmd "$(win_rmkey_ps "$key")")" </dev/null || warn "could not remove the key from the VM"
    else
      printf '%s\n' "$key" | run_ssh -T -- "$TARGET" "$(remote_cmd "$RMKEY_SH")" || warn "could not remove the key from the VM"
    fi
    project_done
    phone_ssh_lines | awk -v n="$NAME" '$1 != n' >"$PHONE_DIR/ssh.new" && mv "$PHONE_DIR/ssh.new" "$PHONE_DIR/ssh"
    rm -f -- "${PHONE_DIR:?}/${NAME:?}.pub"
    say "The SSH app's key is removed from $NAME, and its port closed."
    return 0
  fi
  key=$what
  [[ -f $what ]] && key=$(<"$what")
  key=$(printf '%s' "$key" | tr -d '\r' | sed -n '/[^[:space:]]/{s/^[[:space:]]*//;s/[[:space:]]*$//;p;q;}')
  [[ $key =~ ^(ssh-(ed25519|rsa|dss)|ecdsa-sha2-nistp(256|384|521)|sk-[a-z0-9@.-]+)\ [A-Za-z0-9+/]+=*(\ .*)?$ ]] ||
    die "not an SSH public key (it starts with ssh-ed25519, ssh-rsa, ...; the SSH app shows it, often under Keys)"
  phone_addr
  project_connect
  if [[ $C_OS == windows ]]; then
    run_ssh -T -- "$TARGET" "$(win_cmd "$(win_addkey_ps "$key")")" </dev/null >/dev/null || die "could not add the key on the VM"
  else
    printf '%s\n' "$key" | run_ssh -T -- "$TARGET" "$(remote_cmd "$ADDKEY_SH")" || die "could not add the key on the VM"
  fi
  project_done
  mkdir -p "$PHONE_DIR"
  printf '%s\n' "$key" >"$PHONE_DIR/$NAME.pub"
  port=$(phone_ssh_lines | awk -v n="$NAME" '$1 == n { print $2; exit }')
  if [[ -z $port ]]; then
    used=" $(phone_ssh_lines | awk '{ printf "%s ", $2 }')"
    for ((port = PHONE_PORT + 1; port < 65536; port++)); do
      [[ $used == *" $port "* ]] || break
    done
    printf '%s %s\n' "$NAME" "$port" >>"$PHONE_DIR/ssh"
  fi
  phone_token >/dev/null
  phone_ensure
  say "The SSH app can go into $NAME now. In the app:"
  say "  host $PHONE_ADDR   port $port   user $C_USER   key: the app's own"
  say "  (ssh -p $port $C_USER@$PHONE_ADDR)"
  say "A VM that is off starts when the app connects (that takes a minute: connect again if the app gives up)."
  say "Claude Code opens on login when autostart is on ($PROG autostart $NAME on)."
}

cmd_phone() {
  local new=0 json=0 listen='' port='' url token rows line sep='' name
  case ${1:-} in
    ssh) shift; phone_ssh "$@"; return ;;
    notify) shift; phone_notify "$@"; return ;;
    off)
      (($# == 1)) || usage_error "phone off: no more arguments"
      phone_stop
      say "Phone access is off. (On again: $PROG phone; the link stays the same.)"
      return 0 ;;
    on) shift ;;
  esac
  while (($#)); do
    case $1 in
      --new) new=1 ;;
      --lan) listen=lan ;;
      --tailscale) listen=tailscale ;;
      --port)
        if ! [[ ${2:-} =~ ^[0-9]+$ ]] || ((10#$2 < 1 || 10#$2 > 65535)); then usage_error "phone: --port needs a port number"; fi
        port=$((10#$2)); shift ;;
      --json) json=1 ;;
      *) usage_error "phone: unknown argument $1" ;;
    esac
    shift
  done
  command -v python3 >/dev/null || die "phone access needs python3 on this computer"
  phone_conf
  [[ -n $listen ]] && PHONE_LISTEN=$listen
  [[ -n $port ]] && PHONE_PORT=$port
  [[ -n $listen$port ]] && phone_save
  phone_addr
  if ((new)); then token=$(phone_token new); else token=$(phone_token); fi
  phone_ensure
  url="http://$PHONE_ADDR:$PHONE_PORT/#t=$token"
  mapfile -t rows < <(python3 -c "$QR_PY" "$url")
  if ((json)); then
    printf '{"on": true, "listen": %s, "address": %s, "port": %d, "url": %s, "qr": [' "$(json_str "$PHONE_LISTEN")" \
      "$(json_str "$PHONE_ADDR")" "$PHONE_PORT" "$(json_str "$url")"
    for line in "${rows[@]}"; do printf '%s%s' "$sep" "$(json_str "$line")"; sep=', '; done
    printf '], "ssh": ['
    sep=''
    while read -r name port; do
      [[ -n $name ]] || continue
      printf '%s{"name": %s, "port": %d, "user": %s}' "$sep" "$(json_str "$name")" "$port" "$(json_str "$(phone_user "$name")")"
      sep=', '
    done < <(phone_ssh_lines)
    printf ']}\n'
    return 0
  fi
  if [[ $PHONE_LISTEN == lan ]]; then
    say "Phone access is on, on the local network ($PHONE_ADDR): the phone must be on the same Wi-Fi."
    say "(Others on that network could read along; over Tailscale it is encrypted: $PROG phone --tailscale)"
  else
    say "Phone access is on, over Tailscale: the phone needs the Tailscale app, with the same account."
  fi
  say "Scan the code with the phone's camera, or open the link there:"
  say ""
  if [[ -t 1 ]]; then
    for line in "${rows[@]}"; do printf '  \e[97;40m%s\e[0m\n' "$line"; done
  else
    printf '  %s\n' "${rows[@]}"
  fi
  say ""
  say "  $url"
  say ""
  say "There: your VMs; tap one for its agent (or a shell), in a terminal on the phone."
  say "The link is the key: share it with no one. A new one (the old one stops working): $PROG phone --new"
  while read -r name port; do
    [[ -n $name ]] && say "SSH app into $name: ssh -p $port $(phone_user "$name")@$PHONE_ADDR"
  done < <(phone_ssh_lines)
  say "An SSH app instead of the browser: $PROG phone ssh NAME \"its public key\"    off: $PROG phone off"
}

# ---- notifications on the phone, through ntfy

# ntfy (ntfy.sh, or a server of your own) passes messages on to its app on
# the phone. They go to a topic with a random name, which is what keeps
# others out. The file phone/ntfy: SERVER=, TOPIC=, TOKEN= (an access token,
# for a server that wants one).
NTFY_SERVER='' NTFY_TOPIC='' NTFY_TOKEN=''
ntfy_conf() { # 0 when they are on
  NTFY_SERVER='' NTFY_TOPIC='' NTFY_TOKEN=''
  local k v
  [[ -f $PHONE_DIR/ntfy ]] || return 1
  while IFS='=' read -r k v; do
    case $k in
      SERVER) [[ $v =~ ^https?://[^[:space:]]+$ ]] && NTFY_SERVER=${v%/} ;;
      TOPIC) [[ $v =~ ^[A-Za-z0-9_-]{1,64}$ ]] && NTFY_TOPIC=$v ;;
      TOKEN) [[ $v =~ ^[A-Za-z0-9_.-]+$ ]] && NTFY_TOKEN=$v ;;
    esac
  done <"$PHONE_DIR/ntfy"
  [[ -n $NTFY_SERVER && -n $NTFY_TOPIC ]]
}

ntfy_save() {
  (umask 077 && mkdir -p "$PHONE_DIR" &&
    printf 'SERVER=%s\nTOPIC=%s\nTOKEN=%s\n' "$NTFY_SERVER" "$NTFY_TOPIC" "$NTFY_TOKEN" >"$PHONE_DIR/ntfy") ||
    die "could not write $PHONE_DIR/ntfy"
  chmod 700 "$PHONE_DIR"
}

# TITLE BODY to the phone. KIND (done, failed, waiting) sets its mark and how
# loud it is; tapping it opens the VM NAME on the phone page, when that runs.
ntfy_send() { # TITLE BODY [KIND] [NAME]
  ntfy_conf || return 0
  command -v curl >/dev/null || return 1
  local tag='' prio=3 click='' json
  local -a auth=()
  case ${3:-} in
    done) tag=white_check_mark ;;
    failed) tag=warning prio=4 ;;
    waiting) tag=bell prio=4 ;;
  esac
  phone_running && click="http://${PHONE_RUNNING% *}:${PHONE_RUNNING#* }/${4:+#vm=$4}"
  json=$(printf '{"topic": %s, "title": %s, "message": %s, "priority": %d%s%s}' "$(json_str "$NTFY_TOPIC")" \
    "$(json_str "$1")" "$(json_str "${2:- }")" "$prio" "${tag:+, \"tags\": [\"$tag\"]}" \
    "${click:+, \"click\": $(json_str "$click")}")
  [[ -n $NTFY_TOKEN ]] && auth=(-H "Authorization: Bearer $NTFY_TOKEN")
  curl -fsS -m 10 "${auth[@]}" -H "Content-Type: application/json" -d "$json" "$NTFY_SERVER" >/dev/null 2>&1
}

# On this computer's desktop and on the phone.
notify_all() { # TITLE BODY [KIND]
  notify-send -a vmforai "$1" "$2" 2>/dev/null || true
  ntfy_send "$1" "$2" "${3:-}" "${NAME:-}" || true
}

phone_notify() { # [off|test] [--server URL] [--token TOKEN] [--status] [--json]
  local what='' server='' token='' token_set=0 status=0 json=0 sent='' url app line host
  while (($#)); do
    case $1 in
      off | test) [[ -z $what ]] || usage_error "phone notify: one of off or test"; what=$1 ;;
      --server)
        [[ ${2:-} =~ ^https?://[^[:space:]/]+/?$ ]] || usage_error "phone notify: --server takes an address like https://ntfy.example.com"
        server=${2%/}; shift ;;
      --token)
        [[ ${2:-} =~ ^[A-Za-z0-9_.-]*$ && $# -ge 2 ]] || usage_error "phone notify: --token takes an access token (empty: none)"
        token=$2 token_set=1; shift ;;
      --status) status=1 ;;
      --json) json=1 ;;
      *) usage_error "phone notify: unknown argument $1" ;;
    esac
    shift
  done
  if [[ $what == off ]]; then
    rm -f -- "${PHONE_DIR:?}/ntfy"
    ((json)) && { printf '{"on": false}\n'; return 0; }
    say "Notifications on the phone are off. (On again: $PROG phone notify; that makes a new topic.)"
    return 0
  fi
  if ((!status)); then
    if ! ntfy_conf; then
      NTFY_SERVER=https://ntfy.sh
      NTFY_TOPIC=vmforai-$(head -c 15 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n')
    fi
    [[ -n $server ]] && NTFY_SERVER=$server
    ((token_set)) && NTFY_TOKEN=$token
    ntfy_save
    if [[ -z $what || $what == test ]]; then
      command -v curl >/dev/null || die "notifications on the phone need curl on this computer"
      if ntfy_send "vmforai" "Notifications from vmforai work. They come when a task or a fix ends, and when an agent waits for you." "done"; then
        sent=true
      else
        sent=false
      fi
    fi
  fi
  if ! ntfy_conf; then
    ((json)) && { printf '{"on": false}\n'; return 0; }
    say "Notifications on the phone are off. On: $PROG phone notify"
    return 0
  fi
  url=$NTFY_SERVER/$NTFY_TOPIC
  host=${NTFY_SERVER#*://}
  app="ntfy://$host/$NTFY_TOPIC"
  [[ $NTFY_SERVER == http://* ]] && app+="?secure=false"
  if ((json)); then
    printf '{"on": true, "server": %s, "topic": %s, "url": %s, "app": %s, "sent": %s}\n' "$(json_str "$NTFY_SERVER")" \
      "$(json_str "$NTFY_TOPIC")" "$(json_str "$url")" "$(json_str "$app")" "${sent:-null}"
    return 0
  fi
  say "Notifications on the phone are on, through $host: when a task or a fix ends, and when an agent waits for you."
  say "On the phone: the ntfy app (Android: Play Store or F-Droid; iPhone: App Store), subscribed to this"
  say "topic. Scan the code, or in the app: + and the topic's name."
  say ""
  if command -v python3 >/dev/null; then
    if [[ -t 1 ]]; then
      while IFS= read -r line; do printf '  \e[97;40m%s\e[0m\n' "$line"; done < <(python3 -c "$QR_PY" "$url")
    else
      python3 -c "$QR_PY" "$url" | sed 's/^/  /'
    fi
    say ""
  fi
  say "  $url"
  say "  topic: $NTFY_TOPIC"
  say ""
  case $sent in
    true) say "A test notification was sent." ;;
    false) warn "the test notification did not get through to $NTFY_SERVER (no internet? a server that wants a --token?)" ;;
  esac
  say "The topic's name works like a password: share it with no one. What the notifications say (VM names,"
  say "a task's first line) passes through $host; a server of your own: $PROG phone notify --server URL"
  say "Off: $PROG phone notify off    a test: $PROG phone notify test"
}

QR_PY=$(cat <<'QR_END'
import sys

# QR code (ISO 18004), byte mode, error correction level M, versions 1-9.
# (version: (EC codewords per block, [(blocks, data codewords per block)]))
BLOCKS = {1: (10, [(1, 16)]), 2: (16, [(1, 28)]), 3: (26, [(1, 44)]), 4: (18, [(2, 32)]),
          5: (24, [(2, 43)]), 6: (16, [(4, 27)]), 7: (18, [(4, 31)]), 8: (22, [(2, 38), (2, 39)]),
          9: (22, [(3, 36), (2, 37)])}
ALIGN = {2: [6, 18], 3: [6, 22], 4: [6, 26], 5: [6, 30], 6: [6, 34], 7: [6, 22, 38], 8: [6, 24, 42],
         9: [6, 26, 46]}

EXP, LOG = [0] * 512, [0] * 256
x = 1
for i in range(255):
    EXP[i] = x
    LOG[x] = i
    x <<= 1
    if x & 0x100:
        x ^= 0x11D
for i in range(255, 512):
    EXP[i] = EXP[i - 255]


def rs_ec(data, n):
    """The n error correction codewords of data (Reed-Solomon over GF(256))."""
    gen = [1]
    for i in range(n):
        nxt = [0] * (len(gen) + 1)
        for j, g in enumerate(gen):
            nxt[j] ^= g
            if g:
                nxt[j + 1] ^= EXP[LOG[g] + i]
        gen = nxt
    rem = list(data) + [0] * n
    for i in range(len(data)):
        c = rem[i]
        if c:
            for j in range(1, len(gen)):
                if gen[j]:
                    rem[i + j] ^= EXP[LOG[gen[j]] + LOG[c]]
    return rem[len(data):]


def codewords(data):
    for ver in range(1, 10):
        ec, groups = BLOCKS[ver]
        cap = sum(b * k for b, k in groups)
        if 4 + 8 + 8 * len(data) <= cap * 8:
            break
    else:
        raise ValueError("too long for a QR code here")
    bits = [0, 1, 0, 0] + [int(b) for b in format(len(data), "08b")]
    for c in data:
        bits += [int(b) for b in format(c, "08b")]
    bits += [0] * min(4, cap * 8 - len(bits))
    bits += [0] * (-len(bits) % 8)
    cw = [int("".join(map(str, bits[i:i + 8])), 2) for i in range(0, len(bits), 8)]
    for i in range(cap - len(cw)):
        cw.append((0xEC, 0x11)[i % 2])
    blocks, pos = [], 0
    for b, k in groups:
        for _ in range(b):
            blocks.append(cw[pos:pos + k])
            pos += k
    out = []
    for i in range(max(len(b) for b in blocks)):
        out += [b[i] for b in blocks if i < len(b)]
