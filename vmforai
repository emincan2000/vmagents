def while_open(f):
    """For what threads and timers call: does nothing once the app is closing
    (its widgets are gone then)."""
    @functools.wraps(f)
    def run(self, *args):
        try:
            return f(self, *args)
        except (NoMatches, IndexError):
            if self.screen_stack and self.main.query("#vms"):
                raise  # not closing: a real mistake
    return run


LIST_ACTIONS = {"open", "new", "shell", "ports", "toggle", "snapshots", "resize", "delete", "language", "quit",
                "refresh", "project", "changes", "yolo", "task", "try", "net", "history", "phone", "fix"}
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
TAB_ACTIONS = {"home", "back_to_tab", "prev_tab", "next_tab", "goto_tab", "open_kind"}


def clip_commands():
    """The clipboard tool here, as clip_put in vmforai picks it."""
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        return ["wl-copy"]
    if os.environ.get("DISPLAY"):
        if shutil.which("xclip"):
            return ["xclip", "-selection", "clipboard", "-in"]
        if shutil.which("xsel"):
            return ["xsel", "--clipboard", "--input"]
    if os.uname().sysname == "Darwin" and shutil.which("pbcopy"):
        return ["pbcopy"]
    return None


class VmforaiUI(App):
    """One row of tabs: the VM list first, then a tab for each terminal (a
    shell or an AI assistant on a VM) and for each VM being created."""
    TITLE = "vmforai"
    ENABLE_COMMAND_PALETTE = False
    CSS = """
