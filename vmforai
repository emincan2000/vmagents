# --- SSH apps: a port per VM, forwarded to its SSH server

async def forward(name, r, w):
    peer = w.get_extra_info("peername")[0]
    log(f"{peer} SSH to {name}")
    p = await asyncio.create_subprocess_exec(SELF, "__addr", name, stdout=subprocess.PIPE,
                                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
    try:
        out, _ = await asyncio.wait_for(p.communicate(), 600)
        host, port = out.decode().split()
        vr, vw = await asyncio.wait_for(asyncio.open_connection(host, int(port)), 30)
    except Exception as e:
        log(f"{peer} SSH to {name} failed: {e!r}")
        w.close()
        return

    async def pipe(a, b):
        try:
            while data := await a.read(65536):
                b.write(data)
                await b.drain()
        except (ConnectionError, RuntimeError):
            pass
        finally:
            try:
                b.close()
            except RuntimeError:
                pass

    await asyncio.gather(pipe(r, vw), pipe(vr, w))


def ssh_ports():
    out = {}
    try:
        with open(os.path.join(DIR, "ssh")) as f:
            for line in f:
                p = line.split()
                if len(p) == 2 and p[1].isdigit():
                    out[int(p[1])] = p[0]
    except OSError:
        pass
    return out


async def main():
    server = await asyncio.start_server(http, ADDR, PORT, limit=16384)
    log(f"listening on {ADDR}:{PORT}")
    threading.Thread(target=fetch_libs, daemon=True).start()  # not holding up the end
    forwards = {}
    while True:  # follows the ssh file: ports come and go
        want = ssh_ports()
        for port in list(forwards):
            if forwards[port][0] != want.get(port):
                s = forwards.pop(port)[1]
                if s:
                    s.close()
        for port, name in want.items():
            if port not in forwards:
                try:
                    s = await asyncio.start_server(lambda r, w, n=name: forward(n, r, w), ADDR, port)
                except OSError as e:
                    s = None  # not again until the file changes
                    log(f"cannot listen on {ADDR}:{port} for {name}: {e}")
                forwards[port] = (name, s)
        await asyncio.sleep(2)


