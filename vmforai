class DiffLog(RichLog):
    BINDINGS = [Binding("j", "scroll_down", show=False), Binding("k", "scroll_up", show=False),
                Binding("space", "page_down", show=False)]


def diff_line(line):
    """A line of "vmforai changes" output, coloured like git does."""
    style = ""
    if line.startswith("diff --git"):
        style = "bold"
    elif line.startswith(("+++", "---", "index ")):
        style = "dim"
    elif line.startswith("@@"):
        style = "cyan"
    elif line.startswith("+"):
        style = "green"
    elif line.startswith("-"):
        style = "red"
    return Text(line, style=style)


class Changes(Vertical):
    """A tab with what the agents changed in the VM's project since it was
    sent: commits, files, the diff. r: again, t: take it as a branch here,
    P: a pull request, Esc: the list."""

    def __init__(self, vm, **kw):
        super().__init__(**kw)
        self.vm = vm
        self.state = "loading"  # loading, none, changes, error
        self._bindings = BindingsMap(self.make_bindings())

    @staticmethod
    def make_bindings():
        return [Binding("r", "load", T("Refresh")), Binding("t", "take", T("Take as a branch")),
                Binding("P", "pr", T("Pull request")), Binding("escape", "app.home", show=False),
                Binding("h", "app.home", show=False)]

    def compose(self):
        yield Static(T("Getting the changes of {n}...", n=self.vm["name"]), id="chstatus")
        yield DiffLog(id="diff", wrap=False, markup=False, highlight=False, auto_scroll=False)

    def on_mount(self):
        self.action_load()

    def focus_default(self):
        try:
            self.query_one(DiffLog).focus()
        except NoMatches:
            self.call_after_refresh(self.focus_default)

    def status_label(self):
        return T("Changes")

    def action_load(self):
        self.state = "loading"
        self.query_one("#chstatus", Static).update(T("Getting the changes of {n}...", n=self.vm["name"]))
        self.load()

    @work(thread=True, exclusive=True, group="changes")
    def load(self):
        rc, out, err = cli("changes", self.vm["name"], timeout=900)
        self.app.call_from_thread(self.show, rc, out, err)

    def show(self, rc, out, err):
        log = self.query_one(DiffLog)
        log.clear()
        n = self.vm["name"]
        project = home_short(self.vm.get("project") or "")
        if rc != 0:
            self.state = "error"
            self.query_one("#chstatus", Static).update(
                T("[red]Could not get the changes of {n}[/]: {why}", n=n, why=(err.strip().splitlines() or ["?"])[-1]))
            return
        if out.startswith("No changes"):
            self.state = "none"
            self.query_one("#chstatus", Static).update(
                T("[b]No changes[/b] on {n} since the project was sent ({p}).", n=n, p=project))
            return
        self.state = "changes"
        summary = next((x.strip() for x in out.splitlines() if re.match(r"^ \d+ files? changed", x)), "")
        self.query_one("#chstatus", Static).update(
            T("[b]Changes on {n}[/b] since the project was sent: {summary}\n[dim]t: take them as the branch "
              "vmforai/{n} in {p} (your checkout stays as it is) · P: a pull request · r: refresh[/]",
              n=n, summary=summary, p=project))
        for line in out.splitlines()[1:]:
            log.write(diff_line(line))
        log.scroll_home(animate=False)

    def action_take(self):
        if self.state != "changes":
            self.app.notify(T("Nothing to take."))
            return
        self.app.background(["take", self.vm["name"]], done=lambda rc: rc == 0 and self.app.notify(
            T("The work of {n} is the branch vmforai/{n} now.", n=self.vm["name"])), name=self.vm["name"])

    def action_pr(self):
        if self.state != "changes":
            self.app.notify(T("Nothing to take."))
            return
        n = self.vm["name"]

        def sure(yes):
            if yes:
                self.app.background(["take", n, "--pr"], name=n)
        self.app.push_screen(Confirm(T("Push the branch vmforai/{n} to origin and open a pull request (with gh)?",
                                       n=n), yes=T("Open it")), sure)


