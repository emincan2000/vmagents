# ------------------------------------------------------------------ mount

MOUNT_BASE=${VMFORAI_MOUNT_DIR:-${VMCLAUDE_MOUNT_DIR:-$HOME/vm}}

is_mounted() { # DIR
  local d
  d=$(readlink -f "$1" 2>/dev/null) || return 1
  awk -v d="$d" '$2 == d { found = 1 } END { exit !found }' "${VMFORAI_MOUNTS_FILE:-/proc/mounts}" 2>/dev/null
}

cmd_mount() {
  local name='' dir=''
  while (($#)); do
    case $1 in
      -*) usage_error "mount: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1
        elif [[ -z $dir ]]; then dir=$1
        else usage_error "mount: too many arguments"
        fi
        shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "mount: missing NAME"
  command -v sshfs >/dev/null ||
    die "sshfs is not installed (Debian/Ubuntu: sudo apt install sshfs; Fedora: sudo dnf install fuse-sshfs; Arch: sudo pacman -S sshfs)"
  load "$name"
  dir=${dir:-$MOUNT_BASE/$NAME}
  if is_mounted "$dir"; then say "Already mounted: $dir"; return 0; fi
  mkdir -p "$dir"
  [[ -z $(ls -A "$dir") ]] || die "$dir is not empty; give an empty folder: $PROG mount $NAME FOLDER"

  local remote line
  mcp_prepare "$NAME"  # here, not in $(...): it sets TARGET
  remote=$(vm_info_lines | sed -n 's/^dir=//p') || true
  [[ -n $remote ]] || die "cannot reach VM $NAME (see: $PROG doctor $NAME)"
  local -a o=(-o "reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,idmap=user"
    -o "Port=$C_PORT" -o "HostKeyAlias=vmforai-$NAME" -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o StrictHostKeyChecking=accept-new -o BatchMode=yes)
  [[ -f $C_KEY ]] && o+=(-o "IdentityFile=$C_KEY" -o IdentitiesOnly=yes)
  if ! line=$(sshfs "${o[@]}" "$(scp_host):$(sftp_path "$remote")" "$dir" 2>&1); then
    rmdir "$dir" 2>/dev/null || true
    die "sshfs failed: $line"
  fi
  say "Mounted $NAME:$remote at $dir"
  say ""
  say "Files you (or Claude Code) change in $dir change in the VM."
  say "But commands started there still run on THIS computer. To run them in the VM:"
  say "  $PROG shell $NAME 'COMMAND'     or the run tool of: $PROG mcp $NAME --add"
  say "Unmount with: $PROG umount $NAME"
}

cmd_umount() {
  local name=${1:-} dir=${2:-}
  [[ -n $name ]] || usage_error "umount: missing NAME"
  valid_name "$name" || die "invalid name: $name"
  dir=${dir:-$MOUNT_BASE/$name}
  is_mounted "$dir" || { say "Not mounted: $dir"; return 0; }
  local tool
  for tool in fusermount3 fusermount; do
    if command -v "$tool" >/dev/null; then
      "$tool" -u "$dir" || die "could not unmount $dir (is a program still using it?)"
      rmdir "$dir" 2>/dev/null || true
      say "Unmounted $dir"
      return 0
    fi
  done
  umount "$dir" || die "could not unmount $dir"
  say "Unmounted $dir"
}

# ------------------------------------------------------------------ login

# Logs Claude Code on the VM in without a browser there: the token is made
# here ("claude setup-token", whose browser step works on this computer) and
# stored on the VM in ~/.config/vmforai/claude-env, readable only by you.
TOKEN_RE='^sk-ant-[A-Za-z0-9_-]{20,}$'

cmd_login() {
  local name='' remove=0
  while (($#)); do
    case $1 in
      --remove) remove=1; shift ;;
      -*) usage_error "login: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "login: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "login: missing NAME"
  load "$name"

  local token='' var
  if ((!remove)); then
    if [[ ! -t 0 ]]; then
      token=$(head -c 4096 | tr -d ' \r\n\t')        # piped in: echo TOKEN | vmforai login NAME
    else
      if command -v claude >/dev/null && command -v script >/dev/null; then
        info "Making a login token with Claude Code on this computer (claude setup-token)."
        info "Confirm in the browser that opens; vmforai takes the token from there."
        local log
        log=$(mktemp)
        # A wide terminal, so the token is printed on one line.
        script -qefc "stty cols 1000 2>/dev/null; claude setup-token" "$log" || true
        token=$(sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' "$log" | grep -oE 'sk-ant-[A-Za-z0-9_-]{20,}' | tail -n 1) || true
        rm -f "$log"
      fi
      if [[ -z $token ]]; then
        info "Paste a Claude token (from \"claude setup-token\") or an API key (sk-ant-...)."
        read -rs -p "Token: " token || die "aborted"
        printf '\n' >&2
        token=${token//[[:space:]]/}
      fi
    fi
    [[ $token =~ $TOKEN_RE ]] || die "that is not a Claude token or API key (they start with sk-ant-)"
    case $token in
      sk-ant-oat*) var=CLAUDE_CODE_OAUTH_TOKEN ;;
      *) var=ANTHROPIC_API_KEY ;;
    esac
  fi

  resolve_target
  build_ssh_opts
  if [[ $C_OS == windows ]]; then
    # shellcheck disable=SC2016
    local ps='$d = "$env:USERPROFILE\.config\vmforai"; $f = "$d\claude-env"'
    if ((remove)); then
      ps+=$'\nRemove-Item -LiteralPath $f -ErrorAction SilentlyContinue'
      run_ssh -T -- "$TARGET" "$(win_cmd "$ps")" </dev/null || die "could not remove the token"
    else
      # shellcheck disable=SC2016
      ps+=$'\nNew-Item -ItemType Directory -Force -Path $d | Out-Null\n[IO.File]::WriteAllText($f, [Console]::In.ReadToEnd())'
      printf '%s=%s\n' "$var" "$token" | run_ssh -T -- "$TARGET" "$(win_cmd "$ps")" || die "could not store the token"
    fi
  else
    if ((remove)); then
      # shellcheck disable=SC2016
      run_ssh -T -- "$TARGET" 'rm -f "$HOME/.config/vmforai/claude-env"' </dev/null || die "could not remove the token"
    else
      # shellcheck disable=SC2016
      printf '%s=%s\n' "$var" "$token" | run_ssh -T -- "$TARGET" "$(remote_cmd "$MIGRATE_SH"'umask 077
mkdir -p "$HOME/.config/vmforai" && cat >"$HOME/.config/vmforai/claude-env" && chmod 600 "$HOME/.config/vmforai/claude-env"')" ||
        die "could not store the token"
    fi
  fi
  if ((remove)); then
    say "Removed the login token from '$NAME'."
  else
    say "Logged in: Claude Code on '$NAME' now uses this $([[ $var == ANTHROPIC_API_KEY ]] && echo "API key" || echo token)."
    say "Open it with: $PROG $NAME   (a Claude session that is already running keeps its old login)"
  fi
}

desktop_escape() { # quote an argument for a .desktop Exec line
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//\`/\\\`}; s=${s//\$/\\\$}
  printf '"%s"' "${s//%/%%}"
}

cmd_desktop() {
  [[ $# = 1 ]] || usage_error "desktop: give one NAME"
  profile_exists "$1" || die "no VM profile named '$1'"
  local self file
  self=$(readlink -f "$0")
  file=$APPS_DIR/vmforai-$1.desktop
  mkdir -p "$APPS_DIR"
  cat >"$file" <<EOF
[Desktop Entry]
Type=Application
Name=Claude Code ($1)
Comment=Open Claude Code on the virtual machine $1 over SSH
Exec=$(desktop_escape "$self") connect --hold $1
Terminal=true
Icon=utilities-terminal
Categories=Development;
Keywords=claude;ssh;vm;
EOF
  chmod +x "$file"
  if command -v update-desktop-database >/dev/null; then
    update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
  fi
  say "Created $file — look for \"Claude Code ($1)\" in your app menu."
}

ask() { # VAR PROMPT DEFAULT
  local __a
  read -r -p "$2${3:+ [$3]}: " __a || die "aborted"
  printf -v "$1" '%s' "${__a:-$3}"
}

first_run() {
  [[ -t 0 && -t 1 ]] || die "no VM configured. Add one: $PROG add NAME --host IP"
  local name domain='' host='' user port doms yn
  say "No VM configured yet — let's add one."
  ask name "Name for this VM" vm
  if command -v virsh >/dev/null; then
    doms=$(virsh -c qemu:///system list --all --name 2>/dev/null | sed '/^$/d' | tr '\n' ' ' || true)
    if [[ -n $doms ]]; then
      say "libvirt VMs: $doms"
      ask domain "libvirt VM to use (empty if it is not a libvirt VM)" ""
    fi
  fi
  if [[ -n $domain ]]; then
    ask host "Host or IP (empty: detect automatically)" ""
  else
    while [[ -z $host ]]; do ask host "Host or IP of the VM" ""; done
  fi
  ask user "User on the VM" "$(id -un)"
  ask port "SSH port" 22
  local -a args=("$name" --user "$user" --port "$port")
  [[ -n $host ]] && args+=(--host "$host")
  [[ -n $domain ]] && args+=(--domain "$domain")
  cmd_add "${args[@]}"
  ask yn "Set up the VM now (SSH key, tmux, Claude Code)? [Y/n]" ""
  [[ $yn == [nN]* ]] || cmd_setup "$name"
  cmd_connect "$name"
}

# "vmforai COMMAND --help". For connect and shell only right after the
# command: later arguments belong to Claude or to the remote command.
wants_help() { # COMMAND ARGS...
  local cmd=$1 a
  shift
  case $cmd in
    connect) [[ ${1-} == -h || ${1-} == --help ]]; return ;;
    shell) [[ ${1-} == --keep ]] && shift; [[ ${1-} == -h || ${1-} == --help ]]; return ;;
  esac
  for a in "$@"; do
    [[ $a == -- ]] && return 1
    [[ $a == -h || $a == --help ]] && return 0
  done
  return 1
}

# vmforai was called vmagents (0.11 to 0.24) and vmclaude before: their
# settings and cache move over once. Host keys were stored under the aliases
# vmagents-NAME and vmclaude-NAME; they get vmforai-NAME too.
migrate_old_name() {
  local o old oldc n keys
  for o in vmagents vmclaude; do
    old=${XDG_CONFIG_HOME:-$HOME/.config}/$o oldc=${XDG_CACHE_HOME:-$HOME/.cache}/$o
    if [[ -z ${VMFORAI_CONFIG_DIR:-} && -d $old && ! -L $old && ! -e $CONF_DIR ]]; then
      mkdir -p "${CONF_DIR%/*}" && mv "$old" "$CONF_DIR" || return 0
      ln -s vmforai "$old" 2>/dev/null || true  # (what still looks there finds it)
      if [[ -f $KNOWN_HOSTS ]]; then
        keys=''
        for n in $(profile_names); do
          keys+=$( { ssh-keygen -F "vmagents-$n" -f "$KNOWN_HOSTS"; ssh-keygen -F "vmclaude-$n" -f "$KNOWN_HOSTS"; } 2>/dev/null |
            awk -v a="vmforai-$n" '!/^#/ && NF >= 3 { print a, $2, $3 }' | head -n 3 || true)$'\n'
        done
        printf '%s' "${keys##$'\n'}" | sed '/^$/d' >>"$KNOWN_HOSTS"
      fi
      info "$o is now called vmforai (short: vmf): its settings moved to $CONF_DIR"
    fi
    if [[ -d $oldc && ! -L $oldc && ! -e $CACHE_DIR ]]; then
      { mkdir -p "${CACHE_DIR%/*}" && mv "$oldc" "$CACHE_DIR" && ln -s vmforai "$oldc"; } 2>/dev/null || true
    fi
  done
  # Run under an old name (an update of the old script): the new names next to it.
  local self dir
  case $PROG in
    vmagents | vmclaude)
      self=$(readlink -f -- "$0" 2>/dev/null) || return 0
      dir=${self%/*}
      if [[ ${self##*/} != vmforai && -w $dir && ! -e $dir/vmforai ]]; then
        mv -f "$self" "$dir/vmforai" && ln -s vmforai "$self" && ln -sfn vmforai "$dir/vmf" &&
          info "vmagents is now called vmforai; vmf is short for it. (vmagents still works.)"
      fi ;;
  esac
  return 0
}

main() {
  ((BASH_VERSINFO[0] >= 4)) || { echo "$PROG: bash 4 or newer is required" >&2; exit 1; }
  migrate_old_name
  local cmd=${1-}
  case $cmd in
    help | -h | --help | version | -V | --version | deps | update | __*) ;;
    *) deps_first_use ;;
  esac
  case $cmd in
    "")
      if [[ -z $(profile_names) ]]; then first_run; else cmd_connect; fi ;;
    help | -h | --help)
      if [[ -n ${2-} ]]; then help_cmd "$2"; else usage; fi ;;
    version | -V | --version) say "vmforai $VERSION" ;;
    __mcp-info | __mcp-run | __mcp-get | __mcp-put | __watch | __runwait | __proxy | __phone | __addr) shift; "cmd_$cmd" "$@" ;;
    add | create | delete | images | prune | mcp | mount | umount | login | setup | connect | shell | start | stop | autostop | snapshot | snapshots | undo | autosnap | idle | notify | clipboard | open | ports | project | changes | take | fix | run | runs | try | tries | net | templates | history | phone | update | deps | tools | yolo | agent | resize | ui | autostart | doctor | list | default | desktop | edit | forget | rm)
      shift
      if wants_help "$cmd" "$@"; then help_cmd "$cmd"; return 0; fi
      "cmd_$cmd" "$@" ;;
    ls) shift; cmd_list "$@" ;;
    remove) shift; cmd_rm "$@" ;;
    --hold | --no-tmux | --keep | --yolo | --ask | --claude | --codex | --gemini | --opencode | --aider) cmd_connect "$@" ;;
    -*) usage_error "unknown option $cmd" ;;
    *)
      profile_exists "$cmd" || usage_error "unknown command or VM: $cmd"
      cmd_connect "$@" ;;
  esac
}

# On the same line: when the script is replaced while it runs (an update during
# a long "create"), bash must not read on in the new file.
main "$@"; exit
