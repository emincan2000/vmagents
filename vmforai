SPECIAL_KEYS = {
    "enter": b"\r", "tab": b"\t", "shift+tab": b"\x1b[Z", "backspace": b"\x7f", "ctrl+h": b"\x7f",
    "escape": b"\x1b", "delete": b"\x1b[3~", "insert": b"\x1b[2~", "pageup": b"\x1b[5~", "pagedown": b"\x1b[6~",
    "space": b" ", "ctrl+space": b"\x00", "ctrl+at": b"\x00", "ctrl+backslash": b"\x1c",
    "ctrl+right_square_bracket": b"\x1d", "ctrl+circumflex_accent": b"\x1e", "ctrl+underscore": b"\x1f",
    "f1": b"\x1bOP", "f2": b"\x1bOQ", "f3": b"\x1bOR", "f4": b"\x1bOS", "f5": b"\x1b[15~", "f6": b"\x1b[17~",
    "f7": b"\x1b[18~", "f8": b"\x1b[19~", "f9": b"\x1b[20~", "f10": b"\x1b[21~", "f11": b"\x1b[23~",
    "f12": b"\x1b[24~",
}
COPY_KEYS = {"ctrl+shift+c", "super+c"}
CURSOR_KEYS = {"up": b"A", "down": b"B", "right": b"C", "left": b"D", "home": b"H", "end": b"F"}
MODIFIERS = {"shift": 2, "alt": 3, "shift+alt": 4, "ctrl": 5, "shift+ctrl": 6, "ctrl+shift": 6, "alt+ctrl": 7,
             "ctrl+alt": 7}
MODE_CURSOR_KEYS, MODE_PASTE = 1 << 5, 2004 << 5          # pyte keeps private modes shifted by 5
MODES_MOUSE = {1000 << 5, 1002 << 5, 1003 << 5}
MODE_SGR_MOUSE = 1006 << 5
PYTE_COLORS = {"brown": "yellow", "brightbrown": "bright_yellow"}
# pyte ignores "ESC ( 0" (line drawing, as tmux draws its borders) in UTF-8
# mode; the terminal passes these on itself.
CHARSET_RE = re.compile(rb"\x1b([()])([0B])")
CUT_RE = re.compile(rb"\x1b[()]?$")


def key_bytes(key, character, cursor_keys=False):
    """What a terminal sends for a Textual key, or None."""
    if key in SPECIAL_KEYS:
        return SPECIAL_KEYS[key]
    mods, _, base = key.rpartition("+")
    if base in CURSOR_KEYS:
        if mods:
            return b"\x1b[1;%d%s" % (MODIFIERS.get(mods, 5), CURSOR_KEYS[base])
        return (b"\x1bO" if cursor_keys else b"\x1b[") + CURSOR_KEYS[base]
    if mods == "ctrl" and len(base) == 1 and base.isalpha():
        return bytes([ord(base.lower()) & 0x1F])
    if mods == "alt" and len(base) == 1:
        return b"\x1b" + base.encode()
    if character and (character.isprintable() or character in "\t\r"):
        return character.encode()
    if character and len(character) == 1 and ord(character) < 32:
        return character.encode()
    return None


@functools.lru_cache(maxsize=4096)
def cell_style(fg, bg, bold, italics, underscore, strikethrough, reverse):
    def color(c):
        if c == "default":
            return None
        if len(c) == 6 and all(ch in "0123456789abcdefABCDEF" for ch in c):
            return "#" + c
        c = PYTE_COLORS.get(c, c)
        return "bright_" + c[6:] if c.startswith("bright") and not c.startswith("bright_") else c
    return Style(color=color(fg), bgcolor=color(bg), bold=bold, italic=italics, underline=underscore,
                 strike=strikethrough, reverse=reverse)


class Terminal(Widget, can_focus=True):
    """A program on a pseudo-terminal, shown with pyte (a VT100/xterm emulator)."""
    DEFAULT_CSS = "Terminal { height: 1fr; width: 1fr; }"

    class Exited(Message):
        def __init__(self, terminal, rc):
            super().__init__()
            self.terminal, self.rc = terminal, rc

    def __init__(self, argv, label, **kw):
        super().__init__(**kw)
        self.argv, self.label = argv, label
        self.vm_name = self.kind = None
        self.reads = deque(maxlen=32)  # when output came: a working agent keeps redrawing its spinner
        self.working = self.attention = False
        self.last_active = self.last_key = 0.0
        self.vt = self.stream = self.proc = None
        self.fd = None
        self.rc = None
        self.pending = b""

    def on_mount(self):
        self.call_after_refresh(self.start)

    def start(self):
        cols, rows = max(self.size.width, 20), max(self.size.height, 5)
        self.vt = pyte.HistoryScreen(cols, rows, history=5000)
        self.vt.write_process_input = self.write  # answers to "where is the cursor?" and the like
        self.vt.bell = self.ring
        self.stream = pyte.ByteStream(self.vt)
        master, slave = pty.openpty()
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        env = dict(os.environ, TERM="xterm-256color", COLORTERM="truecolor")
        try:
            self.proc = subprocess.Popen(self.argv, stdin=slave, stdout=slave, stderr=slave, env=env,
                                         start_new_session=True, close_fds=True)
        except OSError as e:
            os.close(master)
            os.close(slave)
            self.stream.feed(f"cannot start {self.argv[0]}: {e}\r\n".encode())
            self.post_message(self.Exited(self, 127))
            return
        os.close(slave)
        self.fd = master
        asyncio.get_running_loop().add_reader(master, self.readable)

    def readable(self):
        try:
            data = os.read(self.fd, 65536)
        except OSError:
            data = b""
        if data:
            now = time.monotonic()
            if now - self.last_key > 0.5:  # not the echo of what you type
                self.reads.append(now)
            if self.vt.history.position < self.vt.history.size:
                self.vt.next_page()  # new output: back to the bottom
            self.feed(data)
            self.refresh()
            return
        asyncio.get_running_loop().remove_reader(self.fd)
        os.close(self.fd)
        self.fd = None
        self.rc = self.proc.wait()
        self.post_message(self.Exited(self, self.rc))

    def feed(self, data):
        data, self.pending = self.pending + data, b""
        if cut := CUT_RE.search(data):  # a sequence cut in two: the rest comes with the next read
            data, self.pending = data[:cut.start()], data[cut.start():]
        pos = 0
        for m in CHARSET_RE.finditer(data):
            self.stream.feed(data[pos:m.start()])
            self.vt.define_charset(m.group(2).decode(), m.group(1).decode())
            pos = m.end()
        self.stream.feed(data[pos:])

    class Bell(Message):
        def __init__(self, terminal):
            super().__init__()
            self.terminal = terminal

    def ring(self, *_):
        self.post_message(self.Bell(self))

    def busy(self, now):
        """Output keeps coming (4 times in 2 seconds or more): the program works."""
        return sum(1 for t in self.reads if now - t < 2) >= 4

    def send(self, data):
        """What you type (or paste)."""
        self.last_key = time.monotonic()
        self.write(data)

    def write(self, data):
        if self.fd is None:
            return
        if isinstance(data, str):
            data = data.encode()
        try:
            os.write(self.fd, data)
        except OSError:
            pass

    def close(self):
        """Hang up, as closing a terminal window does."""
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGHUP)
            except OSError:
                pass

    def on_resize(self, event):
        if self.vt is None or event.size.width < 2 or event.size.height < 2:
            return
        cols, rows = event.size.width, event.size.height
        if (cols, rows) != (self.vt.columns, self.vt.lines):
            self.vt.resize(rows, cols)
            if self.fd is not None:
                fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
            self.refresh()

    def on_key(self, event):
        event.stop()
        event.prevent_default()
        data = key_bytes(event.key, event.character, self.vt is not None and MODE_CURSOR_KEYS in self.vt.mode)
        if self.text_selection is not None:  # (selected with the mouse)
            if event.key in COPY_KEYS:
                self.copy_selection()
                return
            if data:  # not Ctrl or Shift alone
                self.screen.clear_selection()
        if data:
            self.send(data)

    def on_paste(self, event):
        event.stop()
        text = event.text.replace("\r\n", "\r").replace("\n", "\r").encode()
        if self.vt is not None and MODE_PASTE in self.vt.mode:
            text = b"\x1b[200~" + text + b"\x1b[201~"
        self.send(text)

    def scroll(self, up, event):
        event.stop()
        if self.vt is None:
            return
        if self.vt.mode & MODES_MOUSE:
            if MODE_SGR_MOUSE in self.vt.mode:
                self.send(b"\x1b[<%d;%d;%dM" % (64 if up else 65, event.x + 1, event.y + 1))
            return
        if up:
            self.vt.prev_page()
        else:
            self.vt.next_page()
        self.refresh()

    def on_mouse_scroll_up(self, event):
        self.scroll(True, event)

    def on_mouse_scroll_down(self, event):
        self.scroll(False, event)

    def on_focus(self):
        self.refresh()

    def on_blur(self):
        self.refresh()

    # Text selection: drag with the mouse; Ctrl+Shift+C copies it (Ctrl+C stays ^C for the program).
    def copy_selection(self):
        if text := self.screen.get_selected_text():
            self.app.copy_to_clipboard(text)
            self.app.notify(T("Copied."), timeout=2)
        self.screen.clear_selection()

    def line_text(self, y):
        row = self.vt.buffer[y]
        return "".join(row[x].data for x in range(self.vt.columns))

    def get_selection(self, selection):
        if self.vt is None:
            return None
        text = selection.extract("\n".join(self.line_text(y) for y in range(self.vt.lines)))
        return "\n".join(line.rstrip() for line in text.split("\n")), "\n"

    def selection_updated(self, selection):
        self.refresh()

    def render_line(self, y):
        width = self.size.width
        vt = self.vt
        if vt is None or y >= vt.lines:
            return Strip.blank(width)
        row = vt.buffer[y]
        cur = vt.cursor
        show_cursor = self.has_focus and not cur.hidden and cur.y == y and self.rc is None
        span = self.text_selection.get_span(y) if self.text_selection is not None else None
        if span is not None:
            sel_start, sel_end = span[0], vt.columns if span[1] == -1 else span[1]
            sel_style = self.screen.get_component_rich_style("screen--selection")
        # Each piece carries its offset (in characters), so a mouse drag selects text.
        segments, text, style_key, i, start = [], [], None, 0, 0

        def piece():
            style = cell_style(*style_key[:7])
            if style_key[7]:
                style += sel_style
            segments.append(Segment("".join(text), style + Style.from_meta({"offset": (start, y)})))

        for x in range(vt.columns):
            ch = row[x]
            if ch.data == "":  # the right half of a wide character
                continue
            key = (ch.fg, ch.bg, ch.bold, ch.italics, ch.underscore, ch.strikethrough,
                   ch.reverse != (show_cursor and x == cur.x), span is not None and sel_start <= i < sel_end)
            if key != style_key and text:
                piece()
                text, start = [], i
            style_key = key
            text.append(ch.data)
            i += 1
        if text:
            piece()
        return Strip(segments).adjust_cell_length(width)


def kind_label(kind):
    if kind == "shell":
        return T("Shell")
    if kind == "login":
        return T("Log in")
    if kind == "run":
        return T("Task")
    if kind == "fix":
        return T("Issue")
    return AGENT_NAMES.get(kind, kind)


def kind_command(name, kind):
    if kind in ("shell", "login"):
        return [VMFORAI, kind, name]
    return [VMFORAI, name, "--hold", f"--{kind}"]


class OpenAs(ModalScreen):
    """How to open a VM: a shell or an AI assistant (j/k, Enter or l; h or Esc: back)."""
    BINDINGS = [Binding("escape", "dismiss(None)", show=False), Binding("h", "dismiss(None)", show=False)]

    def __init__(self, vm):
        super().__init__()
        self.vm = vm

    def compose(self):
        vm = self.vm
        installed = vm.get("agents") or []
        options = [Option(T("Shell   [dim]a terminal on the VM[/]"), id="shell")]
        for key, label in AGENTS:
            if vm.get("os") == "windows" and key != "claude":
                continue
            notes = []
            if key == vm.get("agent", "claude"):
                notes.append(T("default"))
            if installed and key not in installed:
                notes.append(T("installs it first"))
            options.append(Option(label + (f"   [dim]({', '.join(notes)})[/]" if notes else ""), id=key))
        options.append(Option(T("Log Claude in"), id="login"))
        with Vertical(classes="dialog"):
            yield Static(T("[b]Open {n}[/b] as:", n=vm["name"]))
            yield VimOptions(*options, id="pick")
            yield Static(T("[dim]Inside: F1 to F6 open the others as tabs, F7/F8 switch tabs, Ctrl+] goes to the "
                           "list.[/]"))

    @on(OptionList.OptionSelected)
    def selected(self, e):
        self.dismiss(e.option.id)

class Phone(ModalScreen):
    """vmforai phone: the QR code for the phone's browser. n: a new link,
    o: off, w: the local network instead of Tailscale; h, Esc: back."""
    BINDINGS = [Binding("escape", "dismiss(None)", show=False), Binding("h", "dismiss(None)", show=False),
                Binding("n", "load('--new')", show=False), Binding("o", "off", show=False),
                Binding("w", "load('--lan')", show=False), Binding("b", "notes", show=False)]

    def compose(self):
        with Vertical(classes="dialog"):
            yield Static(T("[b]Your VMs on the phone[/b]"))
            yield Static(T("Starting phone access..."), id="phone-text")
            yield Static("", id="qr")
            yield Static("", id="phone-more")
            yield Static("", id="phone-notes")
            with Horizontal(classes="buttons"):
                yield Button(T("New link (n)"), id="new")
                yield Button(T("Turn off (o)"), id="off")
                yield Button(T("Same Wi-Fi (w)"), id="lan", classes="hidden")

    def on_mount(self):
        self.action_load("")

    @work(thread=True, exclusive=True)
    def action_load(self, extra):
        r = cli("phone", "--json", *([extra] if extra else []), timeout=30)
        self.app.call_from_thread(self.shown, *r)
        self.notes_shown(cli("phone", "notify", "--status", "--json", timeout=30))

    def notes_shown(self, r):
        try:
            n = json.loads(r[1]) if r[0] == 0 else {}
        except ValueError:
            n = {}
        self.notes_on = bool(n.get("on") and n.get("topic"))
        if self.notes_on:
            text = T("Notifications on the phone: on (ntfy app, topic {t}). b: send a test", t=n["topic"])
        else:
            text = T("Notifications on the phone, when a task ends or an agent waits: b turns them on (ntfy app)")
        self.app.call_from_thread(self.query_one("#phone-notes", Static).update, Text(text, style="dim"))

    @work(thread=True, exclusive=True, group="notes")
    def action_notes(self):
        r = cli("phone", "notify", *(["test"] if getattr(self, "notes_on", False) else []), "--json", timeout=60)
        try:
            n = json.loads(r[1]) if r[0] == 0 else {}
        except ValueError:
            n = {}
        if n.get("sent") is False:
            msg = T("The notification did not get through: does this computer reach the internet?")
        elif n.get("on") and n.get("topic"):
            msg = T("A test notification was sent. On the phone: the ntfy app, subscribed to {t}", t=n["topic"])
        else:
            msg = (r[2] or "").strip()
        self.app.call_from_thread(self.app.notify, msg)
        self.notes_shown(cli("phone", "notify", "--status", "--json", timeout=30))

    def shown(self, rc, out, err):
        try:
            info = json.loads(out) if rc == 0 else None
        except ValueError:
            info = None
        text, qr, more = self.query_one("#phone-text", Static), self.query_one("#qr", Static), \
            self.query_one("#phone-more", Static)
        if not info:
            msg = err.strip().replace("vmforai: ", "", 1) or T("Phone access did not start.")
            text.update(Text(msg, style="red"))
            qr.update("")
            more.update("")
            self.query_one("#lan").remove_class("hidden")
            return
        self.query_one("#lan").add_class("hidden")
        if info["listen"] == "lan":
            text.update(T("Scan it with the phone's camera. [dim]On the local network: the phone must be on the "
                          "same Wi-Fi.[/]"))
        else:
            text.update(T("Scan it with the phone's camera. [dim]Over Tailscale: the phone needs the Tailscale app, "
                          "with the same account.[/]"))
        qr.update(Text("\n".join(info["qr"]), style="bright_white on black"))
        lines = [Text(info["url"], style="dim"),
                 Text(T("There: your VMs; tap one for its agent or a shell. The link is the key: share it with no "
                        "one."))]
        for s in info.get("ssh") or []:
            lines.append(Text(T("SSH app into {n}: ssh -p {p} {u}@{a}", n=s["name"], p=s["port"], u=s["user"],
                                a=info["address"])))
        more.update(Text("\n").join(lines))

    def action_off(self):
        rc, _, err = cli("phone", "off", timeout=15)
        self.app.notify(T("Phone access is off.") if rc == 0 else err.strip())
        self.dismiss(None)

    @on(Button.Pressed)
    def pressed(self, e):
        if e.button.id == "new":
            self.action_load("--new")
        elif e.button.id == "off":
            self.action_off()
        elif e.button.id == "lan":
            self.action_load("--lan")


