# The terminal UI: a Textual app (UI_PY below) that runs this script.
cmd_ui() {
  (($# == 0)) || usage_error "ui: takes no arguments"
  local f self
  self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
  mkdir -p "$CACHE_DIR" || die "cannot create $CACHE_DIR"
  f=$CACHE_DIR/ui-$VERSION.py
  [[ -f $f && $(<"$f") == "$UI_PY" ]] || printf '%s\n' "$UI_PY" >"$f" || die "cannot write $f"
  export VMFORAI_BIN=$self VMFORAI_CONF_DIR=$CONF_DIR
  if python3 -c 'import textual.widgets, pyte; from textual.binding import BindingsMap' 2>/dev/null; then
    exec python3 "$f"
  fi
  # uv: on the PATH, or just installed by "vmforai deps" (~/.local/bin is on
  # the PATH only from the next login on).
  local uv
  uv=$(command -v uv) || uv=$HOME/.local/bin/uv
  [[ -x $uv ]] || uv=$HOME/.cargo/bin/uv
  if [[ -x $uv ]]; then
    # uv puts its venv first in PATH; keep the real one for what the UI runs.
    VMFORAI_HOST_PATH=$PATH exec "$uv" run --quiet --no-project --with 'textual>=8,<9' --with 'pyte>=0.8.2' python "$f"
  fi
  die "the UI needs Python with Textual and pyte, which uv fetches: $PROG deps installs uv (or: pip install --user 'textual>=8' pyte)"
}

