# Runs on the VM while you are connected: prints each new tmux paste buffer
# (what you copy in tmux, and what Claude Code copies: it uses
# "tmux load-buffer" inside tmux) in base64, one per line. The empty lines in
# between notice a closed connection: writing to it ends the script.
IFS= read -r -d '' CLIP_SH <<'EOS' || true
command -v tmux >/dev/null 2>&1 && command -v base64 >/dev/null 2>&1 || exit 0
top() { tmux list-buffers -F "#{buffer_name} #{buffer_created} #{buffer_size}" 2>/dev/null | head -n 1; }
last=$(top)
while echo; do
  sleep 0.5 2>/dev/null || sleep 1
  b=$(top)
  [ "$b" = "$last" ] && continue
  last=$b
  [ -n "$b" ] && tmux show-buffer -b "${b%% *}" 2>/dev/null | base64 | tr -d "\n"
done
EOS

