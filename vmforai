                    s += 3
        dark = sum(map(sum, g))
        s += abs(dark * 20 - n * n * 10) // (n * n) * 10
        return s

    if mask is not None:
        return masked(mask)
    return min((masked(p) for p in range(8)), key=penalty)


def text_rows(text, quiet=2):
    """Rows of half blocks, two modules per character: light modules drawn,
    dark ones left as background (show them white on black)."""
    g = matrix(text)
    n = len(g)
    full = [[0] * (n + 2 * quiet) for _ in range(quiet)]
    full += [[0] * quiet + row + [0] * quiet for row in g]
    full += [[0] * (n + 2 * quiet) for _ in range(quiet + 1)]
