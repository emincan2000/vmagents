            await respond(w, "200 OK", _icon, "image/png", cache="max-age=86400")
        elif (u.path.startswith("/api/") or u.path == "/ws") and not allowed(q):
            await asyncio.sleep(1)  # slows down guessing
            log(f"{w.get_extra_info('peername')[0]} wrong key")
            await respond(w, "403 Forbidden", "wrong key: open the link from vmforai phone again")
        elif u.path.startswith("/api/"):
            await api(w, method, u.path, q, body)
        elif u.path == "/ws" and h.get("upgrade", "").lower() == "websocket" and "sec-websocket-key" in h:
            if sessions >= MAX_SESSIONS:
                await respond(w, "503 Service Unavailable", "too many terminals open")
                return
            if not term_argv(q.get("vm", [""])[0], q.get("kind", ["agent"])[0], q):
                await respond(w, "400 Bad Request", "not a terminal I can open")
                return
            acc = base64.b64encode(hashlib.sha1((h["sec-websocket-key"] + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest())
            w.write(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                    b"Sec-WebSocket-Accept: " + acc + b"\r\n\r\n")
            await w.drain()
            await terminal(r, w, q)
