class Confirm(ModalScreen[bool]):
    """y / Enter on the first button: yes. n, h, Esc: no."""
    BINDINGS = [Binding("escape", "dismiss(False)", show=False), Binding("n", "dismiss(False)", show=False),
                Binding("h", "dismiss(False)", show=False), Binding("y", "dismiss(True)", show=False)]

    def __init__(self, text, yes=None, danger=False):
        super().__init__()
        self.text, self.yes, self.danger = text, yes or T("Yes"), danger

    def compose(self):
        with Vertical(classes="dialog"):
            yield Static(self.text)
            with Horizontal(classes="buttons"):
                yield Button(f"{self.yes} (y)", id="yes", variant="error" if self.danger else "primary")
                yield Button(f"{T('Cancel')} (n)", id="no")

    def on_mount(self):
        # Something that cannot be undone: Enter alone does not do it.
        self.query_one("#no" if self.danger else "#yes", Button).focus()

    @on(Button.Pressed)
    def pressed(self, e):
        self.dismiss(e.button.id == "yes")


class TypeName(ModalScreen[bool]):
    """Asks to type the VM's name before something that cannot be undone."""
    BINDINGS = [Binding("escape", "dismiss(False)", show=False)]

    def __init__(self, text, name):
        super().__init__()
        self.text, self.vm = text, name

    def compose(self):
        with Vertical(classes="dialog"):
            yield Static(self.text)
            yield Input(placeholder=self.vm, id="typed")
            with Horizontal(classes="buttons"):
                yield Button(T("Delete"), id="yes", variant="error", disabled=True)
                yield Button(T("Cancel"), id="no")

    @on(Input.Changed)
    def changed(self, e):
        self.query_one("#yes", Button).disabled = e.value != self.vm

    @on(Input.Submitted)
    def submitted(self, e):
        if e.value == self.vm:
            self.dismiss(True)

    @on(Button.Pressed)
    def pressed(self, e):
        self.dismiss(e.button.id == "yes")


class Pick(ModalScreen):
    """Choose one of several options (j/k, Enter or l); returns its id or None."""
    BINDINGS = [Binding("escape", "dismiss(None)", show=False), Binding("h", "dismiss(None)", show=False)]

    def __init__(self, title, options, note=""):
        super().__init__()
        self.title_text, self.options, self.note = title, options, note

    def compose(self):
        with Vertical(classes="dialog"):
            yield Static(self.title_text)
            yield VimOptions(*[Option(label, id=key) for key, label in self.options], id="pick")
            if self.note:
                yield Static(self.note)

    @on(OptionList.OptionSelected)
    def selected(self, e):
