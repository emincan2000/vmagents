  [[ $# = 1 ]] || usage_error "forget: give one NAME"
  profile_exists "$1" || die "no VM profile named '$1'"
  if [[ -f $KNOWN_HOSTS ]] && ssh-keygen -R "vmforai-$1" -f "$KNOWN_HOSTS" >/dev/null 2>&1; then
    ssh-keygen -R "vmclaude-$1" -f "$KNOWN_HOSTS" >/dev/null 2>&1 || true
    ssh-keygen -R "vmagents-$1" -f "$KNOWN_HOSTS" >/dev/null 2>&1 || true
    rm -f "$KNOWN_HOSTS.old"
  fi
  say "Forgot the host key of '$1'; the next connection will accept the new one."
}

# Windows: (re)writes the hook files when this vmforai has other ones than
# the VM got last time.
hooks_mark() { printf '%s/hooks-%s' "$CACHE_DIR" "$NAME"; }
win_hooks() {
  local sum mark
  sum=$(printf '%s\n%s' "$HOOK_SH" "$CLAUDE_SETTINGS" | cksum)
  mark=$(hooks_mark)
  [[ -f $mark && $(<"$mark") == "$sum" ]] && return 0
  if win_run "$(win_hooks_ps)" >/dev/null 2>&1; then
    mkdir -p "$CACHE_DIR" && printf '%s\n' "$sum" >"$mark"
  else
    warn "could not install Claude's hooks on the VM (no notifications this time)"
  fi
  return 0
}

# The profile's PORTS, forwarded while connected (same port here; taken
# ones are skipped). Sets FWD.
FWD=()
profile_forwards() {
  local p shown=''
  FWD=()
  [[ -n ${P[PORTS]:-} ]] || return 0
  for p in ${P[PORTS]//,/ }; do
    p=$((10#$p))
    if port_free "$p"; then
      FWD+=(-L "127.0.0.1:$p:localhost:$p")
      shown+=" http://localhost:$p"
    else
      warn "port $p is in use on this computer; not forwarded this time"
    fi
  done
  [[ -n $shown ]] && info "Ports of $NAME here:$shown"
  return 0
}

# The options with which an agent acts without asking first: fine in a VM,
# which snapshots and "vmforai undo" take back.
yolo_args() { # AGENT
  case $1 in
    claude) printf '%s\n' --dangerously-skip-permissions ;;
    codex) printf '%s\n' --dangerously-bypass-approvals-and-sandbox ;;
    gemini) printf '%s\n' --yolo ;;
    opencode) printf '%s\n' --auto ;;
    aider) printf '%s\n' --yes-always ;;
  esac
}

cmd_connect() {
  local name='' notmux=0 keep=0 agent='' yolo=''
  local -a cargs=()
  while (($#)); do
    case $1 in
      --hold) HOLD=1; shift ;;
      --yolo) yolo=on; shift ;;
      --ask) yolo=off; shift ;;
      --no-tmux) notmux=1; shift ;;
      --keep) keep=1; shift ;;
      # Not --agent: that is Claude's own option.
      --claude | --codex | --gemini | --opencode | --aider) agent=${1#--}; shift ;;
      --) shift; cargs+=("$@"); break ;;
      *)
        if [[ -z $name ]] && [[ $1 != -* ]]; then name=$1; shift
        else cargs+=("$@"); break
        fi ;;
    esac
  done
  if [[ -z $name ]]; then
    name=$(default_name) || die "several VMs and no default; name one, or: $PROG default NAME"
  fi
  load "$name"
  [[ -n $agent ]] && C_AGENT=$agent
  ((notmux)) && C_SESSION=
  if [[ ${yolo:-${P[YOLO]:-off}} == on ]]; then
    local -a y=()
    mapfile -t y < <(yolo_args "$C_AGENT")
    cargs=("${y[@]}" "${cargs[@]}")
  fi
  # Each agent has its own tmux session; Claude's keeps its name.
  if [[ $C_AGENT != claude && -n $C_SESSION ]]; then
    if [[ $C_SESSION == claude ]]; then C_SESSION=$C_AGENT; else C_SESSION=$C_SESSION-$C_AGENT; fi
  fi
  local why_not="only Claude Code runs on Windows VMs for now"
  [[ $C_OS == windows && $C_AGENT != claude ]] && die "$why_not"
  resolve_target
  [[ $C_OS == windows && $C_AGENT != claude ]] && die "$why_not"  # just detected
  build_ssh_opts
  local rc=0
  local cmd
  local -a fwd=()
  if [[ $C_OS == windows ]]; then
    win_hooks
    cmd=$(win_cmd -i "$(win_connect_ps "$C_DIR" "$NAME" "${cargs[@]}")")
  else
    cmd=$(remote_cmd "$CONNECT_SH" "$C_DIR" "$C_SESSION" "$NAME" "$C_AGENT" "${cargs[@]}")
  fi
  # Codex logs in through a page on localhost:1455 that the browser here
  # opens: forward that port to the VM.
  [[ $C_AGENT == codex ]] && port_free 1455 && fwd=(-L 127.0.0.1:1455:localhost:1455)
  profile_forwards
  fwd+=("${FWD[@]}")
  [[ $C_AGENT == claude ]] && start_watcher
  start_clip
  run_ssh "${fwd[@]}" "$TTY_FLAG" -- "$TARGET" "$cmd" || rc=$?
  if ((rc == 120)) && [[ $C_AGENT != claude ]]; then
    info "$C_AGENT is not installed on the VM yet; installing it."
    if run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$AGENT_INSTALL_SH" "$C_AGENT")"; then
      note_agent "$C_AGENT"
      rc=0
      run_ssh "${fwd[@]}" "$TTY_FLAG" -- "$TARGET" "$cmd" || rc=$?
    else
      rc=1
    fi
  fi
  stop_clip
  if ((rc == 255)); then
    info "$PROG: SSH connection to $C_USER@$TARGET:$C_PORT failed. Try: $PROG doctor $NAME"
  elif ((!keep)); then
    autostop
  fi
  ((rc == 0)) || hold_prompt
  return "$rc"
}

cmd_shell() {
  local keep=0 rc=0
  [[ ${1-} == --keep ]] && { keep=1; shift; }
  (($#)) || usage_error "shell: missing NAME"
  load "$1"; shift
  resolve_target
  build_ssh_opts
  if (($#)); then
    run_ssh -- "$TARGET" "$@"
    return
  elif [[ $C_OS == windows ]]; then
    # shellcheck disable=SC2016
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(win_cmd -noexit '$env:VMFORAI_NO_AUTOSTART = "1"; $env:VMAGENTS_NO_AUTOSTART = "1"; $env:VMCLAUDE_NO_AUTOSTART = "1"
if (Test-Path -LiteralPath $PROFILE) { . $PROFILE }')" || rc=$?
  else
    # shellcheck disable=SC2016
    run_ssh "$TTY_FLAG" -- "$TARGET" 'VMFORAI_NO_AUTOSTART=1 VMAGENTS_NO_AUTOSTART=1 VMCLAUDE_NO_AUTOSTART=1 exec "${SHELL:-/bin/sh}" -l' || rc=$?
  fi
  ((rc == 255 || keep)) || autostop
  return "$rc"
}

cmd_autostart() {
  [[ $# = 2 ]] || usage_error "autostart: give NAME and on|off"
  local mode=$2
  [[ $mode == on || $mode == off ]] || usage_error "autostart: say on or off"
  load "$1"
  resolve_target
  build_ssh_opts
  install_autostart "$mode"
}

install_autostart() { # on|off
  if [[ $C_OS == windows ]]; then
    if [[ $1 == on ]]; then win_run "$(win_hook_ps "$C_DIR")" || return 1; fi
    win_run "$(win_autostart_ps "$1")"
  elif [[ $1 == on ]]; then
    autostart_hook "$C_DIR" "$C_SESSION" | run_ssh -T -- "$TARGET" "$(remote_cmd "$AUTOSTART_SH" on)"
  else
    run_ssh -T -- "$TARGET" "$(remote_cmd "$AUTOSTART_SH" off)" </dev/null
  fi
}

# Why the VM should stay on ("" when nothing uses it): other connections from
# here (vmforai shell, mount, another connect), tmux sessions, logins.
vm_busy() {
  local pid args n=0 out
  while read -r pid args; do
    [[ $pid == "$$" || $args == *vmforai-watch* ]] && continue
    [[ " $args " == *"HostKeyAlias=vmforai-$NAME "* ]] && n=$((n + 1))
  done < <(ps -eo pid=,args= 2>/dev/null || true)
  if ((n)); then
    printf 'another connection from this computer is open (vmforai shell, mount, ...)'
    return 0
  fi
  if [[ $C_OS == windows ]]; then
    out=$(run_ssh -o BatchMode=yes -T -- "$TARGET" "$(win_cmd "$BUSY_PS")" </dev/null 2>/dev/null) ||
      { printf 'could not check the VM over SSH'; return 0; }
  else
    out=$(run_ssh -o BatchMode=yes -T -- "$TARGET" "$(remote_cmd "$BUSY_SH")" </dev/null 2>/dev/null) ||
      { printf 'could not check the VM over SSH'; return 0; }
  fi
  out=${out//$'\r'/}
  out=$(sed '/^$/d' <<<"$out")
  printf '%s' "${out//$'\n'/; }"
}

# After a session: shut the libvirt VM down unless something else uses it.
autostop() {
  [[ -n $C_DOMAIN && ${P[AUTOSTOP]:-on} == on ]] || return 0
  local why
  why=$(vm_busy)
  if [[ -n $why ]]; then
    info "VM $C_DOMAIN stays on: $why."
    [[ $why == *tmux* ]] && info "Back to Claude: $PROG $NAME"
    info "Shut it down: $PROG stop $NAME"
    return 0
  fi
  stop_vm 0 || true
}

cmd_start() {
  [[ $# = 1 ]] || usage_error "start: give one NAME"
  load "$1"
  [[ -n $C_DOMAIN ]] || die "'$NAME' is not a libvirt VM (no --domain); start it yourself"
  resolve_target
  say "VM $NAME is running: $C_USER@$TARGET"
}

cmd_stop() {
  local name='' force=0
  while (($#)); do
    case $1 in
      -f | --force) force=1; shift ;;
      -*) usage_error "stop: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "stop: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "stop: missing NAME"
  load "$name"
  [[ -n $C_DOMAIN ]] || die "'$NAME' is not a libvirt VM (no --domain); shut it down yourself, e.g.: $PROG shell $NAME 'sudo poweroff'"
  stop_vm "$force"
}

cmd_yolo() {
  (($# >= 1 && $# <= 2)) || usage_error "yolo: give NAME and on or off"
  load "$1"
  if (($# == 1)); then say "${P[YOLO]:-off}"; return 0; fi
  [[ $2 == on || $2 == off ]] || usage_error "yolo: on or off"
  P[YOLO]=$2
  write_profile "$NAME"
  if [[ $2 == on ]]; then
    say "Agents on $NAME act without asking first (Claude Code --dangerously-skip-permissions, Codex"
    say "--dangerously-bypass-approvals-and-sandbox, Gemini CLI --yolo, OpenCode --auto, aider --yes-always)."
    say "What they break stays in the VM: $PROG undo $NAME takes it back."
    say "An agent already running in tmux keeps its mode until it is started again (quit it first)."
  else
    say "Agents on $NAME ask before they act again."
  fi
}

cmd_agent() {
  (($# >= 1 && $# <= 2)) || usage_error "agent: give NAME and an agent ($AGENTS)"
  load "$1"
  if (($# == 1)); then
    say "$C_AGENT"
    return 0
  fi
  [[ " $AGENTS " == *" $2 "* ]] || usage_error "unknown agent: $2 (one of: $AGENTS)"
  [[ $C_OS == windows && $2 != claude ]] && die "only Claude Code runs on Windows VMs for now"
  if [[ $2 != claude ]]; then
    resolve_target
    [[ $C_OS == windows ]] && die "only Claude Code runs on Windows VMs for now"
    build_ssh_opts
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$AGENT_INSTALL_SH" "$2")" || die "installing $2 on the VM failed"
    note_agent "$2"
  fi
  P[AGENT]=$2
  write_profile "$NAME"
  say "\"$PROG $NAME\" opens $2 now. Once with another: $PROG $NAME --claude"
}

cmd_autostop() {
  [[ $# = 2 ]] || usage_error "autostop: give NAME and on|off"
  local mode=$2
  [[ $mode == on || $mode == off ]] || usage_error "autostop: say on or off"
  load "$1"
  [[ -n $C_DOMAIN ]] || die "autostop needs a libvirt VM; '$NAME' has no --domain"
  P[AUTOSTOP]=$mode
  write_profile "$NAME"
  if [[ $mode == on ]]; then
    say "Autostop is on: the VM shuts down when you leave Claude (unless something else still uses it)."
  else
    say "Autostop is off: the VM keeps running after you leave Claude ($PROG stop $NAME shuts it down)."
  fi
}

# Notes that AGENT is installed on the VM (for list and the UI).
note_agent() {
  [[ ,${P[AGENTS]:-}, == *",$1,"* ]] && return 0
  P[AGENTS]=${P[AGENTS]:+${P[AGENTS]},}$1
  write_profile "$NAME"
}

cmd_setup() {
  local name='' install=1 autostart=1 agents='' a
  while (($#)); do
    case $1 in
      --no-install) install=0; shift ;;
      --no-autostart) autostart=0; shift ;;
      --agents)
        (($# >= 2)) || usage_error "setup: --agents needs a list, e.g. claude,codex"
        agent_list_ok "$2" || usage_error "setup: --agents takes a comma-separated list of: $AGENTS"
        agents=$2; shift 2 ;;
      -*) usage_error "setup: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "setup: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "setup: missing NAME"
  load "$name"
  [[ $C_OS == windows && -n $agents && $agents != claude ]] && die "only Claude Code runs on Windows VMs for now"
  command -v ssh >/dev/null || die "ssh not found (install openssh-client)"
  ensure_key
  resolve_target
  build_ssh_opts

  info "[1/3] SSH key"
  if key_auth_works; then
    info "  key login already works"
  else
    info "  installing $C_KEY.pub for $C_USER@$TARGET (enter the VM password if asked)"
    local addkey
    if [[ $C_OS == windows ]]; then
      addkey=$(win_cmd "$(win_addkey_ps "$(<"$C_KEY.pub")")")
    else
      addkey=$(remote_cmd "$ADDKEY_SH")
    fi
    run_ssh -T -o PreferredAuthentications=keyboard-interactive,password,publickey -- \
      "$TARGET" "$addkey" <"$C_KEY.pub" ||
      die "could not install the key (wrong password? is password login enabled on the VM?)"
    if ! key_auth_works; then
      [[ $C_OS == windows ]] &&
        die "key installed, but key login still fails (for administrators Windows reads C:\\ProgramData\\ssh\\administrators_authorized_keys; was the session elevated?)"
      die "key installed, but key login still fails (check PubkeyAuthentication and home directory permissions on the VM)"
    fi
    info "  key login works"
  fi

  if ((install)) && [[ $C_OS == windows ]]; then
    info "[2/3] Git for Windows and Claude Code"
    win_run "$WIN_INSTALL_PS" || die "installing on the VM failed"
    note_agent claude
  elif ((install)); then
    [[ -n $agents ]] || agents=claude
    info "[2/3] tmux and ${agents//,/, }"
    local cl=no
    [[ ,$agents, == *,claude,* ]] && cl=yes
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$INSTALL_SH" "$cl")" || die "installing on the VM failed"
    [[ $cl == yes ]] && note_agent claude
    for a in ${agents//,/ }; do
      [[ $a == claude ]] && continue
      run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$AGENT_INSTALL_SH" "$a")" </dev/null || die "installing $a on the VM failed"
      note_agent "$a"
    done
    # The first one is what "vmforai NAME" opens.
    if [[ ${agents%%,*} != "${P[AGENT]:-claude}" ]]; then P[AGENT]=${agents%%,*}; write_profile "$NAME"; fi
  else
    info "[2/3] skipped installing Claude Code"
  fi

  if ((autostart)); then
    info "[3/3] autostart on SSH login"
    install_autostart on || die "could not install the autostart hook"
  else
    info "[3/3] skipped autostart"
  fi

  say ""
  if [[ ${P[AGENT]:-claude} == claude ]]; then
    say "Done. Open Claude on the VM with:  $PROG $NAME"
  else
    say "Done. Open ${P[AGENT]} on the VM with:  $PROG $NAME"
  fi
  say "Log in to Claude once (in a browser on this computer):  $PROG login $NAME"
  [[ $C_OS == windows ]] && say "Windows has no tmux: closing the connection ends Claude's session."
  say "App-menu launcher:                 $PROG desktop $NAME"
}

cmd_doctor() {
  local name=${1:-} ok=1 out
  [[ -n $name ]] || name=$(default_name) || usage_error "doctor: missing NAME"
  load "$name"
  pass() { printf '  ok    %s\n' "$*"; }
  fail() { printf '  FAIL  %s\n' "$*"; ok=0; }
  say "Checking '$NAME'"
  if command -v ssh >/dev/null; then pass "ssh: $(ssh -V 2>&1)"; else fail "ssh not installed"; fi
  if [[ -f $C_KEY ]]; then pass "key: $C_KEY"; else fail "key $C_KEY missing (run: $PROG setup $NAME)"; fi
  if [[ -n $C_DOMAIN ]]; then
    if ! command -v virsh >/dev/null; then fail "virsh not installed"; return 1; fi
    if out=$(vsh domstate "$C_DOMAIN" 2>&1); then
      out=${out%%$'\n'*}
      if [[ $out == running ]]; then pass "libvirt domain $C_DOMAIN: running"
      else fail "libvirt domain $C_DOMAIN: $out (connecting starts it)"; return 1; fi
    else
      fail "libvirt: $out"; return 1
    fi
    if [[ -n $C_HOST ]]; then TARGET=$C_HOST
    elif find_ip; then TARGET=$FOUND_IP; pass "IP address: $TARGET"
    else fail "no IPv4 address yet (still booting? network down?)"; return 1
    fi
  else
    TARGET=$C_HOST
  fi
  if ssh_ready "$TARGET" "$C_PORT"; then pass "SSH server answers on $TARGET:$C_PORT ($BANNER)"
  else fail "no SSH server answers on $TARGET:$C_PORT"; return 1; fi
  detect_os
  build_ssh_opts
  if key_auth_works; then pass "key login as $C_USER"
  else fail "key login as $C_USER failed (run: $PROG setup $NAME)"; return 1; fi
  local probe
  if [[ $C_OS == windows ]]; then
    probe=$(win_cmd "$WIN_DOCTOR_PS")
  else
    # shellcheck disable=SC2016
    probe=$(remote_cmd "$REMOTE_ENV"'
printf "claude=%s\n" "$(command -v claude >/dev/null 2>&1 && claude --version 2>/dev/null | head -n 1)"
printf "tmux=%s\n" "$(command -v tmux >/dev/null 2>&1 && tmux -V)"
printf "hook=%s\n" "$([ -f "$HOME/.config/vmforai/autostart.sh" ] && echo on)"
printf "login=%s\n" "$(if [ -f "$HOME/.config/vmforai/claude-env" ]; then echo token; elif [ -f "$HOME/.claude/.credentials.json" ]; then echo login; fi)"
printf "hooks=%s\n" "$([ -f "$HOME/.config/vmforai/claude-settings.json" ] && echo on)"
printf "idle=%s\n" "$(sed -n "s/^ExecStart=.* \([0-9][0-9]*\)\$/\1/p" /etc/systemd/system/vmforai-idle.service 2>/dev/null) $(systemctl is-active vmforai-idle 2>/dev/null)"
')
  fi
  out=$(run_ssh -T -o BatchMode=yes -- "$TARGET" "$probe" </dev/null 2>/dev/null | tr -d '\r') ||
    { fail "running a command on the VM failed"; return 1; }
  local claude tmux hook git
  claude=$(sed -n 's/^claude=//p' <<<"$out")
  tmux=$(sed -n 's/^tmux=//p' <<<"$out")
  git=$(sed -n 's/^git=//p' <<<"$out")
  hook=$(sed -n 's/^hook=//p' <<<"$out")
  if [[ -n $claude ]]; then pass "Claude Code on the VM: $claude"; else fail "Claude Code not installed on the VM (run: $PROG setup $NAME)"; fi
  if [[ $C_OS == windows ]]; then
    if [[ -n $git ]]; then pass "Git for Windows: $git"; else fail "Git for Windows not installed (run: $PROG setup $NAME)"; fi
  elif [[ -n $tmux ]]; then pass "tmux on the VM: $tmux"
  elif [[ -n $C_SESSION ]]; then printf '  warn  tmux not installed; sessions end when the connection drops\n'; fi
  if [[ -n $hook ]]; then pass "autostart on SSH login: on"; else printf '  info  autostart on SSH login: off\n'; fi
  case $(sed -n 's/^login=//p' <<<"$out") in
    token) pass "Claude login: token from \"$PROG login\"" ;;
    login) pass "Claude login: done inside Claude (/login)" ;;
    *) printf '  info  Claude login: not yet (run: %s login %s)\n' "$PROG" "$NAME" ;;
  esac
  if [[ $C_OS != windows ]]; then
    if [[ -n $(sed -n 's/^hooks=//p' <<<"$out") ]]; then pass "Claude hooks (idle state, notifications): installed"
    else printf '  info  Claude hooks: not yet (the next "%s %s" installs them)\n' "$PROG" "$NAME"; fi
  fi
  local idle
  idle=$(sed -n 's/^idle=//p' <<<"$out")
  if [[ $idle =~ ^([0-9]+)\ active$ ]]; then pass "idle shutdown: after ${BASH_REMATCH[1]} minutes without use"
  elif [[ $idle =~ ^[0-9]+ ]]; then printf '  warn  idle shutdown is set up but not running (%s)\n' "$idle"
  else printf '  info  idle shutdown: off (turn on: %s idle %s 30)\n' "$PROG" "$NAME"; fi
  if [[ -n $C_DOMAIN ]]; then
    local snaps
    snaps=$(snapshot_rows)
    if [[ -n $snaps ]]; then
      printf '  info  snapshots: %s, newest %s\n' "$(grep -c . <<<"$snaps")" "$(tail -n 1 <<<"$snaps" | cut -f1)"
    else
      printf '  info  snapshots: none yet\n'
    fi
  fi
  ((ok)) && say "All good." || return 1
}

# ------------------------------------------------------------------ deps: what vmforai needs here

# What vmforai uses on this computer, by what it is for. Each item: KEY,
# whether it is there, what it is for. deps_pkgs turns a KEY into the
# packages of this distribution's package manager.
DEPS_SBIN=${VMFORAI_SBIN:-/usr/sbin}
deps_items() { # [all] [nolibvirt]: KEY|NAME|FOR lines
  local all=$1 nolibvirt=$2
  printf '%s\n' 'ssh|ssh|connecting to VMs' 'curl|curl|downloads' 'flock|flock|one watcher, one server at a time' \
    'python3|python3|the UI, the phone page, the restricted network' 'git|git|projects and fix'
  if ((!nolibvirt)); then
    printf '%s\n' 'libvirt|libvirt|starting, stopping and snapshotting VMs' 'virtinst|virt-install|creating VMs' \
      'qemu|qemu|running VMs (KVM)' 'xorriso|xorriso|the first-boot disk of new VMs' 'dnsmasq|dnsmasq|the VMs'"'"' network'
  fi
  if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || ((all)); then
    printf '%s\n' 'notify|notify-send|desktop notifications' 'clip|xclip|the shared clipboard'
  fi
  ((all)) && printf '%s\n' 'sshfs|sshfs|vmforai mount'
  printf '%s\n' 'ui|uv|the terminal UI (Textual, through uv)'
}

deps_have() { # KEY
  case $1 in
    ssh) command -v ssh >/dev/null && command -v ssh-keygen >/dev/null ;;
    python3 | git | curl | flock) command -v "$1" >/dev/null ;;
    libvirt) command -v virsh >/dev/null && { command -v libvirtd >/dev/null || command -v virtqemud >/dev/null ||
      [[ -x $DEPS_SBIN/libvirtd || -x $DEPS_SBIN/virtqemud ]]; } ;;
    virtinst) command -v virt-install >/dev/null ;;
    qemu) command -v qemu-img >/dev/null && { command -v qemu-system-x86_64 >/dev/null || command -v qemu-system-aarch64 >/dev/null ||
      command -v qemu-kvm >/dev/null || [[ -x /usr/libexec/qemu-kvm ]]; } ;;
    xorriso) iso_tool >/dev/null ;;
    dnsmasq) command -v dnsmasq >/dev/null || [[ -x $DEPS_SBIN/dnsmasq ]] ;;
    notify) command -v notify-send >/dev/null ;;
    clip) command -v wl-copy >/dev/null || command -v xclip >/dev/null || command -v xsel >/dev/null ;;
    sshfs) command -v sshfs >/dev/null ;;
    ui) command -v uv >/dev/null || [[ -x $HOME/.local/bin/uv ]] || python3 -c 'import textual, pyte' 2>/dev/null ;;
  esac
}

deps_manager() { # prints apt, dnf, pacman, zypper or apk
  local m
  for m in apt-get dnf pacman zypper apk; do
    command -v "$m" >/dev/null && { printf '%s\n' "${m%-get}"; return 0; }
  done
  return 1
}

deps_pkgs() { # MANAGER KEY: its packages (none for ui: uv comes from its own installer)
  local m=$1 arm=0
  [[ $(uname -m) == aarch64 || $(uname -m) == arm64 ]] && arm=1
  case $m:$2 in
    apt:ssh) echo openssh-client ;; dnf:ssh | zypper:ssh) echo openssh-clients ;; pacman:ssh) echo openssh ;;
    apk:ssh) echo openssh-client-default openssh-keygen ;;
    *:curl) echo curl ;;
    apk:flock) echo flock ;; *:flock) echo util-linux ;;
    pacman:python3) echo python ;; *:python3) echo python3 ;;
    *:git) echo git ;;
    apt:libvirt) echo libvirt-daemon-system libvirt-clients ;;
    dnf:libvirt) echo libvirt-daemon-kvm libvirt-client ;;
    pacman:libvirt) echo libvirt ;;
    zypper:libvirt) echo libvirt-daemon-qemu libvirt-daemon-driver-network libvirt-client ;;
    apk:libvirt) echo libvirt-daemon libvirt-client ;;
    apt:virtinst) echo virtinst ;; *:virtinst) echo virt-install ;;
    apt:qemu) if ((arm)); then echo qemu-system-arm qemu-utils; else echo qemu-system-x86 qemu-utils; fi ;;
    dnf:qemu) echo qemu-kvm qemu-img ;;
    pacman:qemu) echo qemu-desktop ;;
    zypper:qemu) if ((arm)); then echo qemu-arm qemu-tools; else echo qemu-x86 qemu-tools; fi ;;
    apk:qemu) if ((arm)); then echo qemu-system-aarch64 qemu-img; else echo qemu-system-x86_64 qemu-img; fi ;;
    pacman:xorriso) echo libisoburn ;; *:xorriso) echo xorriso ;;
    apt:dnsmasq) echo dnsmasq-base ;; *:dnsmasq) echo dnsmasq ;;
    apt:notify) echo libnotify-bin ;; zypper:notify) echo libnotify-tools ;; *:notify) echo libnotify ;;
    *:clip) if [[ -n ${WAYLAND_DISPLAY:-} ]]; then echo wl-clipboard; else echo xclip; fi ;;
    dnf:sshfs) echo fuse-sshfs ;; *:sshfs) echo sshfs ;;
  esac
}

deps_install() { # MANAGER SUDO PACKAGES...
  local m=$1 su=$2
  shift 2
  case $m in
    apt)
      # A computer that just started may be updating itself: wait for apt's lock (up to 10 minutes).
      local lock=(-o DPkg::Lock::Timeout=600) i
      for ((i = 0; i < 60; i++)); do
        $su apt-get "${lock[@]}" update -qq && break
        ((i == 0)) && info "apt is busy (updates?); waiting for it..."
        sleep 10
      done
      $su env DEBIAN_FRONTEND=noninteractive apt-get "${lock[@]}" install -y "$@" ;;
    dnf) $su dnf install -y "$@" ;;
    pacman) $su pacman -S --needed --noconfirm "$@" || $su pacman -Syu --needed --noconfirm "$@" ;;
    zypper) $su zypper --non-interactive install "$@" ;;
    apk) $su apk add "$@" ;;
  esac
}

# libvirt's service on, and this user allowed to use it. The default
# network is left alone ("vmforai create" turns it on when it needs it).
deps_libvirt_setup() { # SUDO
  local su=$1 user
  user=$(id -un)
  if command -v systemctl >/dev/null && [[ -d /run/systemd/system ]]; then
    if systemctl is-active --quiet libvirtd.service libvirtd.socket virtqemud.socket virtqemud.service 2>/dev/null; then :
    elif systemctl cat virtqemud.socket >/dev/null 2>&1 && ! systemctl cat libvirtd.service >/dev/null 2>&1; then
      info "Starting libvirt (virtqemud and its friends)..."
      $su systemctl enable --now virtqemud.socket virtnetworkd.socket virtstoraged.socket virtnodedevd.socket ||
        warn "could not start libvirt; by hand: sudo systemctl enable --now virtqemud.socket"
    else
      info "Starting libvirt (libvirtd)..."
      $su systemctl enable --now libvirtd.service || warn "could not start libvirt; by hand: sudo systemctl enable --now libvirtd"
    fi
  elif command -v rc-service >/dev/null; then
    info "Starting libvirt (OpenRC)..."
    { $su rc-update add libvirtd default && $su rc-service libvirtd start; } || warn "could not start libvirtd"
  fi
  if getent group libvirt >/dev/null && ! id -nG "$user" | tr ' ' '\n' | grep -qx libvirt; then
    info "Adding $user to the libvirt group..."
    if $su usermod -aG libvirt "$user" 2>/dev/null || $su adduser "$user" libvirt 2>/dev/null; then
      DEPS_RELOGIN=1
    else
      warn "could not add $user to the libvirt group; by hand: sudo usermod -aG libvirt $user"
    fi
  fi
}

# The first time vmforai runs in a terminal (installed by a package, by
# hand, or with install.sh --no-deps): what is missing is installed then,
# without asking for a command. Once; "vmforai deps" does it again.
deps_first_use() {
  local mark=$CONF_DIR/deps-checked key name what miss=''
  [[ -t 0 && -t 1 && -z ${VMFORAI_NO_DEPS:-} && ! -e $mark && $(uname -s) == Linux ]] || return 0
  mkdir -p "$CONF_DIR" && : >"$mark" || return 0
  while IFS='|' read -r key name what; do deps_have "$key" || miss+=" $name"; done < <(deps_items 0 0)
  if getent group libvirt >/dev/null 2>&1 && ! id -nG | tr ' ' '\n' | grep -qx libvirt; then
    miss+=" (the libvirt group)"
  fi
  [[ -n $miss ]] || return 0
  say "First run: vmforai puts what it uses on this computer:$miss"
  ( cmd_deps --yes ) || warn "not all of it is there; later: $PROG deps"
  say ""
}

DEPS_RELOGIN=0
cmd_deps() {
  local check=0 yes=0 all=0 nolibvirt=0 key name what m su='' line a
  local -a need=() pkgs=() got=()
  while (($#)); do
    case $1 in
      --check) check=1 ;;
      -y | --yes) yes=1 ;;
      --all) all=1 ;;
      --no-libvirt) nolibvirt=1 ;;
      *) usage_error "deps: unknown argument $1" ;;
    esac
    shift
  done
  say "What vmforai uses on this computer:"
  while IFS='|' read -r key name what; do
    if deps_have "$key"; then
      printf '  ok       %-13s %s\n' "$name" "$what"
    else
      printf '  missing  %-13s %s\n' "$name" "$what"
      need+=("$key")
    fi
  done < <(deps_items "$all" "$nolibvirt")
  if ((!${#need[@]})); then
    say "Everything is here."
    ((check || nolibvirt)) || { [[ $(id -u) == 0 ]] || su=sudo; deps_libvirt_setup "$su"; deps_relogin_note; }
    return 0
  fi
  if ((check)); then
    say "Install them: $PROG deps"
    return 1
  fi
  m=$(deps_manager) || die "no package manager here that vmforai knows (apt, dnf, pacman, zypper, apk); install the missing ones by hand"
  for key in "${need[@]}"; do
    read -ra got <<<"$(deps_pkgs "$m" "$key")"
    pkgs+=("${got[@]}")
  done
  if [[ $(id -u) != 0 ]]; then
    if command -v sudo >/dev/null; then su=sudo
    elif command -v doas >/dev/null; then su=doas
    else die "installing packages needs root: run this as root, or install sudo"
    fi
  fi
  say ""
  ((${#pkgs[@]})) && say "To install with $m${su:+ ($su asks for your password)}: ${pkgs[*]}"
  [[ " ${need[*]} " == *" ui "* ]] && say "And uv (for the UI), from astral.sh into ~/.local/bin (no sudo)."
  if ((!yes)); then
    [[ -t 0 ]] || die "not going on without --yes"
    read -r -p "Go on? [Y/n] " a || a=n
    [[ -z $a || $a == [yYeE]* ]] || exit 1
  fi
  if ((${#pkgs[@]})); then
    deps_install "$m" "$su" "${pkgs[@]}" || die "$m could not install them (see above)"
  fi
  if [[ " ${need[*]} " == *" ui "* ]]; then
    info "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh >/dev/null ||
      warn "could not install uv; the UI needs it (or: pip install textual pyte)"
  fi
  ((nolibvirt)) || deps_libvirt_setup "$su"
  say ""
  line=''
  while IFS='|' read -r key name what; do deps_have "$key" || line+=" $name"; done < <(deps_items "$all" "$nolibvirt")
  if [[ -z $line ]]; then say "Done: everything vmforai uses is here."
  else warn "still missing:$line (see: $PROG deps --check)"
  fi
  deps_relogin_note
}

deps_relogin_note() {
  ((DEPS_RELOGIN)) && say "Log out and in again (or reboot) once: then you may use libvirt without sudo."
  return 0
}

# ------------------------------------------------------------------ create / delete

CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/vmforai
CREATE_POOL=${VMFORAI_POOL:-${VMCLAUDE_POOL:-default}}
CREATE_NETWORK=${VMFORAI_NETWORK:-${VMCLAUDE_NETWORK:-default}}

# Sets IMG_URL, IMG_SUMS (checksum list), IMG_ALGO, IMG_OSINFO for an image name.
IMG_URL='' IMG_SUMS='' IMG_ALGO='' IMG_OSINFO=''
image_info() {
  case $1 in
    debian13 | debian)
      IMG_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
      IMG_SUMS=https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS
      IMG_ALGO=sha512 IMG_OSINFO=debian13 ;;
    debian12)
      IMG_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2
      IMG_SUMS=https://cloud.debian.org/images/cloud/bookworm/latest/SHA512SUMS
      IMG_ALGO=sha512 IMG_OSINFO=debian12 ;;
    ubuntu24.04 | ubuntu)
      IMG_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
      IMG_SUMS=https://cloud-images.ubuntu.com/noble/current/SHA256SUMS
      IMG_ALGO=sha256 IMG_OSINFO=ubuntu24.04 ;;
    arch | archlinux)
      # The checksum always comes from Arch itself; the image may come from
      # a faster mirror (VMFORAI_ARCH_MIRROR, e.g. https://mirrors.dotsrc.org/archlinux).
      IMG_URL=${VMFORAI_ARCH_MIRROR:-${VMCLAUDE_ARCH_MIRROR:-https://geo.mirror.pkgbuild.com}}
      IMG_URL=${IMG_URL%/}/images/latest/Arch-Linux-x86_64-cloudimg.qcow2
      IMG_SUMS=https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2.SHA256
      IMG_ALGO=sha256 IMG_OSINFO=archlinux ;;
    *) die "unknown image: $1 (choose debian13, debian12, ubuntu24.04 or arch; see: $PROG images)" ;;
  esac
}

# Sets IMG_HASH: the published checksum of the current image (or, offline,
# the checksum of the cached copy).
IMG_FILE='' IMG_HASH=''
image_hash() {
  local name=${IMG_URL##*/} sums
  mkdir -p "$CACHE_DIR/images"
  IMG_FILE=$CACHE_DIR/images/$name
  if sums=$(curl -fsSL "$IMG_SUMS"); then
    IMG_HASH=$(awk -v f="$name" '$2 == f || $2 == "*" f { print $1; exit }' <<<"$sums")
    [[ -n $IMG_HASH ]] || die "no checksum for $name in $IMG_SUMS"
  elif [[ -f $IMG_FILE ]]; then
    warn "cannot fetch $IMG_SUMS; using the cached image unchecked"
    IMG_HASH=$("${IMG_ALGO}sum" "$IMG_FILE" | cut -d' ' -f1)
  else
    die "cannot download $IMG_SUMS (offline?)"
  fi
}

# Makes sure IMG_FILE holds the image with IMG_HASH: downloads it if needed.
fetch_image() {
  local got
  if [[ -f $IMG_FILE ]] && [[ $("${IMG_ALGO}sum" "$IMG_FILE" | cut -d' ' -f1) == "$IMG_HASH" ]]; then
    info "Using cached image $IMG_FILE"
    return 0
  fi
  info "Downloading $IMG_URL"
  if [[ -t 2 ]]; then
    curl -fL -# -o "$IMG_FILE.part" "$IMG_URL" || die "download failed"
  else
    # No terminal (the UI, a log): a line every 5 seconds instead of a bar.
    local pid i=0
    curl -fsL -o "$IMG_FILE.part" "$IMG_URL" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      sleep 1
      ((++i % 5)) || info "  ...$(($(stat -c %s "$IMG_FILE.part" 2>/dev/null || echo 0) / 1048576)) MB downloaded after ${i}s"
    done
    wait "$pid" || die "download failed"
  fi
  got=$("${IMG_ALGO}sum" "$IMG_FILE.part" | cut -d' ' -f1)
  [[ $got == "$IMG_HASH" ]] ||
    { rm -f "$IMG_FILE.part"; die "checksum mismatch for ${IMG_URL##*/} (a mirror may not have synced the latest image yet)"; }
  mv -f "$IMG_FILE.part" "$IMG_FILE"
}

osinfo_name() { # NAME -> NAME if virt-install knows it, else a generic Linux
  if virt-install --osinfo list 2>/dev/null | tr ',' '\n' | sed 's/^ *//' | grep -qxF "$1"; then
    printf '%s' "$1"
  else
    printf 'linux2022'
  fi
}

cloud_user_data() { # HOSTNAME USER PUBKEY [copy]
  cat <<EOF
#cloud-config
hostname: $1
users:
  - name: $2
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - $3
EOF
  if [[ ${4:-} == copy ]]; then
    # A copy (vmforai try) has its packages already. It needs a machine-id
    # of its own, and DHCP to tell it apart from the other copies.
    printf '%s\n' 'bootcmd:' '  - [cloud-init-per, instance, vmforai-copy, sh, -c, "rm -f /etc/machine-id /var/lib/dbus/machine-id; systemd-machine-id-setup >/dev/null 2>&1; mkdir -p /etc/systemd/networkd.conf.d; printf '"'"'[DHCPv4]\\nDUIDType=link-layer\\n[DHCPv6]\\nDUIDType=link-layer\\n'"'"' >/etc/systemd/networkd.conf.d/50-vmforai.conf; systemctl try-restart systemd-networkd; true"]'
  else
    printf 'package_update: true\npackages: [tmux, curl]\n'
    # DHCP by the card's MAC address, not by machine-id: then copies of this
    # VM (vmforai try) get addresses of their own from the start.
    printf '%s\n' 'write_files:' '  - path: /etc/systemd/networkd.conf.d/50-vmforai.conf' '    content: |' \
      '      [DHCPv4]' '      DUIDType=link-layer' '      [DHCPv6]' '      DUIDType=link-layer'
  fi
}

iso_tool() {
  local t
  for t in xorriso genisoimage mkisofs; do command -v "$t" >/dev/null && { printf '%s' "$t"; return 0; }; done
  return 1
}

# Packs the files in DIR (user-data, meta-data, maybe network-config) into a
# cloud-init NoCloud seed ISO, uploaded as VOLUME into POOL. On failure it
# returns 1 with the reason in SEED_ERR.
SEED_ERR=
upload_seed() { # POOL VOLUME DIR
  local tool out
  local -a files=("$3"/*)
  tool=$(iso_tool) || { SEED_ERR="xorriso not found (Debian/Ubuntu: sudo apt install xorriso; Arch: sudo pacman -S libisoburn)"; return 1; }
  if [[ $tool == xorriso ]]; then
    out=$(xorriso -as mkisofs -V cidata -J -r -o "$3.iso" "${files[@]}" 2>&1)
  else
    out=$("$tool" -V cidata -J -r -o "$3.iso" "${files[@]}" 2>&1)
  fi || { SEED_ERR="creating the cloud-init seed failed: $out"; return 1; }
  vsh vol-delete --pool "$1" "$2" >/dev/null 2>&1 || true
  if ! out=$(vsh vol-create-as "$1" "$2" "$(stat -c %s "$3.iso")" --format raw 2>&1) ||
    ! out=$(vsh vol-upload --pool "$1" "$2" "$3.iso" 2>&1); then
    rm -f "$3.iso"
    vsh vol-delete --pool "$1" "$2" >/dev/null 2>&1 || true
    SEED_ERR="libvirt: $out"
    return 1
  fi
  rm -f "$3.iso"
}

cmd_create() {
  local name='' image=debian13 memory=4096 cpus=2 disk=20 user uri=qemu:///system install=1 idle=30 k
  local agents=claude ports='' project='' template='' a
  user=$(id -un)
  # A template first: the other options change what it sets.
  for ((a = 1; a < $#; a++)); do
    [[ ${!a} == --template ]] || continue
    local b=$((a + 1))
    template=${!b}
    load_template "$template"
    image=${T[IMAGE]:-$image} memory=${T[MEMORY]:-$memory} cpus=${T[CPUS]:-$cpus} disk=${T[DISK]:-$disk}
    agents=${T[AGENTS]:-$agents} ports=${T[PORTS]:-$ports}
  done
  while (($#)); do
    case $1 in
      --image | --memory | --cpus | --disk | --user | --uri | --idle | --agents | --ports | --project | --template)
        (($# >= 2)) || usage_error "create: $1 needs a value"
        case $1 in
          --image) image=$2 ;; --memory) memory=$2 ;; --cpus) cpus=$2 ;;
          --disk) disk=$2 ;; --user) user=$2 ;; --uri) uri=$2 ;; --idle) idle=$2 ;;
          --agents) agents=${2// /} ;; --ports) ports=${2// /} ;; --project) project=$2 ;; --template) ;;
        esac
        shift 2 ;;
      --no-setup) install=0; shift ;;
      -*) usage_error "create: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "create: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "create: missing NAME"
  valid_name "$name" || die "invalid name: $name (letters, digits, . _ - only)"
  profile_exists "$name" && die "a VM profile named '$name' already exists"
  for k in "$memory" "$cpus" "$disk"; do [[ $k =~ ^[1-9][0-9]*$ ]] || die "--memory, --cpus and --disk take whole numbers"; done
  [[ $idle == off ]] && idle=0
  [[ $idle =~ ^[0-9]+$ ]] || die "--idle takes minutes, or off"
  agent_list_ok "$agents" || die "--agents takes a comma-separated list of: $AGENTS"
  [[ -z $ports ]] || port_list_ok "$ports" || die "--ports takes a comma-separated list of ports, e.g. 3000,5173"
  check_value USER "$user"
  if [[ -n $project ]]; then
    command -v git >/dev/null || die "--project: git is not installed on this computer"
    git -C "$project" rev-parse -q --verify HEAD >/dev/null 2>&1 || die "--project: $project is not a git repository with commits"
  fi
  image_info "$image"
  local tool
  iso_tool >/dev/null || die "xorriso not found (Debian/Ubuntu: sudo apt install xorriso; Arch: sudo pacman -S libisoburn)"
  for tool in virsh virt-install curl "${IMG_ALGO}sum"; do
    command -v "$tool" >/dev/null ||
      die "$tool not found (Debian/Ubuntu: sudo apt install libvirt-clients virtinst; Arch: sudo pacman -S libvirt virt-install)"
  done
  C_URI=$uri
  vsh dominfo "$name" >/dev/null 2>&1 && die "libvirt already has a VM named '$name'"
  ensure_default_pool
  vsh pool-info "$CREATE_POOL" >/dev/null 2>&1 || die "libvirt storage pool '$CREATE_POOL' not found (set VMFORAI_POOL)"
  ensure_network

  C_KEY=$DEFAULT_KEY
  ensure_key
  image_hash

  # One base volume per image release, shared by all VMs as a backing file.
  # (--video vga below matters: without any video device the GRUB of the
  # Debian cloud image resets the VM in a loop right after "Booting".)
  local base="vmforai-base-$image-${IMG_HASH:0:12}.qcow2" vol="$name.qcow2" out
  # One made under the old name is just as good.
  vsh vol-info --pool "$CREATE_POOL" "$base" >/dev/null 2>&1 ||
    ! vsh vol-info --pool "$CREATE_POOL" "vmclaude-base-$image-${IMG_HASH:0:12}.qcow2" >/dev/null 2>&1 ||
    base="vmclaude-base-$image-${IMG_HASH:0:12}.qcow2"
  ! vsh vol-info --pool "$CREATE_POOL" "$base" >/dev/null 2>&1 &&
    vsh vol-info --pool "$CREATE_POOL" "vmagents-base-$image-${IMG_HASH:0:12}.qcow2" >/dev/null 2>&1 &&
    base="vmagents-base-$image-${IMG_HASH:0:12}.qcow2"
  if vsh vol-info --pool "$CREATE_POOL" "$base" >/dev/null 2>&1; then
    info "Using base volume $base"
  else
    fetch_image
    info "Copying the image into libvirt pool '$CREATE_POOL'"
    out=$(vsh vol-create-as "$CREATE_POOL" "$base" "$(stat -c %s "$IMG_FILE")" --format qcow2 2>&1) || die "libvirt: $out"
    out=$(vsh vol-upload --pool "$CREATE_POOL" "$base" "$IMG_FILE" 2>&1) ||
      { vsh vol-delete --pool "$CREATE_POOL" "$base" >/dev/null 2>&1; die "libvirt: $out"; }
    vsh pool-refresh "$CREATE_POOL" >/dev/null 2>&1 || true
  fi
  vsh vol-info --pool "$CREATE_POOL" "$vol" >/dev/null 2>&1 && die "volume $vol already exists in pool '$CREATE_POOL'"
  out=$(vsh vol-create-as "$CREATE_POOL" "$vol" "${disk}G" --format qcow2 \
    --backing-vol "$base" --backing-vol-format qcow2 2>&1) || die "libvirt: $out"

  # cloud-init seed (NoCloud): our own ISO on a read-only virtio disk, kept
  # attached. Not virt-install --cloud-init: that puts it on a SATA CD-ROM,
  # and the Debian 12 cloud kernel has no driver for it.
  local tmp seed="$name-seed.iso"
  tmp=$(mktemp -d)
  mkdir "$tmp/seed"
  cloud_user_data "$name" "$user" "$(<"$C_KEY.pub")" >"$tmp/seed/user-data"
  printf 'instance-id: %s-%s\nlocal-hostname: %s\n' "$name" "$(date +%s)" "$name" >"$tmp/seed/meta-data"
  if ! upload_seed "$CREATE_POOL" "$seed" "$tmp/seed"; then
    rm -rf "$tmp"
    vsh vol-delete --pool "$CREATE_POOL" "$vol" >/dev/null 2>&1 || true
    die "$SEED_ERR"
  fi
  rm -rf "$tmp"
  info "Creating VM $name ($image, ${memory} MB, $cpus CPUs, ${disk} GB)"
  if ! out=$(virt-install --connect "$uri" --name "$name" --memory "$memory" --vcpus "$cpus" \
    --import --disk "vol=$CREATE_POOL/$vol,bus=virtio" --disk "vol=$CREATE_POOL/$seed,device=disk,bus=virtio,readonly=on" \
    --osinfo "$(osinfo_name "$IMG_OSINFO")" --network "network=$CREATE_NETWORK,model=virtio" \
    --metadata description="created by vmforai" \
    --graphics none --video vga --console pty,target_type=serial --noautoconsole 2>&1); then
    vsh vol-delete --pool "$CREATE_POOL" "$vol" >/dev/null 2>&1 || true
    vsh vol-delete --pool "$CREATE_POOL" "$seed" >/dev/null 2>&1 || true
    die "virt-install failed: $out"
  fi

  P=([DOMAIN]=$name [USER]=$user [OS]=linux [CREATED]=1)
  [[ $uri != qemu:///system ]] && P[LIBVIRT_URI]=$uri
  [[ -n $ports ]] && P[PORTS]=$ports
  write_profile "$name"
  info "Added VM profile '$name'."
  if ((install)); then
    # sshd can be up before cloud-init has created the user and its key.
    load "$name"
    resolve_target
    build_ssh_opts
    local deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0
    until key_auth_works; do
      check_still_running
      ((SECONDS < deadline)) ||
        die "the new VM does not accept your SSH key after ${BOOT_TIMEOUT}s; see: virsh -c $C_URI console $name"
      ((noted)) || { info "Waiting for cloud-init to create user $C_USER..."; noted=1; }
      sleep 3
    done
    cmd_setup "$name" --agents "$agents"
    if ((idle > 0)); then
      info "Idle shutdown"
      if install_idle "$idle"; then P[IDLE]=$idle; write_profile "$NAME"; else warn "idle shutdown not set up (later: $PROG idle $NAME $idle)"; fi
    fi
    if [[ -n $template && -n ${T[PACKAGES]:-}${T[SETUP]:-} ]]; then
      info "Template $template"
      load "$name"
      resolve_target
      build_ssh_opts
      # shellcheck disable=SC2086 # package names
      run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$TEMPLATE_SH" "${T[SETUP]:-}" ${T[PACKAGES]:-})" </dev/null ||
        warn "the template's packages or setup failed; the VM is there (try again by hand: $PROG shell $name)"
    fi
    if [[ -n $project ]]; then
      info "Project"
      cmd_project "$name" "$project"
    fi
    notify_here "$name is ready" "The new VM is set up: $PROG $name" "done"
  else
    say "Created. Next: $PROG setup $name --agents $agents"
    [[ -z $project ]] || say "Then: $PROG project $name $(printf %q "$project")"
  fi
}

cmd_resize() {
  local name='' memory='' cpus='' stop=0 out cur
  while (($#)); do
    case $1 in
      --memory | --cpus)
        (($# >= 2)) || usage_error "resize: $1 needs a value"
        [[ $2 =~ ^[1-9][0-9]*$ ]] || die "$1 takes a whole number"
        if [[ $1 == --memory ]]; then memory=$2; else cpus=$2; fi
        shift 2 ;;
      --stop) stop=1; shift ;;
      -*) usage_error "resize: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "resize: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "resize: missing NAME"
  [[ -n $memory$cpus ]] || usage_error "resize: give --memory MB and/or --cpus N"
  load "$name"
  need_domain resize
  if [[ $(domstate) != "shut off" ]]; then
    ((stop)) || die "VM $C_DOMAIN is running; resizing needs it off. Add --stop, or: $PROG stop $NAME"
    stop_vm 0 || die "VM $C_DOMAIN did not shut down"
  fi
  if [[ -n $memory ]]; then
    out=$(vsh setmaxmem "$C_DOMAIN" "${memory}M" --config 2>&1) || die "libvirt: $out"
    out=$(vsh setmem "$C_DOMAIN" "${memory}M" --config 2>&1) || die "libvirt: $out"
  fi
  if [[ -n $cpus ]]; then
    # Raising: the maximum first; lowering: the count first.
    cur=$(vsh vcpucount "$C_DOMAIN" --maximum --config 2>/dev/null) || cur=0
    if ((cpus > cur)); then
      out=$(vsh setvcpus "$C_DOMAIN" "$cpus" --config --maximum 2>&1) && out=$(vsh setvcpus "$C_DOMAIN" "$cpus" --config 2>&1)
    else
      out=$(vsh setvcpus "$C_DOMAIN" "$cpus" --config 2>&1) && out=$(vsh setvcpus "$C_DOMAIN" "$cpus" --config --maximum 2>&1)
    fi || die "libvirt: $out"
  fi
  say "VM $C_DOMAIN now has${memory:+ $memory MB}${memory:+${cpus:+ and}}${cpus:+ $cpus CPUs}. Start it: $PROG $NAME"
}

cmd_delete() {
  local name='' yes=0 a
  while (($#)); do
    case $1 in
      -y | --yes) yes=1; shift ;;
      -*) usage_error "delete: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "delete: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "delete: missing NAME"
  load "$name"
  # Only VMs that vmforai created, and whose libvirt description says so.
  [[ ${P[CREATED]:-} == 1 && -n $C_DOMAIN ]] ||
    die "'$NAME' was not created by vmforai; delete the VM yourself (to forget it here: $PROG rm $NAME)"
  [[ $(vsh desc "$C_DOMAIN" 2>/dev/null) == *"created by vm"@(forai|agents|claude)* ]] ||
    die "libvirt VM '$C_DOMAIN' is not marked as created by vmforai; not deleting it"
  if ((!yes)); then
    [[ -t 0 ]] || die "delete: add --yes to confirm without a terminal"
    read -r -p "Delete VM '$C_DOMAIN' and its disk for good? Type its name: " a || a=
    [[ $a == "$C_DOMAIN" ]] || die "not deleted"
  fi
  vsh destroy "$C_DOMAIN" >/dev/null 2>&1 || true
  local out
  out=$(vsh undefine "$C_DOMAIN" --remove-all-storage --snapshots-metadata 2>&1) || die "libvirt: $out"
  cmd_rm "$NAME" >/dev/null
  say "Deleted VM '$NAME' and its disk."
}

IMAGES="debian13 debian12 ubuntu24.04 arch"
image_desc() {
  case $1 in
    debian13) printf 'Debian 13 "trixie" (default)' ;;
    debian12) printf 'Debian 12 "bookworm"' ;;
    ubuntu24.04) printf 'Ubuntu 24.04 LTS "noble"' ;;
    arch) printf 'Arch Linux (rolling release)' ;;
  esac
}

# Debian and Ubuntu come with the "default" storage pool; a fresh libvirt on
# Arch (and others) has none until virt-manager makes one. Make it the same way.
ensure_default_pool() {
  [[ $CREATE_POOL == default ]] || return 0
  vsh pool-info default >/dev/null 2>&1 && return 0
  info "Making the libvirt storage pool 'default' in /var/lib/libvirt/images"
  local out
  out=$(vsh pool-define-as default dir --target /var/lib/libvirt/images 2>&1) || die "libvirt: $out"
  out=$(vsh pool-build default 2>&1) || die "libvirt: $out"
  out=$(vsh pool-start default 2>&1) || die "libvirt: $out"
  vsh pool-autostart default >/dev/null 2>&1 || true
}

# Lists the images, what is downloaded, what is in the libvirt pool, and
# which VMs are built on it.
# The images and what this computer has for "create", for the UI.
images_json() {
  local img sep='' file mt ma cpus lv=false avail=null missing='' t iso=''
  printf '{"images": ['
  for img in $IMAGES; do
    image_info "$img"
    file=$CACHE_DIR/images/${IMG_URL##*/}
    printf '%s\n  {"name": %s, "description": %s, "downloaded": %s}' "$sep" "$(json_str "$img")" \
      "$(json_str "$(image_desc "$img")")" "$([[ -f $file ]] && echo true || echo false)"
    sep=,
  done
  mt=$(awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo 2>/dev/null) || mt=0
  ma=$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo 2>/dev/null) || ma=0
  cpus=$(nproc 2>/dev/null) || cpus=1
  if command -v virsh >/dev/null && vsh pool-info "$CREATE_POOL" >/dev/null 2>&1; then
    lv=true
    avail=$(vsh pool-info "$CREATE_POOL" --bytes 2>/dev/null | awk '/^Available:/ { printf "%d", $2 / 1073741824 }')
    [[ -n $avail ]] || avail=null
  elif [[ $CREATE_POOL == default ]] && command -v virsh >/dev/null && vsh uri >/dev/null 2>&1; then
    lv=true  # create makes the pool (ensure_default_pool)
  fi
  for t in xorriso genisoimage mkisofs; do command -v "$t" >/dev/null && iso=$t; done
  [[ -n $iso ]] || missing=xorriso
  for t in virsh virt-install curl; do command -v "$t" >/dev/null || missing+="${missing:+,}$t"; done
  printf '\n], "host": {"memory_mb": %d, "memory_available_mb": %d, "cpus": %d, "libvirt": %s, ' "${mt:-0}" "${ma:-0}" "$cpus" "$lv"
  printf '"pool": %s, "pool_available_gb": %s, "missing": %s, "agents": %s}, ' "$(json_str "$CREATE_POOL")" "$avail" \
    "$(json_list "$missing")" "$(json_list "${AGENTS// /,}")"
  printf '"templates": %s}\n' "$(cmd_templates --json)"
}

cmd_images() {
  local uri=qemu:///system json=0
  while (($#)); do
    case $1 in
      --uri) (($# >= 2)) || usage_error "images: --uri needs a value"; uri=$2; shift 2 ;;
      --json) json=1; shift ;;
      *) usage_error "images: unknown argument $1" ;;
    esac
  done
  C_URI=$uri
  if ((json)); then images_json; return; fi
  local lv=0 pool_path='' vols='' v b users img file dl base size row
  local -A used_by=()
  if command -v virsh >/dev/null && vsh pool-info "$CREATE_POOL" >/dev/null 2>&1; then
    lv=1
    pool_path=$(vsh pool-dumpxml "$CREATE_POOL" 2>/dev/null | sed -n 's:.*<path>\(.*\)</path>.*:\1:p' | head -n 1)
    vols=$(vsh vol-list "$CREATE_POOL" 2>/dev/null | awk 'NR > 2 && NF { print $1 }')
    for v in $vols; do
      b=$(vsh vol-dumpxml --pool "$CREATE_POOL" "$v" 2>/dev/null |
        sed -n '/<backingStore>/,/<\/backingStore>/s:.*<path>\(.*\)</path>.*:\1:p' | head -n 1)
      [[ -n $b ]] && used_by[${b##*/}]+="${used_by[${b##*/}]:+, }${v%.qcow2}"
    done
  fi

  say "Images for:  $PROG create NAME --image IMAGE"
  say ""
  printf '  %-12s %-30s %-11s %s\n' IMAGE SYSTEM DOWNLOADED "BASE IMAGE IN LIBVIRT (used by)"
  for img in $IMAGES; do
    image_info "$img"
    file=$CACHE_DIR/images/${IMG_URL##*/}
    dl=-
    [[ -f $file ]] && dl=$(du -h "$file" | cut -f1)
    row=-
    for base in $vols; do
      [[ $base == vm@(forai|agents|claude)-base-"$img"-*.qcow2 ]] || continue
      size=$(vsh vol-info --pool "$CREATE_POOL" "$base" 2>/dev/null | awk '/^Allocation:/ { print $2 $3 }')
      users=${used_by[$base]:-no VM}
      [[ $row == - ]] && row='' || row+='; '
      row+="$size ($users)"
    done
    ((lv)) || row="(libvirt not available)"
    printf '  %-12s %-30s %-11s %s\n' "$img" "$(image_desc "$img")" "$dl" "$row"
  done

  say ""
  say "Where they are:"
  say "  Downloads, kept only to make base images (prune deletes them):"
  say "    $CACHE_DIR/images/"
  if ((lv)); then
    say "  Base images, one per image release, in libvirt pool \"$CREATE_POOL\":"
    say "    $pool_path/vmforai-base-IMAGE-CHECKSUM.qcow2"
    for base in $vols; do [[ $base == vm@(forai|agents|claude)-base-*.qcow2 ]] && say "      $base"; done
    say "  Each VM made with create: its own disk (only what differs from the base)"
    say "  and its cloud-init settings:"
    say "    $pool_path/NAME.qcow2   $pool_path/NAME-seed.iso"
  fi
  say ""
  say "Make a VM: $PROG create NAME --image IMAGE.  Free space: $PROG prune."
}

# Removes base volumes no VM disk is built on, and the downloaded images.
cmd_prune() {
  local uri=qemu:///system
  while (($#)); do
    case $1 in
      --uri) (($# >= 2)) || usage_error "prune: --uri needs a value"; uri=$2; shift 2 ;;
      *) usage_error "prune: unknown argument $1" ;;
    esac
  done
  command -v virsh >/dev/null || die "virsh not found"
  C_URI=$uri
  local vols v used='' path n=0
  vols=$(vsh vol-list "$CREATE_POOL" 2>/dev/null | awk 'NR > 2 && NF { print $1 }') ||
    die "cannot list libvirt pool '$CREATE_POOL'"
  for v in $vols; do
    used+=$(vsh vol-dumpxml --pool "$CREATE_POOL" "$v" 2>/dev/null |
      sed -n '/<backingStore>/,/<\/backingStore>/s:.*<path>\(.*\)</path>.*:\1:p')$'\n'
  done
  for v in $vols; do
    [[ $v == vm@(forai|agents|claude)-base-*.qcow2 ]] || continue
    path=$(vsh vol-path --pool "$CREATE_POOL" "$v" 2>/dev/null) || continue
    if grep -qxF "$path" <<<"$used"; then
      say "Kept $v (a VM uses it)"
    elif vsh vol-delete --pool "$CREATE_POOL" "$v" >/dev/null 2>&1; then
      say "Removed $v"
      n=$((n + 1))
    fi
  done
  if [[ -d $CACHE_DIR/images ]] && [[ -n $(ls -A "$CACHE_DIR/images") ]]; then
    say "Removed downloaded images ($(du -sh "$CACHE_DIR/images" | cut -f1))"
    rm -rf "${CACHE_DIR:?}/images"
  fi
  ((n)) || say "No unused base volumes."
}

# ------------------------------------------------------------------ MCP server
# "vmforai mcp NAME" speaks MCP on stdin/stdout so that a Claude Code on this
# computer can run commands and edit files inside the VM. The protocol part is
# the Python program below; it calls the hidden __mcp-* commands for each step,
# so SSH options, VM start-up and Linux/Windows differences stay in one place.

mcp_prepare() { # NAME: load, start the VM if needed, connect options
  load "$1"
  resolve_target
  build_ssh_opts
}

# __mcp-info NAME: prints os=, home= and dir= (the working directory, created).
cmd___mcp-info() {
  mcp_prepare "$1"
  vm_info_lines
}

vm_info_lines() { # needs mcp_prepare first
  if [[ $C_OS == windows ]]; then
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(win_cmd "$WIN_ENV_PS"'$d = Resolve-Dir '"$(psq "$C_DIR")"'
if (-not (Test-Path -LiteralPath $d)) { New-Item -ItemType Directory -Force -Path $d | Out-Null }
"os=windows"; "home=$env:USERPROFILE"; "dir=" + (Resolve-Path -LiteralPath $d).Path')" </dev/null | tr -d '\r'
  else
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(remote_cmd "$REMOTE_ENV"'cd_dir "$1" || exit 1
printf "os=linux\nhome=%s\ndir=%s\n" "$HOME" "$PWD"' "$C_DIR")" </dev/null
  fi
}

# __mcp-run NAME DIR COMMAND: runs COMMAND in DIR on the VM (bash/sh on Linux,
# PowerShell on Windows). Output and exit code pass through.
cmd___mcp-run() {
  mcp_prepare "$1"
  local dir=$2 command=$3
  if [[ $C_OS == windows ]]; then
    # Errors are written as plain text: left to PowerShell, they reach us
    # as CLIXML when stderr is not a console.
    win_run "$WIN_ENV_PS\$global:LASTEXITCODE = 0
\$vmforaiFailed = \$false
Set-Location -LiteralPath $(psq "$dir")
& {
$command
} 2>&1 | ForEach-Object {
  if (\$_ -is [System.Management.Automation.ErrorRecord]) { \$script:vmforaiFailed = \$true; [Console]::Error.WriteLine(\$_.ToString()) }
  else { \$_ }
}
if (\$LASTEXITCODE) { exit \$LASTEXITCODE }
if (\$vmforaiFailed) { exit 1 }
exit 0"
  else
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(remote_cmd "$REMOTE_ENV"'cd "$1" || exit 1
if command -v bash >/dev/null 2>&1; then exec bash -c "$2"; else exec sh -c "$2"; fi' "$dir" "$command")" </dev/null
  fi
}

# Remote paths for scp/sftp: Windows wants C:/x/y written as /C:/x/y.
sftp_path() {
  local p=$1
  if [[ $C_OS == windows ]]; then
    p=${p//\\//}
    [[ $p == [A-Za-z]:/* ]] && p=/$p
  fi
  printf '%s' "$p"
}

run_scp() { # [-r] SRC... DST (remote ones as host:path)
  local -a scp_opts=(-q -s -P "$C_PORT" -o "HostKeyAlias=vmforai-$NAME" -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15)
  [[ -f $C_KEY ]] && scp_opts+=(-i "$C_KEY" -o IdentitiesOnly=yes)
  [[ $1 == -r ]] && { scp_opts+=(-r); shift; }
  scp "${scp_opts[@]}" -- "$@"
}

scp_host() { # user@host, with IPv6 addresses in brackets
  if [[ $TARGET == *:* && $TARGET != \[* ]]; then printf '%s@[%s]' "$C_USER" "$TARGET"
  else printf '%s@%s' "$C_USER" "$TARGET"; fi
}

# __mcp-get NAME REMOTE_PATH LOCAL_FILE
cmd___mcp-get() {
  mcp_prepare "$1"
  run_scp "$(scp_host):$(sftp_path "$2")" "$3"
}

# __mcp-put NAME LOCAL_FILE REMOTE_PATH: creates the folder first.
cmd___mcp-put() {
  mcp_prepare "$1"
  local local_file=$2 remote=$3 parent
  if [[ $C_OS == windows ]]; then
    parent=${remote%[\\/]*}
    run_ssh -T -o BatchMode=yes -- "$TARGET" \
      "$(win_cmd "New-Item -ItemType Directory -Force -Path $(psq "$parent") | Out-Null")" </dev/null >/dev/null || return 1
  else
    parent=$(dirname -- "$remote")
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(remote_cmd 'mkdir -p -- "$1"' "$parent")" </dev/null || return 1
  fi
  run_scp "$local_file" "$(scp_host):$(sftp_path "$remote")"
}

cmd_mcp() {
  local name='' add=0
  while (($#)); do
    case $1 in
      --add) add=1; shift ;;
      -*) usage_error "mcp: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "mcp: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "mcp: missing NAME"
  load "$name"
  if ((add)); then
    command -v claude >/dev/null || die "the claude command is not installed on this computer"
    local self
    self=$(readlink -f "$0")
    claude mcp add --scope user "$NAME" -- "$self" mcp "$NAME" ||
      die "claude mcp add failed (is there already a server named '$NAME'? see: claude mcp list)"
    say "Added. In Claude Code on this computer, the tools of VM '$NAME' are now available"
    say "(start a new Claude session; check with /mcp). Remove with: claude mcp remove $NAME --scope user"
    return 0
  fi
  command -v python3 >/dev/null || die "python3 is needed for the MCP server"
  VMFORAI_VERSION=$VERSION exec python3 -c "$MCP_PY" "$(readlink -f "$0")" "$NAME" "$C_OS" "$C_DIR"
}

MCP_PY=$(cat <<'PYTHON_END'
# The MCP server behind "vmforai mcp NAME": JSON-RPC over stdin/stdout.
import json, os, re, subprocess, sys, tempfile

VMFORAI, NAME, OS, DIR = sys.argv[1:5]
VERSION = os.environ.get("VMFORAI_VERSION", "")
LIMIT = 30000  # characters of command output returned to the model
info = {}


class ToolError(Exception):
    pass


def vmforai(args, timeout):
    # Own process group, so a timeout also stops the ssh under it.
    p = subprocess.Popen([VMFORAI, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        out, err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, 15)
        p.communicate()
        raise ToolError(f"timed out after {timeout} s")
    return subprocess.CompletedProcess(p.args, p.returncode, out, err)


def text(b):
    return b.decode("utf-8", errors="replace")


def vm_info():
    if not info:
        r = vmforai(["__mcp-info", NAME], 600)
        if r.returncode:
            raise ToolError(f"cannot reach VM {NAME}: {text(r.stderr or r.stdout).strip()} (try: vmforai doctor {NAME})")
        for line in text(r.stdout).splitlines():
            k, _, v = line.partition("=")
            info[k] = v
    return info


def remote_path(p):
    i = vm_info()
    win = i["os"] == "windows"
    if not p:
        raise ToolError("empty path")
    if (win and (re.match(r"^[A-Za-z]:[\\/]", p) or p.startswith("\\\\"))) or (not win and p.startswith("/")):
        return p
    base, rest = i["dir"], p
    if p == "~":
        return i["home"]
    if p.startswith("~/") or p.startswith("~\\"):
        base, rest = i["home"], p[2:]
    sep = "\\" if win else "/"
    if win:
        rest = rest.replace("/", "\\")
    return base.rstrip("/\\") + sep + rest


def shorten(s):
    if len(s) <= LIMIT:
        return s
    half = LIMIT // 2
    return s[:half] + f"\n... [{len(s) - LIMIT} characters cut] ...\n" + s[-half:]


def get(path):
    remote = remote_path(path)
    with tempfile.TemporaryDirectory() as d:
        local = os.path.join(d, "f")
        r = vmforai(["__mcp-get", NAME, remote, local], 600)
        if r.returncode or not os.path.exists(local):
            raise ToolError(f"cannot read {remote}: {text(r.stderr).strip() or 'not found'}")
        with open(local, "rb") as f:
            return remote, f.read()


def put(path, data):
    remote = remote_path(path)
    with tempfile.TemporaryDirectory() as d:
        local = os.path.join(d, "f")
        with open(local, "wb") as f:
            f.write(data)
        r = vmforai(["__mcp-put", NAME, local, remote], 600)
        if r.returncode:
            raise ToolError(f"cannot write {remote}: {text(r.stderr).strip()}")
    return remote


def run(a):
    command = a.get("command") or ""
    if not command.strip():
        raise ToolError("command is empty")
    timeout = max(1, min(int(a.get("timeout") or 120), 600))
    r = vmforai(["__mcp-run", NAME, vm_info()["dir"], command], timeout)
    if r.returncode == 255 and not r.stdout:
        raise ToolError(f"SSH to VM {NAME} failed: {text(r.stderr).strip()}")
    out = text(r.stdout)
    if r.stderr:
        out += ("\n" if out and not out.endswith("\n") else "") + "[stderr]\n" + text(r.stderr)
    out = shorten(out)
    return out + ("" if not out or out.endswith("\n") else "\n") + f"[exit code {r.returncode}]"


def read_file(a):
    remote, data = get(a.get("path", ""))
    lines = data.decode("utf-8-sig", errors="replace").splitlines()
    start = max(1, int(a.get("offset") or 1))
    count = max(1, int(a.get("limit") or 2000))
    part = lines[start - 1:start - 1 + count]
    body = "\n".join(f"{n:6}\t{line}" for n, line in enumerate(part, start))
    more = len(lines) - (start - 1 + len(part))
    if more > 0:
        body += f"\n... {more} more lines (use offset {start + len(part)})"
    return f"{remote} ({len(lines)} lines)\n" + (body or "(empty file)")


def write_file(a):
    content = a.get("content")
    if content is None:
        raise ToolError("content is missing")
    data = content.encode("utf-8")
    path = a.get("path", "")
    # Windows PowerShell 5.1 reads scripts without a BOM in the old ANSI code page.
    if (vm_info()["os"] == "windows" and path.lower().endswith((".ps1", ".psm1", ".psd1"))
            and not data.isascii() and not data.startswith(b"\xef\xbb\xbf")):
        data = b"\xef\xbb\xbf" + data
    remote = put(path, data)
    return f"Wrote {len(data)} bytes to {remote}"


def edit_file(a):
    old, new = a.get("old_string"), a.get("new_string")
    if not old:
        raise ToolError("old_string is empty")  # (a BOM at the start of the file is kept as it is)
    if new is None:
        raise ToolError("new_string is missing")
    remote, data = get(a.get("path", ""))
    try:
        s = data.decode("utf-8")
    except UnicodeDecodeError:
        raise ToolError(f"{remote} is not a UTF-8 text file")
    n = s.count(old)
    if n == 0 and "\r\n" in s and "\r\n" not in old:  # Windows line endings
        old, new = old.replace("\n", "\r\n"), new.replace("\n", "\r\n")
        n = s.count(old)
    if n == 0:
        raise ToolError(f"old_string not found in {remote}")
    if n > 1 and not a.get("replace_all"):
        raise ToolError(f"old_string occurs {n} times in {remote}; give more context or set replace_all")
    put(remote, s.replace(old, new).encode("utf-8"))
    return f"Edited {remote}: replaced {n if a.get('replace_all') else 1} occurrence(s)"


where = f"VM '{NAME}'" + (" (Windows: commands run in Windows PowerShell 5.1; any non-zero exit code is reported as 1)"
                         if OS == "windows" else " (Linux: commands run in bash)")
start_dir = DIR or "the home directory"
TOOLS = [
    {"name": "run", "handler": run,
     "description": f"Run a shell command inside {where}, in {start_dir}. Returns its output and exit code. "
                    "Starts the VM first if it is off. Use this for everything inside the VM: building, "
                    "testing, installing packages (sudo works without a password on VMs made by vmforai create).",
     "inputSchema": {"type": "object", "properties": {
         "command": {"type": "string", "description": "The command line to run"},
         "timeout": {"type": "integer", "description": "Seconds before it is stopped (default 120, max 600)"}},
         "required": ["command"]}},
    {"name": "read_file", "handler": read_file,
     "description": f"Read a text file inside {where}. Relative paths start in {start_dir}; ~ is the home "
                    "directory. Lines come numbered (number, tab, text).",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"},
         "offset": {"type": "integer", "description": "First line to show (1-based)"},
         "limit": {"type": "integer", "description": "Number of lines (default 2000)"}},
         "required": ["path"]}},
    {"name": "write_file", "handler": write_file,
     "description": f"Create or overwrite a file inside {where} with the given content. Missing folders are "
                    f"created. Relative paths start in {start_dir}.",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"}, "content": {"type": "string"}}, "required": ["path", "content"]}},
    {"name": "edit_file", "handler": edit_file,
     "description": f"Replace exact text in a file inside {where}. old_string must match the file exactly "
                    "(whitespace included) and occur once, unless replace_all is true.",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"}, "old_string": {"type": "string"}, "new_string": {"type": "string"},
         "replace_all": {"type": "boolean", "description": "Replace every occurrence"}},
         "required": ["path", "old_string", "new_string"]}},
]
HANDLERS = {t["name"]: t.pop("handler") for t in TOOLS}
INSTRUCTIONS = (f"These tools work inside the virtual machine '{NAME}' over SSH (vmforai). Use them, not the "
                f"local file and shell tools, whenever the task is about that VM. Paths and commands start in "
                f"{start_dir} on the VM.")


def reply(id_, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": id_}
    if error:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def handle(msg):
    method, id_, params = msg.get("method"), msg.get("id"), msg.get("params") or {}
    if id_ is None:
        return  # a notification
    if method == "initialize":
        reply(id_, {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": f"vmforai-{NAME}", "version": VERSION},
                    "instructions": INSTRUCTIONS})
    elif method == "ping":
        reply(id_, {})
    elif method == "tools/list":
        reply(id_, {"tools": TOOLS})
    elif method == "tools/call":
        handler = HANDLERS.get(params.get("name"))
        if not handler:
            reply(id_, error={"code": -32602, "message": f"unknown tool {params.get('name')}"})
            return
        try:
            reply(id_, {"content": [{"type": "text", "text": handler(params.get("arguments") or {})}], "isError": False})
        except ToolError as e:
            reply(id_, {"content": [{"type": "text", "text": str(e)}], "isError": True})
        except Exception as e:  # keep serving after a bug
            reply(id_, {"content": [{"type": "text", "text": f"internal error: {e!r}"}], "isError": True})
    else:
        reply(id_, error={"code": -32601, "message": f"method not found: {method}"})


for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        msg = json.loads(line)
    except ValueError:
        reply(None, error={"code": -32700, "message": "parse error"})
        continue
    for m in msg if isinstance(msg, list) else [msg]:
        handle(m)
PYTHON_END
)

# ------------------------------------------------------------------ snapshots

need_domain() { # WHAT
  [[ -n $C_DOMAIN ]] || die "$1 needs a libvirt VM; '$NAME' has no --domain"
  command -v virsh >/dev/null || die "virsh not found"
}

# The VM's snapshots, oldest first: NAME<TAB>DATE TIME<TAB>STATE
snapshot_rows() {
  vsh snapshot-list "$C_DOMAIN" 2>/dev/null |
    awk 'NR > 2 && NF >= 5 { print $1 "\t" $2 " " $3 "\t" $5 }' | sort -t $'\t' -k2,2 -k1,1
}

# Taken each time vmforai starts the VM from "shut off" (instant then, and
# without memory), so "vmforai undo" can return to before the session.
auto_snapshot() {
  local keep=${P[AUTOSNAP]:-3} snap out old
  ((keep > 0)) || return 0
  snap=auto-$(date +%Y%m%d-%H%M%S)
  if ! out=$(vsh snapshot-create-as "$C_DOMAIN" "$snap" --description "taken by vmforai before starting the VM" 2>&1); then
    warn "no automatic snapshot: ${out%%$'\n'*} (turn them off: $PROG autosnap $NAME off)"
    return 0
  fi
  info "Snapshot $snap taken (\"$PROG undo $NAME\" goes back to it)."
  while IFS= read -r old; do
    vsh snapshot-delete "$C_DOMAIN" "$old" >/dev/null 2>&1 || warn "could not delete old snapshot $old"
  done < <(snapshot_rows | awk -F '\t' -v keep="$keep" '$1 ~ /^auto-/ { s[n++] = $1 } END { for (i = 0; i < n - keep; i++) print s[i] }')
}

xml_escape() { local v=$1; v=${v//&/"&amp;"} v=${v//</"&lt;"} v=${v//>/"&gt;"}; printf '%s' "$v"; }

cmd_snapshot() {
  local name='' note='' del='' snap='' label='' relabel=0 out xml tmp
  while (($#)); do
    case $1 in
      --delete)
        (($# >= 2)) || usage_error "snapshot: --delete needs a snapshot name"
        del=$2; shift 2 ;;
      --name)
        (($# >= 2)) || usage_error "snapshot: --name needs a name"
        snap=$2; shift 2 ;;
      --label)
        (($# >= 3)) || usage_error "snapshot: --label needs a snapshot name and the label"
        snap=$2 label=$3 relabel=1; shift 3 ;;
      -*) usage_error "snapshot: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1; elif [[ -z $note ]]; then note=$1; else usage_error "snapshot: too many arguments"; fi
        shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "snapshot: missing NAME"
  load "$name"
  need_domain snapshot
  if [[ -n $del ]]; then
    out=$(vsh snapshot-delete "$C_DOMAIN" "$del" 2>&1) || die "libvirt: $out"
    say "Deleted snapshot $del."
    return 0
  fi
  [[ $label != *$'\n'* && $note != *$'\n'* ]] || die "a label is one line"
  if ((relabel)); then
    # The label is the snapshot's description: change it in its metadata.
    xml=$(vsh snapshot-dumpxml "$C_DOMAIN" "$snap" 2>&1) || die "libvirt: $xml"
    tmp=$(mktemp)
    D=$(xml_escape "$label") awk '
      /<domain[ >]/ { indomain = 1 }
      !indomain && /^ *<description>.*<\/description> *$/ { next }
      { print }
      !indomain && !added && /<\/name>/ { if (ENVIRON["D"] != "") print "  <description>" ENVIRON["D"] "</description>"; added = 1 }
    ' <<<"$xml" >"$tmp"
    out=$(vsh snapshot-create "$C_DOMAIN" "$tmp" --redefine 2>&1) || { rm -f "$tmp"; die "libvirt: $out"; }
    rm -f "$tmp"
    say "Snapshot $snap: ${label:-(no label)}"
    return 0
  fi
  if [[ -n $snap ]]; then
    [[ $snap =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "a snapshot name may have letters, digits, . _ and - only"
    [[ $snap != auto-* ]] || die "names starting with auto- are for automatic snapshots (they get deleted)"
    snapshot_rows | cut -f1 | grep -qxF -- "$snap" && die "$NAME already has a snapshot named $snap"
  else
    snap=snap-$(date +%Y%m%d-%H%M%S)
  fi
  [[ $(domstate) == running ]] && info "The VM is running: its memory is saved too, and it pauses for a moment..."
  out=$(vsh snapshot-create-as "$C_DOMAIN" "$snap" --description "${note:-taken with vmforai snapshot}" 2>&1) ||
    die "libvirt: $out"
  say "Snapshot $snap taken. Back to it later: $PROG undo $NAME $snap"
}

cmd_snapshots() {
  local json=0
  [[ ${2-} == --json ]] && { json=1; set -- "$1"; }
  [[ $# = 1 ]] || usage_error "snapshots: give one NAME"
  load "$1"
  need_domain snapshots
  local rows snap when state desc sep=''
  rows=$(snapshot_rows)
  if ((json)); then
    printf '['
    while IFS=$'\t' read -r snap when state; do
      [[ -n $snap ]] || continue
      desc=$(vsh snapshot-dumpxml "$C_DOMAIN" "$snap" 2>/dev/null | sed -n '/<domain[ >]/q; s:.*<description>\(.*\)</description>.*:\1:p' | head -n 1 | sed 's/&lt;/</g; s/&gt;/>/g; s/&amp;/\&/g')
      printf '%s\n {"name": %s, "time": %s, "state": %s, "description": %s}' "$sep" "$(json_str "$snap")" \
        "$(json_str "$when")" "$(json_str "$state")" "$(json_str "$desc")"
      sep=,
    done <<<"$rows"
    printf '\n]\n'
    return 0
  fi
  if [[ -z $rows ]]; then
    say "No snapshots of $NAME yet. One is taken each time vmforai starts the VM; or: $PROG snapshot $NAME"
    return 0
  fi
  while IFS=$'\t' read -r snap when state; do
    desc=$(vsh snapshot-dumpxml "$C_DOMAIN" "$snap" 2>/dev/null | sed -n '/<domain[ >]/q; s:.*<description>\(.*\)</description>.*:\1:p' | head -n 1 | sed 's/&lt;/</g; s/&gt;/>/g; s/&amp;/\&/g')
    [[ $state == shutoff ]] && state="VM off" || state="VM $state"
    printf '%-24s %s  %-11s %s\n' "$snap" "$when" "$state" "$desc"
  done <<<"$rows"
  say ""
  say "Go back to the newest: $PROG undo $NAME   (or name one: $PROG undo $NAME SNAPSHOT)"
}

cmd_undo() {
  local name='' snap='' yes=0 rows row when state a out
  while (($#)); do
    case $1 in
      -y | --yes) yes=1; shift ;;
      -*) usage_error "undo: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1; elif [[ -z $snap ]]; then snap=$1; else usage_error "undo: too many arguments"; fi
        shift ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "undo: missing NAME"
  load "$name"
  need_domain undo
  rows=$(snapshot_rows)
  [[ -n $rows ]] || die "no snapshots of $NAME yet. One is taken each time vmforai starts the VM; take one now: $PROG snapshot $NAME"
  if [[ -n $snap ]]; then
    row=$(awk -F '\t' -v s="$snap" '$1 == s' <<<"$rows")
    [[ -n $row ]] || die "no snapshot '$snap' of $NAME (see: $PROG snapshots $NAME)"
  else
    row=${rows##*$'\n'}
  fi
  IFS=$'\t' read -r snap when state <<<"$row"
  if ((!yes)); then
    [[ -t 0 ]] || die "undo: add --yes to confirm without a terminal"
    say "This puts VM $NAME back to snapshot $snap, taken $when."
    say "Everything changed in the VM since then is lost (files, installed programs, Claude's work)."
    read -r -p "Go back? [y/N] " a || a=
    [[ $a == [yY]* ]] || die "nothing changed"
  fi
  if [[ $state == shutoff && $(domstate) != "shut off" ]]; then
    info "Stopping VM $C_DOMAIN..."
    out=$(vsh destroy "$C_DOMAIN" 2>&1) || die "libvirt: $out"
  fi
  out=$(vsh snapshot-revert "$C_DOMAIN" "$snap" 2>&1) || die "libvirt: $out"
  rm -f "$(hooks_mark)"
  say "VM $NAME is back at $snap ($when)."
  [[ $state == shutoff ]] && say "Open Claude in it again: $PROG $NAME"
  return 0
}

cmd_autosnap() {
  [[ $# = 2 ]] || usage_error "autosnap: give NAME and on, off or a number"
  local n=$2
  case $n in on) n=3 ;; off) n=0 ;; esac
  [[ $n =~ ^[0-9]+$ ]] || usage_error "autosnap: say on, off or how many to keep"
  load "$1"
  need_domain autosnap
  P[AUTOSNAP]=$((10#$n))
  write_profile "$NAME"
  if ((P[AUTOSNAP])); then
    say "Automatic snapshots are on: one each time vmforai starts the VM, the newest ${P[AUTOSNAP]} are kept."
  else
    say "Automatic snapshots are off (existing ones stay; see: $PROG snapshots $NAME)."
  fi
}

