        self.load()

    @work(thread=True, exclusive=True, group="history")
    def load(self):
        rc, out, err = cli("history", self.vm["name"], "--json", timeout=600)
        try:
            sessions = json.loads(out) if rc == 0 else None
        except ValueError:
            sessions = None
        self.app.call_from_thread(self.show, sessions, err)

    def show(self, sessions, err=""):
        status = self.query_one("#histstatus", Static)
        options = self.query_one("#sessions", VimOptions)
        options.clear_options()
        if sessions is None:
            status.update(T("[red]Could not read the sessions of {n}[/]: {why}", n=self.vm["name"],
                            why=(err.strip().splitlines() or ["?"])[-1]))
            return
        self.sessions = sessions
        if not sessions:
            status.update(T("No Claude Code sessions on {n} yet.", n=self.vm["name"]))
            return
        status.update(T("[b]Claude's sessions on {n}[/b], newest first  [dim]j/k: move · r: go on with it · "
                        "g: refresh · Esc: the list[/]", n=self.vm["name"]))
        for s in sessions:
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(s["time"]))
            options.add_option(Option(f"{when}  [dim]{s['messages']:>3}[/]  {s['first'] or '-'}", id=s["id"]))
        options.highlighted = 0

    @on(OptionList.OptionHighlighted, "#sessions")
    def highlighted(self, e):
        self.read(e.option.id)

    @work(thread=True, exclusive=True, group="transcript")
    def read(self, sid):
        rc, out, err = cli("history", self.vm["name"], sid, timeout=600)
        self.app.call_from_thread(self.put, out if rc == 0 else err)

    def put(self, text):
        log = self.query_one("#transcript", DiffLog)
        log.clear()
        for line in text.splitlines():
            if line.startswith("Go on with it:"):
                continue
            log.write(Text(line, style="bold" if line.startswith("> ") else "cyan" if line.startswith("* ")
                           else ""))
        log.scroll_home(animate=False)

    @on(OptionList.OptionSelected, "#sessions")
    def action_resume(self, *_):
        options = self.query_one("#sessions", VimOptions)
        if options.highlighted is None or not self.sessions:
            return
        sid = self.sessions[options.highlighted]["id"]
        # Without tmux: a Claude already running in tmux there would not take --resume.
        self.app.open_session(self.vm["name"], "claude", [VMFORAI, self.vm["name"], "--hold", "--claude", "--no-tmux",
                                                          "--", "--resume", sid])


