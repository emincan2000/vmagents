printf '%s\n' "[Unit]" "Description=vmforai: power off after $m minutes without use" "" "[Service]" \
  "ExecStart=/bin/sh /usr/local/libexec/vmforai-idle $m" "Restart=always" "" "[Install]" "WantedBy=multi-user.target" |
  $su_ sh -c "cat >$unit" || exit 1
$su_ systemctl daemon-reload && $su_ systemctl enable vmforai-idle.service >/dev/null 2>&1 &&
  $su_ systemctl restart vmforai-idle.service || exit 1
