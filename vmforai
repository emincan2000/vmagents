    @while_open
    def log_line(self, text):
        self.main.query_one("#log", RichLog).write(text)

    # --- terminals inside the UI, one tab each
    def terminals(self, name=None):
        return [t for t in self.main.query(Terminal) if name is None or t.vm_name == name]

    def creating(self):
        return list(self.main.query(Creating))

    def open_session(self, name, kind, argv=None):
        """Shows the tab of KIND (shell, login or an AI assistant) on the VM
        NAME, opening it if needed; with no KIND, the VM's last tab. With
        ARGV, a new tab running that (a task: kind "run")."""
        vm = next((v for v in self.vms if v["name"] == name), {"name": name, "agent": "claude"})
        terms = self.terminals(name)
        if kind is None:
            if terms:
                last = self.pane(self.last) if self.last in self.pane_ids() else None
                self.show(last.id if last in terms else terms[-1].id)
            return
        if kind not in ("shell", "login", "claude", "run", "fix") and vm.get("os") == "windows":
            self.notify(T("Only Claude Code runs on Windows VMs."))
            return
        for t in terms:
            if t.kind == kind and t.rc is None and argv is None:
                self.show(t.id)
                return
        self.count += 1
        t = Terminal(argv or kind_command(name, kind), kind_label(kind), id=f"term-{self.count}")
        t.vm_name, t.kind = name, kind
        self.add_pane(t, f"{name} · {kind_label(kind)}")
        self._seen = None

    def action_open_kind(self, kind):
        w = self.pane(self.current_pane())
        if isinstance(w, Terminal):
            self.open_session(w.vm_name, kind)

    @on(Terminal.Exited)
    def exited(self, event):
        """A program ended: its tab closes (the VM's other tab, or the list, shows)."""
        t = event.terminal
        if self.current_pane() != t.id:
            self.close_pane(t.id)
            return
        others = [x for x in self.terminals(t.vm_name) if x is not t]
        self.close_pane(t.id, then=others[-1].id if others else "home")

    def back_to_list(self):
        self._seen = None
        if self.vms:
            self.show_vms(self.vms)

    # --- creating VMs, in a tab
    def start_create(self, v):
        self.count += 1
        c = Creating(v, id=f"create-{self.count}")
        self.add_pane(c, f"{v['name']} · {T('creating…')}")

    def create_finished(self, c):
        self.relabel()
        self.refresh_vms()
        if self.current_pane() != c.id:
            if c.rc == 0:
                self.notify(T("{n} is ready.", n=c.v["name"]))
            else:
                self.notify(T("Creating {n} failed.", n=c.v["name"]), severity="error")

    @work(thread=True)
    def background(self, args, done=None, name=None):
        """Runs vmforai without a terminal; its output goes to the log."""
        if name:
            self.busy.add(name)
            self.call_from_thread(self.refresh_vms)
        self.call_from_thread(self.log_line, "[b]$ vmforai " + shlex.join(args) + "[/b]")
        rc, out, err = cli(*args, timeout=3600)
        for line in (out + err).splitlines():
            if line.strip():
                self.call_from_thread(self.log_line, line)
        if rc != 0:
            self.call_from_thread(self.notify, T("vmforai {cmd} failed (exit code {rc})", cmd=args[0], rc=rc),
                                  severity="error")
        if name:
            self.busy.discard(name)
        if done:
            self.call_from_thread(done, rc)
        self.call_from_thread(self.refresh_vms)

    def need_vm(self, libvirt=False, busy_ok=False):
        vm = self.selected()
        if not vm:
            self.notify(T("No VM selected. Press n to make one."))
            return None
        if vm["name"] in self.busy and not busy_ok:
            self.notify(T("{n} is busy; wait a moment.", n=vm["name"]))
            return None
        if libvirt and not vm.get("domain"):
            self.notify(T("{n} is not a libvirt VM: vmforai cannot start, stop or snapshot it.", n=vm["name"]))
            return None
        return vm

    # --- actions
    def action_open(self):
        if not (vm := self.need_vm(busy_ok=True)):
            return
        if self.terminals(vm["name"]):  # back to what is open there
            self.open_session(vm["name"], None)
            return

        def chosen(kind):
            if kind:
                self.open_session(vm["name"], kind)
        self.push_screen(OpenAs(vm), chosen)

    def action_shell(self):
        if vm := self.need_vm(busy_ok=True):
            self.open_session(vm["name"], "shell")

    def action_project(self):
        if not (vm := self.need_vm()):
            return
        if vm.get("os") == "windows":
            self.notify(T("Projects work with Linux VMs only."))
            return
        n = vm["name"]

        def check(v):
            if not v["folder"]:
                return T("Give a folder.")
            if not git_top(v["folder"]):
                return T("{p} is not in a git repository.", p=v["folder"])
            return ""

        def sent(rc, args):
            if rc == 0:
                self.notify(T("Sent the project to {n}; agents start in it.", n=n))
            elif rc == 5:
                def discard(yes):
                    if yes:
                        self.background(args + ["--discard"], done=lambda rc: sent(rc, args), name=n)
                self.push_screen(Confirm(T("{n} has work on the project that was not taken back (c shows it; t there "
                                           "takes it). Send anyway? That work is set aside on the VM, not deleted.",
                                           n=n), yes=T("Send anyway"), danger=True), discard)

        def chosen(r):
            if r:
                args = ["project", n, os.path.expanduser(r["folder"])]
                self.background(args, done=lambda rc: sent(rc, args), name=n)
        self.push_screen(Ask(T("Send a git repository of this computer to {n}; the agents work on it there, and "
                               "what they do comes back as a branch (c). Sending again brings new commits over.", n=n),
                             [("folder", T("Folder"), home_short(vm.get("project") or HERE), "~/code/app")], check),
                         chosen)

    def action_changes(self):
        if not (vm := self.need_vm(busy_ok=True)):
            return
        if not vm.get("project"):
            self.notify(T("{n} has no project yet: p sends one.", n=vm["name"]))
            return
        for c in self.main.query(Changes):
            if c.vm["name"] == vm["name"]:
                c.vm = vm
                self.show(c.id)
                c.action_load()
                return
        self.count += 1
        self.add_pane(Changes(vm, id=f"changes-{self.count}"), f"{vm['name']} · {T('Changes')}")

    def action_task(self):
        """A task for an agent, done alone on the VM (vmforai run), followed in a tab."""
        if not (vm := self.need_vm(busy_ok=True)):
            return
        n = vm["name"]
        installed = vm.get("agents") or []
        default = vm.get("agent", "claude")
        options = [(k, label + ("   [dim](" + T("installs it first") + ")[/]" if installed and k not in installed else ""))
                   for k, label in sorted(AGENTS, key=lambda a: a[0] != default)]

        def chosen_agent(agent):
            if not agent:
                return

            def chosen_task(r):
                if r and r["task"].strip():
                    self.open_session(n, "run", [VMFORAI, "run", n, "--wait", "--hold", f"--{agent}", "--",
                                                 r["task"].strip()])
            where = vm.get("dir") or "~"
            self.push_screen(Ask(T("[b]Task for {agent} on {n}[/b]\nIt works alone, in {dir}, without asking (it is a "
                                   "VM: undo takes it back). Follow it in a tab; a dot marks the tab when it ends.",
                                   agent=AGENT_NAMES[agent], n=n, dir=where),
                                 [("task", T("Task"), "", T("e.g. make the failing tests pass"))],
                                 lambda v: "" if v["task"].strip() else T("Write the task.")), chosen_task)
        if vm.get("os") == "windows":  # only Claude Code there
            chosen_agent("claude")
            return
        self.push_screen(Pick(T("[b]Which agent[/b] does the task on {n}?", n=n), options), chosen_agent)

    def action_phone(self):
        self.push_screen(Phone())

    def action_fix(self):
        """A GitHub issue of the VM's project to a pull request (vmforai fix), followed in a tab."""
        if not (vm := self.need_vm(busy_ok=True)):
            return
        if vm.get("os") == "windows" or not vm.get("project"):
            self.notify(T("Send a project to {n} first (p): fix works on its GitHub issues.", n=vm["name"]))
            return
        n = vm["name"]

        def chosen(r):
            if not r:
                return
            argv = [VMFORAI, "fix", n, r["issue"].lstrip("#"), "--hold"]
            if r["test"]:
                argv += ["--test", r["test"]]
            if not r["pr"]:
                argv.append("--no-pr")
            self.open_session(n, "fix", argv)
        self.push_screen(Ask(T("[b]Fix an issue of {p}[/b]\nThe agent works on the GitHub issue on {n}, alone; then "
                               "the tests run there. When they pass, the work becomes a branch and a pull request. "
                               "Follow it in a tab.", p=home_short(vm["project"]), n=n),
                             [("issue", T("Issue"), "", T("its number, e.g. 42, or its URL")),
                              ("test", T("Test command"), vm.get("test") or "", T("e.g. npm test (empty: the agent's own)"))],
                             lambda v: "" if v["issue"].strip().lstrip("#") else T("Give the issue."),
                             [("pr", T("Open a pull request when the tests pass"), True)]), chosen)

    def action_history(self):
        if not (vm := self.need_vm(busy_ok=True)):
            return
        if vm.get("os") == "windows":
            self.notify(T("History works with Linux VMs only."))
            return
        for h in self.main.query(History):
            if h.vm["name"] == vm["name"]:
                self.show(h.id)
                h.action_load()
                return
        self.count += 1
        self.add_pane(History(vm, id=f"history-{self.count}"), f"{vm['name']} · {T('History')}")

    def action_try(self):
        """N copies of the VM, each doing the same task (vmforai try)."""
        if not (vm := self.need_vm(libvirt=True)):
            return
        n = vm["name"]
        if vm.get("try"):
            self.notify(T("{n} is a copy; make copies of {src}.", n=n, src=vm["try"]))
            return
        if not vm.get("created"):
            self.notify(T("Copies can be made of VMs made with vmforai only."))
            return
        copies = [v["name"] for v in self.vms if v.get("try") == n]
        if copies:
            def clean(yes):
                if yes:
                    self.background(["try", n, "--clean"], name=n)
            self.push_screen(Confirm(T("Delete the copies of {n} ({list}) with their disks? Branches you took from "
                                       "them stay.", n=n, list=", ".join(copies)), yes=T("Delete"), danger=True), clean)
            return
        host = (self.info or {}).get("host", {})
        free = host.get("memory_available_mb") or 0
        mem = vm.get("memory_mb") or 2048

        def check(v):
            if not v["count"].isdigit() or not 1 <= int(v["count"]) <= 9:
                return T("Copies: 1 to 9.")
            if not v["memory"].isdigit() or int(v["memory"]) < 512:
                return T("Memory: MB for each copy, at least 512.")
            if free and int(v["count"]) * int(v["memory"]) > free - 1024:
                return T("{c} copies of {m} MB do not fit: {free} MB are free here.", c=v["count"], m=v["memory"],
                         free=free)
            if not v["task"].strip():
                return T("Write the task.")
            return ""

        def chosen(r):
            if not r:
                return
            agents = [k for k, _ in AGENTS if r.get(f"agent-{k}")] or [vm.get("agent", "claude")]
            args = ["try", n, r["count"], "--memory", r["memory"], "--agents", ",".join(agents)]

            def go(stop):
                if stop is False:
                    return
                self.run_try(n, args + (["--stop"] if stop else []) + ["--", r["task"].strip()])
            if vm.get("state") == "running":
                self.push_screen(Confirm(T("{n} is running; its disk has to hold still while it is copied. Shut it "
                                           "down first?", n=n), yes=T("Shut down")), go)
            else:
                go(None)
        default = vm.get("agent", "claude")
        self.push_screen(Ask(T("[b]Try a task on copies of {n}[/b]\nEach copy does the same task alone, without "
                               "asking; the agents you check take turns. Then compare them (c on each) and take the "
                               "best (t). They shut down when done.", n=n),
                             [("count", T("Copies"), "2", "2"),
                              ("memory", T("Memory per copy, MB [dim]({free} MB free here)[/]", free=free),
                               str(min(mem, max(1024, (free - 1024) // 2 // 256 * 256))) if free else str(mem), ""),
                              ("task", T("Task"), "", T("e.g. make the start page load faster"))], check,
                             extra=[(f"agent-{k}", label, k == default) for k, label in AGENTS]), chosen)

    @work(thread=True)
    def run_try(self, name, args):
        self.busy.add(name)
        self.call_from_thread(self.refresh_vms)
        self.call_from_thread(self.log_line, "[b]$ vmforai " + shlex.join(args) + "[/b]")
        rc, out, err = cli(*args, timeout=3600)
        for line in (err + out).splitlines():
            if line.strip() and not line.startswith("Warning: Permanently added"):
                self.call_from_thread(self.log_line, line)
        self.busy.discard(name)
        self.call_from_thread(self.refresh_vms)
        if rc != 0:
            self.call_from_thread(self.notify, T("vmforai {cmd} failed (exit code {rc})", cmd="try", rc=rc),
                                  severity="error")
        # Follow each copy's task in a tab.
        for run_id, copy in re.findall(r"^Run (\d+) on (\S+?):", out, re.M):
            self.call_from_thread(self.open_session, copy, "run",
                                  [VMFORAI, "runs", copy, run_id, "-f", "--hold"])

    def action_net(self):
        if not (vm := self.need_vm(libvirt=True)):
            return
        n = vm["name"]
        if vm.get("os") == "windows":
            self.notify(T("The restricted network works with Linux VMs only."))
            return
        if vm.get("net") != "restricted":
            def sure(yes):
                if yes:
                    self.background(["net", n, "restricted"], name=n)
            self.push_screen(Confirm(T("Restrict the network of {n}? It then reaches only the hosts on its list (the "
                                       "agents' services, package registries, GitHub; you can add more), through a "
                                       "proxy on this computer. Enforced here, so nothing in the VM can get around "
                                       "it.", n=n), yes=T("Restrict")), sure)
            return
        blocked = refused(n)

        def chosen(what):
            if what == "allow":
                def add(r):
                    if r and r["host"].strip():
                        self.background(["net", n, "allow", *r["host"].split()], done=lambda rc: self.show_details())
                self.push_screen(Ask(T("Allow from {n} (a host, *.domain, or HOST:PORT; several with spaces):", n=n),
                                     [("host", "", blocked[0].removesuffix(":443") if blocked else "",
                                       "api.example.com")]), add)
            elif what == "list":
                self.background(["net", n])
            elif what == "open":
                self.background(["net", n, "open"], name=n)
        note = (T("Refused lately: {list}", list=", ".join(blocked[:8])) if blocked
                else T("Nothing refused lately."))
        self.push_screen(Pick(T("[b]Network of {n}[/b]: restricted", n=n),
                              [("allow", T("Allow a host")), ("list", T("Show the list (in the log below)")),
                               ("open", T("Open the network again"))], note=f"[dim]{note}[/]"), chosen)

    def action_yolo(self):
        if not (vm := self.need_vm()):
            return
        n = vm["name"]
        if vm.get("yolo"):
            self.background(["yolo", n, "off"])
            return

        def sure(yes):
            if yes:
                self.background(["yolo", n, "on"])
        self.push_screen(Confirm(T("Let the agents on {n} act without asking first? They run commands and change "
                                   "files on the VM freely. That stays in the VM, and \"undo\" (u) takes it back. "
                                   "An agent already running keeps its mode until it is started again.", n=n),
                                 yes=T("Yes, yolo")), sure)

    def action_new(self):
        self.push_screen(NewVM(self.info, [v["name"] for v in self.vms]))

    def action_toggle(self):
        if not (vm := self.need_vm(libvirt=True)):
            return
        if vm.get("state") == "running":
            self.background(["stop", vm["name"]], name=vm["name"])
        else:
            self.background(["start", vm["name"]], name=vm["name"])

    def action_snapshots(self):
        if vm := self.need_vm(libvirt=True):
            self.push_screen(Snapshots(vm))

    def action_resize(self):
        if not (vm := self.need_vm(libvirt=True)):
            return
        host = (self.info or {}).get("host", {})

        def chosen(r):
            if not r:
                return
            mem, cpus = r
            if mem == vm.get("memory_mb") and cpus == vm.get("cpus"):
                return
            self.background(["resize", vm["name"], "--memory", str(mem), "--cpus", str(cpus), "--stop"],
                            name=vm["name"])
        self.push_screen(Resize(vm, host), chosen)

    def action_ports(self):
        if not (vm := self.need_vm()):
            return
        n = vm["name"]
        if self.forwards.get(n):
            def stop(yes):
                if yes:
                    self.stop_forwards(n)
            descs = "\n".join(d for _, d in self.forwards[n])
            self.push_screen(Confirm(T("Forwarding now:\n{list}\n\nStop it?", list=descs), yes=T("Stop")), stop)
            return
        current = ",".join(map(str, vm.get("ports") or []))

        def check(v):
            if v["ports"] and not PORTS_RE.match(v["ports"].replace(" ", "")):
                return T("Ports like 3000,5173 (or HERE:VM, e.g. 9000:3000).")
            return ""

        def chosen(r):
            if not r:
                return
            v = r["ports"].replace(" ", "")
            if r.get("save") and ":" not in v:
                self.background(["ports", n, v or "off"])
            if v and r.get("now"):
                self.start_forward(n, v.split(","), r.get("lan"), r.get("browser"))
        self.push_screen(Ask(
            T("Ports of {n} to reach from this computer (a web server the agent started, for example):", n=n),
            [("ports", "", current, "3000,5173")], check,
            extra=[("now", T("Forward them now"), True), ("browser", T("Open them in the browser"), True),
                   ("lan", T("Also reachable from other devices on my network"), False),
                   ("save", T("Forward them every time I connect"), bool(current))]), chosen)

    def start_forward(self, name, ports, lan, browser):
        args = ["open", name, *ports, "--keep"] + ([] if browser else ["--no-browser"]) + (["--lan"] if lan else [])
        self.log_line("[b]$ vmforai " + shlex.join(args) + "[/b]")
        try:
            p = subprocess.Popen([VMFORAI, *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 stdin=subprocess.DEVNULL, text=True, bufsize=1, start_new_session=True)
        except OSError as e:
            self.notify(str(e), severity="error")
            return
        self.forwards.setdefault(name, [])

        def read():
            for line in p.stdout:
                line = line.rstrip()
                if not line:
                    continue
                self.call_from_thread(self.log_line, line)
                m = re.match(r"Port (\d+) of \S+: (http://\S+)", line)
                if m:
                    self.call_from_thread(self.add_forward, name, p, T("port {p} at {url}", p=m.group(1),
                                                                       url=m.group(2)))
            rc = p.wait()
            self.call_from_thread(self.forward_ended, name, p, rc)
        threading.Thread(target=read, daemon=True).start()

    def add_forward(self, name, p, desc):
        self.forwards.setdefault(name, []).append((p, desc))
        self.show_details()

    def forward_ended(self, name, p, rc):
        had = [f for f in self.forwards.get(name, []) if f[0] is p]
        self.forwards[name] = [f for f in self.forwards.get(name, []) if f[0] is not p]
        if not had and rc not in (0, 130, -2):
            self.notify(T("Forwarding ports of {n} failed; see the log.", n=name), severity="error")
        self.show_details()

    def stop_forwards(self, name=None):
        for n in [name] if name else list(self.forwards):
            for p in {id(p): p for p, _ in self.forwards.get(n, [])}.values():
                if p is not None and p.poll() is None:
                    p.send_signal(signal.SIGINT)
            self.forwards[n] = []
        self.show_details()

    def action_delete(self):
        if not (vm := self.need_vm()):
            return
        n = vm["name"]
        if not vm.get("created"):
            def rm(yes):
                if yes:
                    self.background(["rm", n])
            self.push_screen(Confirm(T("{n} was not made by vmforai, so only its profile can be removed (the VM "
                                       "stays as it is). Remove the profile?", n=n), yes=T("Remove")), rm)
            return

        def sure(yes):
            if yes:
                self.stop_forwards(n)
                self.background(["delete", n, "--yes"], name=n)
        self.push_screen(TypeName(T("[b]Delete {n}[/b] with its disk and snapshots? This cannot be undone.\nType its "
                                    "name to confirm:", n=n), n), sure)

    def action_quit(self):
        count = len(self.terminals())
        making = [c for c in self.creating() if c.running()]
        if not count and not making:
            self.stop_forwards()
            self.exit()
            return

        def sure(yes):
            if yes:
                for t in self.terminals():
                    t.close()
                for c in making:
                    c.cancel()
                self.stop_forwards()
                self.exit()
        text = []
        if count:
            text.append(T("{count} terminal(s) are open. Quit closes them (agents in tmux keep running on the VM).",
                          count=count))
        if making:
            text.append(T("{n} is still being created; quitting stops that.", n=", ".join(c.v["name"] for c in making)))
        self.push_screen(Confirm("\n\n".join(text), yes=T("Quit")), sure)

def kitty_var(on):
