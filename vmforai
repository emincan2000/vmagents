         lambda r, c: r * c % 2 + r * c % 3 == 0, lambda r, c: (r * c % 2 + r * c % 3) % 2 == 0,
         lambda r, c: ((r + c) % 2 + r * c % 3) % 2 == 0]


def matrix(text, mask=None):
    """The QR code of text as rows of 0/1 (1: dark), without the quiet zone."""
    ver, cw = codewords(text.encode())
    n = 17 + 4 * ver
    m = [[0] * n for _ in range(n)]
    fn = [[False] * n for _ in range(n)]

    def put(r, c, v):
        m[r][c] = v
        fn[r][c] = True

    for r0, c0 in ((0, 0), (0, n - 7), (n - 7, 0)):
        for r in range(-1, 8):
            for c in range(-1, 8):
                if 0 <= r0 + r < n and 0 <= c0 + c < n:
                    d = max(abs(r - 3), abs(c - 3))
                    put(r0 + r, c0 + c, int(d != 2 and d != 4))
    for i in range(8, n - 8):
        put(6, i, int(i % 2 == 0))
        put(i, 6, int(i % 2 == 0))
    al = ALIGN.get(ver, [])
    for r in al:
        for c in al:
            if (r == 6 and c == 6) or (r == 6 and c == al[-1]) or (r == al[-1] and c == 6):
                continue  # the finders' corners
            for dr in range(-2, 3):
                for dc in range(-2, 3):
                    put(r + dr, c + dc, int(max(abs(dr), abs(dc)) != 1))
    for i in range(9):  # format information, written per mask below
        for r, c in ((8, i), (i, 8)):
            if not fn[r][c]:
                put(r, c, 0)
    for i in range(8):
        put(8, n - 1 - i, 0)
        put(n - 1 - i, 8, 0)
    put(n - 8, 8, 1)  # the dark module
    if ver >= 7:
        v = bch(ver, 0x1F25, 12)
        for i in range(18):
            b = (v >> i) & 1
            put(n - 11 + i % 3, i // 3, b)
            put(i // 3, n - 11 + i % 3, b)
    bits = [(c >> (7 - i)) & 1 for c in cw for i in range(8)]
    bits += [0] * (7 if 2 <= ver <= 6 else 0)
    k, up = 0, True
    c = n - 1
    while c > 0:
        if c == 6:
            c -= 1
        for i in range(n):
            r = n - 1 - i if up else i
            for cc in (c, c - 1):
                if not fn[r][cc]:
                    m[r][cc] = bits[k] if k < len(bits) else 0
                    k += 1
        up = not up
        c -= 2

    def masked(p):
        out = [row[:] for row in m]
        for r in range(n):
            for cc in range(n):
                if not fn[r][cc] and MASKS[p](r, cc):
                    out[r][cc] ^= 1
        f = bch((0 << 3) | p, 0x537, 10) ^ 0x5412  # level M: 00
        for i in range(15):
            b = (f >> i) & 1
            r, cc = (i, 8) if i < 6 else (7, 8) if i == 6 else (8, 8) if i == 7 else (8, 7) if i == 8 else (8, 14 - i)
            out[r][cc] = b
            r, cc = (8, n - 1 - i) if i < 8 else (n - 15 + i, 8)
            out[r][cc] = b
        return out

    def penalty(g):
        s = 0
        for lines in (g, list(zip(*g))):
            for row in lines:
                run, prev = 0, None
                for v in row:
                    if v == prev:
                        run += 1
                    else:
                        if run >= 5:
