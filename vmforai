  if [[ $C_OS == windows ]]; then
    win_run "$(win_idle_ps "$1")"
  else
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$IDLE_INSTALL_SH" "$1" "$IDLE_LOOP_SH")"
  fi
}

cmd_idle() {
