# Starts Claude and waits for it. Claude Code on Windows can hang after you
# quit it under OpenSSH's ConPTY: it puts the console back into line mode but
# never exits. Raw (VT) input first, then line mode for 2 s, means it is done.
# shellcheck disable=SC2016
WIN_INVOKE_PS='function Invoke-Claude($exe, $line, $dir) {
  $tf = "$env:USERPROFILE\.config\vmforai\claude-env"
  if (Test-Path -LiteralPath $tf) {
    foreach ($l in Get-Content -LiteralPath $tf) {
      if ($l -match "^(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=(\S+)$") { Set-Item "env:$($Matches[1])" $Matches[2] }
    }
  }
  if (-not ("Vmforai.Con" -as [type])) {
    Add-Type -Namespace Vmforai -Name Con -MemberDefinition ("[DllImport(`"kernel32.dll`")] public static extern IntPtr GetStdHandle(int n);" +
      "[DllImport(`"kernel32.dll`")] public static extern bool GetConsoleMode(IntPtr h, out uint m);")
  }
  $si = New-Object System.Diagnostics.ProcessStartInfo $exe, $line
  $si.UseShellExecute = $false
  $si.WorkingDirectory = $dir
  $p = [System.Diagnostics.Process]::Start($si)
  $h = [Vmforai.Con]::GetStdHandle(-10)
  $raw = $false
  $since = $null
  while (-not $p.WaitForExit(250)) {
    $m = [uint32]0
    if (-not [Vmforai.Con]::GetConsoleMode($h, [ref]$m)) { continue }
    if ($m -band 0x200) { $raw = $true; $since = $null }
    elseif ($raw -and ($m -band 2)) {
      if (-not $since) { $since = Get-Date }
      elseif (((Get-Date) - $since).TotalSeconds -ge 2) { $p.Kill(); $p.WaitForExit(); return 0 }
    }
  }
  $p.ExitCode
}
'

