class Ask(ModalScreen):
    """A few text fields (and checkboxes); returns their values or None."""
    BINDINGS = [Binding("escape", "dismiss(None)", show=False)]

    def __init__(self, title, fields, check=None, extra=None):
        super().__init__()
        self.title_text, self.fields, self.check, self.extra = title, fields, check, extra or []

    def compose(self):
        with Vertical(classes="dialog"):
            yield Static(self.title_text)
            for key, label, value, placeholder in self.fields:
                if label:
                    yield Label(label)
                yield Input(value, placeholder=placeholder, id=f"f-{key}")
            yield Static("", id="error", classes="error")
            for key, label, value in self.extra:
                yield Checkbox(label, value, id=key)
            with Horizontal(classes="buttons"):
                yield Button(T("OK"), id="ok", variant="primary")
                yield Button(T("Cancel"), id="no")

    def result(self):
        values = {key: self.query_one(f"#f-{key}", Input).value.strip() for key, _, _, _ in self.fields}
        if self.check and (err := self.check(values)):
            self.query_one("#error", Static).update(err)
            return
        values.update({key: self.query_one(f"#{key}", Checkbox).value for key, _, _ in self.extra})
        self.dismiss(values)

    @on(Input.Submitted)
    def submitted(self):
        self.result()

    @on(Button.Pressed)
    def pressed(self, e):
        if e.button.id == "ok":
            self.result()
        else:
            self.dismiss(None)


class Resize(ModalScreen):
    BINDINGS = [Binding("escape", "dismiss(None)", show=False)]

    def __init__(self, vm, host):
        super().__init__()
        self.vm, self.host = vm, host

    def compose(self):
        total = self.host.get("memory_mb") or 65536
        mem = self.vm.get("memory_mb") or 4096
        sizes = sorted({m for m in MEMORY_MB if m <= total} | {mem})
        with Vertical(classes="dialog"):
            yield Static(T("[b]Resources of {n}[/b]\nThis computer: {ram} RAM, {cpus} CPUs. The VM has to be off; "
                           "it is shut down first.", n=self.vm["name"], ram=gb(total), cpus=self.host.get("cpus", "?")))
            yield Label(T("RAM"))
            yield Select([(gb(m), m) for m in sizes], value=mem, allow_blank=False, id="memory")
            yield Label(T("CPUs"))
            n = self.host.get("cpus") or 8
            yield Select([(str(c), c) for c in range(1, n + 1)], value=min(self.vm.get("cpus") or 2, n),
                         allow_blank=False, id="cpus")
            with Horizontal(classes="buttons"):
                yield Button(T("Apply"), id="ok", variant="primary")
                yield Button(T("Cancel"), id="no")

    @on(Button.Pressed)
    def pressed(self, e):
        if e.button.id != "ok":
            self.dismiss(None)
            return
        self.dismiss((self.query_one("#memory", Select).value, self.query_one("#cpus", Select).value))


