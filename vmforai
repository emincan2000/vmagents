# ------------------------------------------------------------------ commands

cmd_add() {
  local name='' k v created=0
  declare -A opts=()
  while (($#)); do
    case $1 in
      --host | --user | --port | --key | --domain | --uri | --dir | --session | --os)
        (($# >= 2)) || usage_error "add: $1 needs a value"
        case $1 in
          --key) k=IDENTITY ;;
          --uri) k=LIBVIRT_URI ;;
          *) k=${1#--}; k=${k^^} ;;
        esac
        opts[$k]=$2; shift 2 ;;
      --no-tmux) opts[SESSION]=; shift ;;
      -*) usage_error "add: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "add: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "add: missing NAME"
  valid_name "$name" || die "invalid profile name: $name (letters, digits, . _ - only)"
  for k in "${!opts[@]}"; do
    v=${opts[$k]}
    [[ -z $v && $k != SESSION ]] || check_value "$k" "$v"
  done
  if profile_exists "$name"; then read_profile "$name"; else P=(); created=1; fi
  for k in "${!opts[@]}"; do
    if [[ -z ${opts[$k]} && $k != SESSION ]]; then unset "P[$k]"; else P[$k]=${opts[$k]}; fi
  done
  [[ -n ${P[HOST]:-} || -n ${P[DOMAIN]:-} ]] || die "add: give --host, --domain, or both"
  write_profile "$name"
  if ((created)); then say "Added VM '$name'. Next: $PROG setup $name"; else say "Updated VM '$name'."; fi
}

json_str() {
  local v=$1
  v=${v//\\/\\\\} v=${v//\"/\\\"} v=${v//$'\t'/\\t} v=${v//$'\n'/\\n} v=${v//$'\r'/\\r}
  printf '"%s"' "$v"
}
json_list() { # a,b -> ["a", "b"]; NUM: numbers
  local out='' x
  for x in ${1//,/ }; do
    if [[ ${2-} == NUM ]]; then out+="${out:+, }$((10#$x))"; else out+="${out:+, }$(json_str "$x")"; fi
  done
  printf '[%s]' "$out"
}
json_bool() { [[ $1 == on || $1 == 1 || $1 == true ]] && printf true || printf false; }

# One JSON object per profile, for the UI and scripts.
list_json() {
  local names name def sep='' state mem cpus snaps uri info stats cpu_ns rss
  names=$(profile_names)
  def=$(default_name || true)
  printf '['
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    read_profile "$name"
    state=null mem=null cpus=null snaps=null cpu_ns=null rss=null
    uri=${P[LIBVIRT_URI]:-qemu:///system}
    if [[ -n ${P[DOMAIN]:-} ]] && command -v virsh >/dev/null; then
      if info=$(timeout 5 virsh -c "$uri" dominfo "${P[DOMAIN]}" 2>/dev/null); then
        state=$(json_str "$(awk -F': *' '$1 == "State" { print $2 }' <<<"$info")")
        mem=$(awk '/^Max memory:/ { printf "%d", $3 / 1024 }' <<<"$info")
        cpus=$(awk '/^CPU\(s\):/ { print $2 }' <<<"$info")
        snaps=$(timeout 5 virsh -c "$uri" snapshot-list "${P[DOMAIN]}" --name 2>/dev/null | grep -c .) || snaps=0
        # How busy it is: CPU time used so far (the UI makes a percentage
        # of two readings) and the memory it takes on this computer.
        if [[ $state == '"running"' ]] &&
          stats=$(timeout 5 virsh -c "$uri" domstats --cpu-total --balloon "${P[DOMAIN]}" 2>/dev/null); then
          cpu_ns=$(sed -n 's/^ *cpu\.time=\([0-9]*\)$/\1/p' <<<"$stats")
          rss=$(awk -F= '/^ *balloon\.rss=/ { printf "%d", $2 / 1024 }' <<<"$stats")
        fi
      else
        state='"missing"'
      fi
    fi
    printf '%s\n {"name": %s, "default": %s, "host": %s, "user": %s, "port": %d, "domain": %s, "uri": %s, ' \
      "$sep" "$(json_str "$name")" "$([[ $name == "$def" ]] && echo true || echo false)" "$(json_str "${P[HOST]:-}")" \
      "$(json_str "${P[USER]:-$(id -un)}")" "$((10#${P[PORT]:-22}))" "$(json_str "${P[DOMAIN]:-}")" "$(json_str "$uri")"
    printf '"os": %s, "dir": %s, "session": %s, "agent": %s, "agents": %s, "ports": %s, ' \
      "$(json_str "${P[OS]:-}")" "$(json_str "${P[DIR]:-}")" "$(json_str "${P[SESSION]-claude}")" \
      "$(json_str "${P[AGENT]:-claude}")" "$(json_list "${P[AGENTS]:-}")" "$(json_list "${P[PORTS]:-}" NUM)"
    printf '"project": %s, "test": %s, "yolo": %s, "try": %s, "net": %s, ' "$(json_str "${P[PROJECT]:-}")" \
      "$(json_str "${P[TEST]:-}")" "$(json_bool "${P[YOLO]:-off}")" "$(json_str "${P[TRY]:-}")" \
      "$(json_str "${P[NET]:-open}")"
    printf '"autostop": %s, "notify": %s, "clipboard": %s, "idle": %d, "autosnap": %d, "created": %s, ' \
      "$(json_bool "${P[AUTOSTOP]:-on}")" "$(json_bool "${P[NOTIFY]:-on}")" "$(json_bool "${P[CLIPBOARD]:-on}")" \
      "$((10#${P[IDLE]:-0}))" "$((10#${P[AUTOSNAP]:-3}))" "$(json_bool "${P[CREATED]:-0}")"
    printf '"state": %s, "memory_mb": %s, "cpus": %s, "snapshots": %s, "cpu_ns": %s, "rss_mb": %s}' "$state" \
      "${mem:-null}" "${cpus:-null}" "$snaps" "${cpu_ns:-null}" "${rss:-null}"
    sep=,
  done <<<"$names"
  printf '\n]\n'
}

cmd_list() {
  if [[ ${1-} == --json ]]; then list_json; return; fi
  (($# == 0)) || usage_error "list: unknown argument $1"
  local names name def target state
  names=$(profile_names)
  if [[ -z $names ]]; then say "No VMs yet. Add one: $PROG add NAME --host IP  (or --domain LIBVIRT_DOMAIN)"; return 0; fi
  def=$(default_name || true)
  while IFS= read -r name; do
    read_profile "$name"
    target=${P[USER]:-$(id -un)}@${P[HOST]:-"(auto)"}
    [[ ${P[PORT]:-22} != 22 ]] && target+=":${P[PORT]}"
    if [[ -n ${P[DOMAIN]:-} ]]; then
      target+="  libvirt:${P[DOMAIN]}"
      if command -v virsh >/dev/null; then
        state=$(timeout 5 virsh -c "${P[LIBVIRT_URI]:-qemu:///system}" domstate "${P[DOMAIN]}" 2>/dev/null) || state=
        state=${state%%$'\n'*}
        [[ -n $state ]] && target+=" ($state)"
      fi
    fi
    [[ ${P[OS]:-} == windows ]] && target+="  (Windows)"
    printf '%s %-16s %s\n' "$([[ $name == "$def" ]] && echo '*' || echo ' ')" "$name" "$target"
  done <<<"$names"
}

