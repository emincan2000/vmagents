# ------------------------------------------------------------------ notifications

# Shows "Claude needs you" messages from the VM as desktop notifications.
# Runs in the background while Claude runs on the VM, also after you detach.
cmd___watch() {
  load "$1"
  command -v flock >/dev/null || return 0
  local lock
  lock=${XDG_RUNTIME_DIR:-/tmp}/vmforai-watch-$(id -u)-$NAME.lock
  exec 9>>"$lock"
  flock -n 9 || return 0  # one watcher per VM
  if [[ -n $C_DOMAIN ]]; then
    [[ $(domstate) == running ]] || return 0
    if [[ -n $C_HOST ]]; then TARGET=$C_HOST; else find_ip || return 0; TARGET=$FOUND_IP; fi
  else
    TARGET=$C_HOST
  fi
  build_ssh_opts
  local last='' fails=0 gone=0 out id dir msg first=1 cmd
  while :; do
    ((first)) || sleep "${VMFORAI_WATCH_INTERVAL:-15}"
    first=0
    if [[ -n $C_DOMAIN && $(domstate) != running ]]; then return 0; fi
    if [[ $C_OS == windows ]]; then
      cmd=$(win_cmd "$(win_watch_ps "$last")")
    else
      cmd=$(remote_cmd "$WATCH_SH" "$last")
    fi
    out=$(run_ssh -o BatchMode=yes -T -- "$TARGET" "$cmd" </dev/null 2>/dev/null) || out=''
    out=${out//$'\r'/}
    if [[ $out != claude=* ]]; then
      ((++fails < 20)) || return 0
      continue
    fi
    fails=0
    [[ -n $last ]] || last=$(sed -n 's/^now=//p' <<<"$out")
    while IFS=$'\t' read -r id dir msg; do
      [[ $id =~ ^[0-9]+$ ]] || continue
      last=$id
      notify_all "Claude Code ($NAME)" "${dir:+$dir: }$msg" waiting
    done <<<"$out"
    if [[ $out == claude=0* ]]; then ((++gone < 2)) || return 0; else gone=0; fi
  done
}

start_watcher() {
  [[ ${P[NOTIFY]:-on} == on ]] && command -v flock >/dev/null || return 0
  desktop_notes || ntfy_conf || return 0
  local self
  self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
  if command -v setsid >/dev/null; then
    setsid -f "$self" __watch "$NAME" </dev/null >/dev/null 2>&1 || true
  else
    nohup "$self" __watch "$NAME" </dev/null >/dev/null 2>&1 &
  fi
}

# ------------------------------------------------------------------ clipboard
# What you copy in Claude's tmux session on a Linux VM lands in this
# computer's clipboard: a second SSH session runs CLIP_SH while connect runs.

clip_put() { # stdin -> this computer's clipboard
  if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null; then wl-copy
  elif [[ -n ${DISPLAY:-} ]] && command -v xclip >/dev/null; then xclip -selection clipboard -in
  elif [[ -n ${DISPLAY:-} ]] && command -v xsel >/dev/null; then xsel --clipboard --input
  elif [[ $(uname -s) == Darwin ]] && command -v pbcopy >/dev/null; then pbcopy
  else return 1
  fi >/dev/null 2>&1
}

clip_ok() {
  [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null && return 0
  [[ -n ${DISPLAY:-} ]] && { command -v xclip >/dev/null || command -v xsel >/dev/null; } && return 0
  [[ $(uname -s) == Darwin ]] && command -v pbcopy >/dev/null
}

clip_copy() { # reads CLIP_SH's lines
  local line
  while IFS= read -r line; do
    line=${line%$'\r'}
    [[ -n $line && $line =~ ^[A-Za-z0-9+/]+=*$ ]] || continue
    base64 -d <<<"$line" 2>/dev/null | clip_put || true
  done
}

CLIP_PID=
start_clip() {
  CLIP_PID=
  [[ $C_OS == linux && -n $C_SESSION && ${P[CLIPBOARD]:-on} == on ]] || return 0
  clip_ok || return 0
  ssh "${SSH_OPTS[@]}" -o BatchMode=yes -T -- "$TARGET" "$(remote_cmd "$CLIP_SH")" </dev/null 2>/dev/null > >(clip_copy) &
  CLIP_PID=$!
}

stop_clip() {
  [[ -n $CLIP_PID ]] || return 0
  kill "$CLIP_PID" 2>/dev/null || true
  wait "$CLIP_PID" 2>/dev/null || true
  CLIP_PID=
}

cmd_clipboard() {
  [[ $# = 2 ]] || usage_error "clipboard: give NAME and on|off"
  local mode=$2
  [[ $mode == on || $mode == off ]] || usage_error "clipboard: say on or off"
  load "$1"
  P[CLIPBOARD]=$mode
  write_profile "$NAME"
  if [[ $mode == off ]]; then
    say "Clipboard sharing is off."
    return 0
  fi
  say "Clipboard sharing is on: what you copy in Claude's tmux session lands in this computer's clipboard."
  [[ $C_OS == windows ]] && say "(Not for Windows VMs: they have no tmux.)"
  clip_ok || say "Needs xclip or xsel (X11) or wl-copy (Wayland) here, e.g.: sudo apt install xclip"
  return 0
}

cmd_notify() {
  [[ $# = 2 ]] || usage_error "notify: give NAME and on|off"
  local mode=$2
  [[ $mode == on || $mode == off ]] || usage_error "notify: say on or off"
  load "$1"
  P[NOTIFY]=$mode
  write_profile "$NAME"
  if [[ $mode == off ]]; then
    say "Notifications are off."
    return 0
  fi
  say "Notifications are on: when Claude on the VM needs you, a desktop notification appears here."
  say "(On the phone too: $PROG phone notify)"
  command -v notify-send >/dev/null || say "Install notify-send first (Debian/Ubuntu: sudo apt install libnotify-bin)."
  return 0
}

# ------------------------------------------------------------------ open (port forwarding)

# True when nothing listens on 127.0.0.1:PORT here.
port_free() { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

open_url() { # URL
  local o
  for o in xdg-open open; do
    if command -v "$o" >/dev/null; then
      "$o" "$1" </dev/null >/dev/null 2>&1 &
      return 0
    fi
  done
  return 1
}

cmd_ports() {
  (($# >= 1 && $# <= 2)) || usage_error "ports: give NAME and a list of ports (e.g. 3000,5173) or off"
  load "$1"
  if (($# == 1)); then
    say "${P[PORTS]:-none}"
    return 0
  fi
  local v=${2// /}
  if [[ $v == off || $v == none ]]; then
    unset 'P[PORTS]'
    write_profile "$NAME"
    say "No ports are forwarded when you connect to $NAME."
    return 0
  fi
  port_list_ok "$v" || usage_error "ports: give ports like 3000,5173 (or off)"
  P[PORTS]=$v
  write_profile "$NAME"
  say "While you are connected to $NAME, these ports of the VM are ports here too: ${v//,/, }"
  say "Without Claude: $PROG open $NAME"
}

cmd_open() {
  local name='' browser=1 keep=0 lan=0 bind=127.0.0.1 a l r i pid rc=0 ip=''
  local -a specs=() locals=() fwd=()
  while (($#)); do
    a=$1; shift
    case $a in
      --no-browser) browser=0 ;;
      --keep) keep=1 ;;
      --lan) lan=1; bind=0.0.0.0 ;;
      -*) usage_error "open: unknown option $a" ;;
      *)
        if [[ -z $name ]] && profile_exists "$a"; then name=$a
        elif [[ $a =~ ^([0-9]+:)?[0-9]+$ ]]; then specs+=("$a")
        elif [[ -z $name ]]; then die "no VM profile named '$a' (see: $PROG list)"
        else usage_error "open: not a port: $a"
        fi ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "open: several VMs and no default; name one"
  if ((${#specs[@]} == 0)); then
    read_profile "$name"
    [[ -n ${P[PORTS]:-} ]] || usage_error "open: give the VM's port, e.g. $PROG open $name 3000 (or set some: $PROG ports $name 3000)"
    for a in ${P[PORTS]//,/ }; do specs+=("$a"); done
  fi
  for a in "${specs[@]}"; do
    r=$((10#${a##*:})) l=''
    [[ $a == *:* ]] && l=$((10#${a%%:*}))
    ((r >= 1 && r <= 65535 && ${l:-1} >= 1 && ${l:-1} <= 65535)) || die "invalid port: $a"
    if [[ -n $l ]]; then
      port_free "$l" || die "port $l is already in use on this computer; pick another: $PROG open $name OTHER:$r"
    else
      # The same port here when it is free, else the next free one.
      for ((i = r; i < r + 100 && i <= 65535; i++)); do
        [[ " ${locals[*]} " == *" $i "* ]] && continue
        port_free "$i" && { l=$i; break; }
      done
      [[ -n $l ]] || die "no free port near $r on this computer"
    fi
    locals+=("$l")
    fwd+=(-L "$bind:$l:localhost:$r")
  done
  load "$name"
  resolve_target
  build_ssh_opts
  # LogLevel=ERROR: no "open failed" line each time the VM's port is closed.
  ssh "${SSH_OPTS[@]}" -N -o ExitOnForwardFailure=yes -o LogLevel=ERROR "${fwd[@]}" -- "$TARGET" </dev/null &
  pid=$!
  trap 'kill "$pid" 2>/dev/null' INT TERM HUP
  for ((i = 0; i < 300; i++)); do
    kill -0 "$pid" 2>/dev/null || break
    port_free "${locals[-1]}" || break
    sleep 0.1
  done
  if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" || rc=$?
    trap - INT TERM HUP
    die "could not forward the port (SSH exit code $rc). Try: $PROG doctor $NAME"
  fi
  if ((lan)); then
    ip=$(hostname -I 2>/dev/null | awk '{ print $1 }') || true
  fi
  for i in "${!specs[@]}"; do
    l=${locals[i]} r=$((10#${specs[i]##*:}))
    if [[ $l == "$r" ]]; then say "Port $r of $NAME: http://localhost:$l"
    else say "Port $r of $NAME: http://localhost:$l (port $r is taken here)"
    fi
    ((lan)) && say "  on your network too: http://${ip:-THIS-COMPUTER}:$l"
    ((browser)) && { open_url "http://localhost:$l" || ((i)) || info "No browser opener (xdg-open) found; open the address yourself."; }
  done
  say "Stop with Ctrl-C."
  wait "$pid" || rc=$?
  wait "$pid" 2>/dev/null || true  # once more after Ctrl-C
  trap - INT TERM HUP
  ((rc == 0 || rc >= 128)) || info "$PROG: the connection to $NAME ended (SSH exit code $rc)."
  ((keep)) || autostop
  return 0
}

# ------------------------------------------------------------------ projects

# A git repository of this computer goes to the VM, where the agents work on
# it; their work comes back as a branch here. Both ways as git bundles over
# the SSH connection: the VM needs no access to GitHub and no keys for it.
# On the VM the repository is ~/projects/FOLDER with these refs:
#   refs/vmforai/base   what was sent last
#   refs/vmforai/work   the work: the agents' commits, plus one more commit
#                        with what is not committed (new files too)
#   refs/vmforai/taken  the work as it was last taken back
# Here: refs/vmforai/NAME/base and refs/vmforai/NAME/work.

# work_tree: the tree of the working copy, new files included (not ignored
# ones), without touching the index.
# shellcheck disable=SC2016
WORK_TREE_SH='work_tree() {
  i_=$(mktemp) || return 1
  cp "$(git rev-parse --git-path index)" "$i_" 2>/dev/null || rm -f "$i_"
  GIT_INDEX_FILE=$i_ git add -A . >/dev/null 2>&1 && GIT_INDEX_FILE=$i_ git write-tree
  r_=$?; rm -f "$i_"; return $r_
}
project_cd() {
  case $1 in "~/"*) set -- "$HOME/${1#"~/"}" ;; esac
  cd "$1" 2>/dev/null && [ -d .git ]
}
'

# $1 folder, prints refs/vmforai/base when there is one.
# shellcheck disable=SC2016
PROJECT_BASE_SH=$WORK_TREE_SH'project_cd "$1" && git rev-parse -q --verify refs/vmforai/base 2>/dev/null'

# Receives a bundle on stdin. $1 folder, $2 branch, $3 $4 user name and
# email for commits, $5 1: also when the VM has work not taken back (it is
# kept as refs/vmforai/discarded/TIME), 2: also when the work was taken back
# but is not in what comes now, $6 the commit sent. Exit 5: there is
# such work; 7: the folder is not a vmforai project.
# shellcheck disable=SC2016
PROJECT_RECEIVE_SH='command -v git >/dev/null 2>&1 || pkg git >&2 || exit 1
'$WORK_TREE_SH'b_=$(mktemp) || exit 1
trap '\''rm -f "$b_"'\'' EXIT
cat >"$b_"
d=$1
case $d in "~/"*) d=$HOME/${d#"~/"} ;; esac
if [ ! -d "$d/.git" ]; then
  if [ -d "$d" ] && [ -n "$(ls -A "$d")" ]; then
    echo "vmforai: $1 on the VM has files and is not a git repository; move it away first" >&2; exit 7
  fi
  mkdir -p "$d" && cd "$d" && git init -q . && git symbolic-ref HEAD "refs/heads/$2" || exit 1
fi
cd "$d" || exit 1
git config user.name "$3" && git config user.email "$4" || exit 1
if [ -s "$b_" ]; then git fetch -q "$b_" "+HEAD:refs/vmforai/incoming" || exit 1; fi
new=$6
git cat-file -e "$new^{commit}" 2>/dev/null || { echo "vmforai: the VM did not get commit $new" >&2; exit 1; }
if git rev-parse -q --verify HEAD >/dev/null; then
  t=$(work_tree) || exit 1
  ok=
  base=$(git rev-parse -q --verify refs/vmforai/base)
  # Nothing done since it was sent, or everything taken back and part of what comes now.
  [ -n "$base" ] && [ "$t" = "$(git rev-parse "$base^{tree}")" ] && ok=1
  tk=$(git rev-parse -q --verify refs/vmforai/taken)
  [ -n "$tk" ] && [ "$t" = "$(git rev-parse "$tk^{tree}")" ] && { [ "$5" = 2 ] || git merge-base --is-ancestor "$tk" "$new"; } && ok=1
  if [ -z "$ok" ]; then
    [ "$5" = 1 ] || exit 5
    w=$(git commit-tree "$t" -p HEAD -m "Work discarded by vmforai project --discard") &&
      git update-ref "refs/vmforai/discarded/$(date +%Y%m%d-%H%M%S)" "$w" || exit 1
  fi
fi
git checkout -q -f -B "$2" "$new" && git clean -q -f -d && git update-ref refs/vmforai/base "$new" || exit 1
git update-ref -d refs/vmforai/incoming 2>/dev/null
exit 0
'

# The work as a bundle on stdout (refs/vmforai/work). $1 folder, $2 1: mark
# it as taken back. Exit 10: no work since it was sent; 4: no project.
# shellcheck disable=SC2016
PROJECT_WORK_SH='command -v git >/dev/null 2>&1 || { echo "vmforai: git is not installed on the VM" >&2; exit 1; }
'$WORK_TREE_SH'project_cd "$1" || exit 4
base=$(git rev-parse -q --verify refs/vmforai/base) || exit 4
t=$(work_tree) && h=$(git rev-parse HEAD) || exit 1
if [ "$t" = "$(git rev-parse "$h^{tree}")" ]; then w=$h
else w=$(git commit-tree "$t" -p "$h" -m "Work not committed on the VM") || exit 1
fi
git update-ref refs/vmforai/work "$w" || exit 1
[ "$w" = "$base" ] && exit 10
[ "$2" = 1 ] && { git update-ref refs/vmforai/taken "$w" || exit 1; }
git bundle create - refs/vmforai/work "^$base" 2>/dev/null
'

PROJ='' WAS_OFF=0
project_load() { # NAME: the profile and its project here (PROJ)
  load "$1"
  [[ -n ${P[PROJECT]:-} ]] || die "$NAME has no project; send one: $PROG project $NAME [FOLDER]"
  PROJ=${P[PROJECT]}
  git -C "$PROJ" rev-parse --git-dir >/dev/null 2>&1 || die "the project of $NAME, $PROJ, is not a git repository any more"
  git -C "$PROJ" rev-parse -q --verify "refs/vmforai/$NAME/base" >/dev/null ||
    die "$PROJ does not know what was sent to $NAME; send it again: $PROG project $NAME"
}

# Starts the VM when needed; project_done shuts it down again if it was off.
# (Runs come here too, with or without a project.)
project_connect() {
  WAS_OFF=0
  [[ -n $C_DOMAIN && $(domstate 2>/dev/null) != running ]] && WAS_OFF=1
  resolve_target
  build_ssh_opts
  [[ $C_OS != windows || -z ${P[PROJECT]:-} ]] || die "projects work with Linux VMs only"
}
project_done() {
  if ((WAS_OFF)) && [[ ${P[AUTOSTOP]:-on} == on ]]; then
    info "Shutting $NAME down again (it was off)."
    stop_vm 0 || true
  fi
}

# The VM's work into refs/vmforai/NAME/work here. $1 1: mark it as taken.
# Returns 10 when there is no work.
fetch_work() {
  local tmp rc=0
  tmp=$(mktemp)
  run_ssh -T -- "$TARGET" "$(remote_cmd "$REMOTE_ENV$PROJECT_WORK_SH" "$C_DIR" "$1")" </dev/null >"$tmp" || rc=$?
  case $rc in
    0) ;;
    10) rm -f "$tmp"; return 10 ;;
    4) rm -f "$tmp"; die "the project is not on $NAME (in ${C_DIR:-its home}); send it: $PROG project $NAME" ;;
    *) rm -f "$tmp"; die "could not get the work from $NAME (exit code $rc)" ;;
  esac
  git -C "$PROJ" fetch -q "$tmp" "+refs/vmforai/work:refs/vmforai/$NAME/work" ||
    { rm -f "$tmp"; die "could not read the work of $NAME into $PROJ"; }
  rm -f "$tmp"
}

show_work() { # how the work differs from what was sent: commits, then files
  local base=refs/vmforai/$NAME/base work=refs/vmforai/$NAME/work
  git -C "$PROJ" --no-pager log --format='  %h %s' "$base..$work"
  git -C "$PROJ" --no-pager diff --stat "$base" "$work"
}

cmd_project() {
  local name='' dir='' discard=0 off=0 top head branch known remote tmp rc=0 uname uemail
  while (($#)); do
    case $1 in
      --discard) discard=1 ;;
      --off) off=1 ;;
      -*) usage_error "project: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1
        elif [[ -z $dir ]]; then dir=$1
        else usage_error "project: too many arguments"
        fi ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "project: missing NAME"
  load "$name"
  if ((off)); then
    # shellcheck disable=SC2088 # a literal "~/" (the VM's home)
    [[ ${P[DIR]:-} == "~/projects/"* ]] && unset 'P[DIR]'
    unset 'P[PROJECT]' 'P[TEST]'
    write_profile "$NAME"
    say "$NAME has no project any more; agents start in the VM's home. (The copy on the VM stays.)"
    return 0
  fi
  command -v git >/dev/null || die "git is not installed on this computer"
  dir=${dir:-${P[PROJECT]:-.}}
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die "$dir is not in a git repository"
  head=$(git -C "$top" rev-parse -q --verify HEAD) || die "$top has no commits yet; commit first"
  branch=$(git -C "$top" symbolic-ref -q --short HEAD) || branch=vmforai
  [[ -z $(git -C "$top" status --porcelain 2>/dev/null) ]] ||
    info "Note: what is not committed in $top stays here; only commits go to the VM."
  # shellcheck disable=SC2088 # the VM's home, expanded there
  remote="~/projects/${top##*/}"
  if [[ -n ${P[PROJECT]:-} && ${P[PROJECT]} != "$top" ]]; then
    info "The project of $NAME was ${P[PROJECT]}; now it is $top."
    unset 'P[TEST]'  # its test command
  fi
  uname=$(git -C "$top" config user.name) || uname=$(id -un)
  uemail=$(git -C "$top" config user.email) || uemail="$(id -un)@localhost"

  project_connect
  known=$(run_ssh -T -- "$TARGET" "$(remote_cmd "$PROJECT_BASE_SH" "$remote")" </dev/null 2>/dev/null) || known=''
  tmp=$(mktemp)
  if [[ $known != "$head" ]]; then
    if [[ $known =~ ^[0-9a-f]{40,64}$ ]] && git -C "$top" merge-base --is-ancestor "$known" "$head" 2>/dev/null; then
      git -C "$top" bundle create -q "$tmp" HEAD "^$known" || { rm -f "$tmp"; die "git bundle failed"; }
    else
      git -C "$top" bundle create -q "$tmp" HEAD || { rm -f "$tmp"; die "git bundle failed"; }
    fi
  fi
  info "Sending $branch of $top to $NAME..."
  ((discard || !SEND_TAKEN)) || discard=2
  run_ssh -T -- "$TARGET" "$(remote_cmd "$REMOTE_ENV$PKG_SH$PROJECT_RECEIVE_SH" "$remote" "$branch" "$uname" "$uemail" \
    "$discard" "$head")" <"$tmp" || rc=$?
  rm -f "$tmp"
  case $rc in
    0) ;;
    5)
      printf '%s: %s has work on the project that was not taken back:\n' "$PROG" "$NAME" >&2
      printf '  see it: %s changes %s    take it: %s take %s\n' "$PROG" "$NAME" "$PROG" "$NAME" >&2
      printf '  or send anyway, setting that work aside on the VM: %s project %s --discard\n' "$PROG" "$NAME" >&2
      project_done
      exit 5 ;;
    7) project_done; exit 1 ;;
    *) project_done; die "sending the project failed (exit code $rc)" ;;
  esac
  git -C "$top" update-ref "refs/vmforai/$NAME/base" "$head"
  P[PROJECT]=$top P[DIR]=$remote
  write_profile "$NAME"
  say "Sent $branch ($(git -C "$top" rev-parse --short "$head")) of $top to $NAME, in $remote."
  if ((!QUIET)); then
    say "Agents start there: $PROG $NAME"
    say "What they changed: $PROG changes $NAME    as a branch here: $PROG take $NAME"
  fi
  project_done
}

cmd_changes() {
  local name='' stat=0 rc=0
  while (($#)); do
    case $1 in
      --stat) stat=1 ;;
      -*) usage_error "changes: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "changes: too many arguments"; name=$1 ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "changes: missing NAME"
  project_load "$name"
  project_connect
  fetch_work 0 || rc=$?
  project_done
  if ((rc == 10)); then
    say "No changes on $NAME since the project was sent."
    return 0
  fi
  say "Changes on $NAME in $C_DIR (sent: $(git -C "$PROJ" rev-parse --short "refs/vmforai/$NAME/base")):"
  show_work
  ((stat)) || { say ""; git -C "$PROJ" diff "refs/vmforai/$NAME/base" "refs/vmforai/$NAME/work"; }
}

cmd_take() {
  local name='' branch='' pr=0 rc=0 cur
  while (($#)); do
    case $1 in
      --branch) (($# >= 2)) || usage_error "take: --branch needs a name"; branch=$2; shift ;;
      --pr) pr=1 ;;
      -*) usage_error "take: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "take: too many arguments"; name=$1 ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "take: missing NAME"
  project_load "$name"
  branch=${branch:-vmforai/$NAME}
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "not a valid branch name: $branch"
  cur=$(git -C "$PROJ" symbolic-ref -q --short HEAD) || cur=''
  [[ $cur != "$branch" ]] || die "$branch is checked out in $PROJ; switch to another branch first"
  ((pr)) && { command -v gh >/dev/null || die "--pr needs the GitHub CLI (gh)"; }
  project_connect
  fetch_work 1 || rc=$?
  project_done
  if ((rc == 10)); then
    say "Nothing to take: no changes on $NAME since the project was sent."
    return 0
  fi
  git -C "$PROJ" branch -f "$branch" "refs/vmforai/$NAME/work" >/dev/null || die "could not make the branch $branch"
  say "The work of $NAME is the branch $branch in $PROJ:"
  show_work
  if ((pr)); then
    git -C "$PROJ" push -u origin "$branch" || die "could not push $branch to origin"
    (cd "$PROJ" && gh pr create --head "$branch" --fill) || die "gh pr create failed"
  else
    say ""
    say "Merge it: git merge $branch    or a pull request: $PROG take $NAME --pr"
    say "Then send the project again ($PROG project $NAME): the VM goes on from there."
  fi
}

# ------------------------------------------------------------------ runs: tasks without you

# A task for an agent, run on the VM without a terminal: in a tmux session
# of its own (run-ID), so it goes on when this computer disconnects, and
# with the options that let it act without asking (yolo_args: nobody is
# there to answer). Its files on the VM, in ~/.config/vmforai/runs/ID/:
# task, agent, dir, started, log, pid (while it runs), rc and ended.

# Runs in the tmux session. $1 the run's folder, $2 the launcher
# (CLAUDE_ENV_SH), then what the launcher takes.
# shellcheck disable=SC2016
RUNNER_SH='d=$1; e=$2; shift 2
echo $$ >"$d/pid"
sh -c "$e" vmforai "$@" >"$d/log" 2>&1 </dev/null
echo $? >"$d/rc"
date +%s >"$d/ended"
rm -f "$d/pid"
'

# Starts a run; the task comes on stdin. $1 folder, $2 agent, then its
# options (the task is added last). Prints the run's ID. Exit 120: the agent
# is not installed; 3: no tmux.
# shellcheck disable=SC2016
RUN_START_SH=$REMOTE_ENV"CLAUDE_ENV_SH=$(sq "$CLAUDE_ENV_SH")
RUNNER_SH=$(sq "$RUNNER_SH")
VMFORAI_HOOK=$(sq "$HOOK_SH")
VMFORAI_SETTINGS=$(sq "$CLAUDE_SETTINGS")"'
h=$HOME/.config/vmforai
if mkdir -p "$h" 2>/dev/null; then
  [ "$(cat "$h/hook.sh" 2>/dev/null)" = "$VMFORAI_HOOK" ] || printf "%s\n" "$VMFORAI_HOOK" >"$h/hook.sh"
  [ "$(cat "$h/claude-settings.json" 2>/dev/null)" = "$VMFORAI_SETTINGS" ] || printf "%s\n" "$VMFORAI_SETTINGS" >"$h/claude-settings.json"
fi
d=$1; a=$2; shift 2
cd_dir "$d" || { echo "vmforai: cannot use directory $d on the VM" >&2; exit 1; }
c=$(command -v "$a") || exit 120
command -v tmux >/dev/null 2>&1 || { echo "vmforai: runs need tmux on the VM (vmforai setup installs it)" >&2; exit 3; }
r=$h/runs
mkdir -p "$r" || exit 1
i=1
while ! mkdir "$r/$i" 2>/dev/null; do i=$((i + 1)); [ "$i" -lt 100000 ] || exit 1; done
cat >"$r/$i/task"
printf "%s\n" "$a" >"$r/$i/agent"; date +%s >"$r/$i/started"; pwd >"$r/$i/dir"
tmux new-session -d -s "run-$i" -c "$PWD" sh -c "$RUNNER_SH" vmforai "$r/$i" "$CLAUDE_ENV_SH" \
  "$h/$a-env" "$c" "$@" "$(cat "$r/$i/task")" || exit 1
echo "$i"
'

# One line per run: ID, agent, state (running, lost or the exit code),
# started, ended (epoch seconds), the task's first line; separated by \037
# (not tabs: bash's read would merge empty fields).
# shellcheck disable=SC2016
RUN_LIST_SH='r=$HOME/.config/vmforai/runs
[ -d "$r" ] || exit 0
for d in "$r"/*; do
  i=${d##*/}
  case $i in "" | *[!0-9]*) continue ;; esac
  if [ -f "$d/rc" ]; then s=$(cat "$d/rc")
  elif [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null; then s=running
  else s=lost
  fi
  printf "%s\037%s\037%s\037%s\037%s\037%s\n" "$i" "$(cat "$d/agent" 2>/dev/null)" "$s" "$(cat "$d/started" 2>/dev/null)" \
    "$(cat "$d/ended" 2>/dev/null)" "$(head -n 1 "$d/task" 2>/dev/null | cut -c1-200)"
done | sort -n
'

# $1 ID, $2 1: follow until it ends. The agent first, then the log.
# shellcheck disable=SC2016
RUN_LOG_SH='d=$HOME/.config/vmforai/runs/$1
[ -d "$d" ] || exit 4
cat "$d/agent" 2>/dev/null || echo unknown
running() { [ ! -f "$d/rc" ] && [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null; }
if [ "$2" = 1 ] && running; then
  tail -n +1 -F "$d/log" 2>/dev/null &
  t=$!
  while running; do sleep 1; done
  sleep 1
  kill "$t" 2>/dev/null
else
  cat "$d/log" 2>/dev/null
fi
if [ -f "$d/rc" ]; then echo "-- vmforai: the run ended, exit code $(cat "$d/rc")"
elif ! running; then echo "-- vmforai: the run was interrupted (the VM restarted?)"
fi
'

# $1 ID: running, done RC, lost or none.
# shellcheck disable=SC2016
RUN_STATE_SH='d=$HOME/.config/vmforai/runs/$1
if [ ! -d "$d" ]; then echo none
elif [ -f "$d/rc" ]; then echo "done $(cat "$d/rc")"
elif [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null; then echo running
else echo lost
fi
'

# $1 ID: stops a run.
# shellcheck disable=SC2016
RUN_STOP_SH='d=$HOME/.config/vmforai/runs/$1
[ -d "$d" ] || exit 4
tmux kill-session -t "run-$1" 2>/dev/null
[ -f "$d/pid" ] && kill "$(cat "$d/pid")" 2>/dev/null
[ -f "$d/rc" ] || { echo 143 >"$d/rc"; date +%s >"$d/ended"; }
rm -f "$d/pid"
'

# Deletes the runs that ended.
# shellcheck disable=SC2016
RUN_CLEAN_SH='r=$HOME/.config/vmforai/runs
n=0
for d in "$r"/*; do
  [ -f "$d/rc" ] || continue
  rm -rf "$d" && n=$((n + 1))
done
echo "$n"
'

# The same on Windows VMs, in PowerShell, with the same files. Windows
# has no tmux, and OpenSSH ends what a session started when it closes, so a
# run starts through WMI (Win32_Process.Create): its own process, outside the
# SSH session. The task goes to Claude Code on stdin.
# shellcheck disable=SC2016
WIN_RUNS_PS='$r = "$env:USERPROFILE\.config\vmforai\runs"
function Put($f, $v) { [IO.File]::WriteAllText($f, "$v`n") }
function Get1($f) { if (Test-Path -LiteralPath $f) { ([IO.File]::ReadAllText($f)).Trim() } }
function Now { [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() }
function Alive($d) {
  if (Test-Path -LiteralPath "$d\rc") { return $false }
  $p = Get1 "$d\pid"
  if (-not $p) { return $false }
  $x = Get-Process -Id $p -ErrorAction SilentlyContinue
  return [bool]($x -and $x.ProcessName -eq "powershell")
}
function RunDir($i) {
  $d = Join-Path $r $i
  if (-not (Test-Path -LiteralPath $d)) { Err "no run $i"; exit 4 }
  $d
}
'

# The script that runs in the run's own process (run.ps1 in its folder,
# with the command line in cmd).
# shellcheck disable=SC2016
WIN_RUNNER_PS=$WIN_RUNS_PS'$d = Split-Path -Parent $MyInvocation.MyCommand.Path
Put "$d\pid" $PID
# This process and all it starts go into a job that ends them all when it
# closes, as this process ends (or is stopped): nothing outlives the run.
try {
  Add-Type -Namespace Vmforai -Name Job -MemberDefinition ("[DllImport(`"kernel32.dll`")] public static extern IntPtr CreateJobObject(IntPtr a, IntPtr n);" +
    "[DllImport(`"kernel32.dll`")] public static extern bool SetInformationJobObject(IntPtr j, int c, byte[] i, uint n);" +
    "[DllImport(`"kernel32.dll`")] public static extern bool AssignProcessToJobObject(IntPtr j, IntPtr p);" +
    "[DllImport(`"kernel32.dll`")] public static extern IntPtr GetCurrentProcess();")
  $job = [Vmforai.Job]::CreateJobObject([IntPtr]::Zero, [IntPtr]::Zero)
  $info = New-Object byte[] $(if ([IntPtr]::Size -eq 8) { 144 } else { 112 })
  $info[17] = 0x20  # LimitFlags: JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE (0x2000)
  [void][Vmforai.Job]::SetInformationJobObject($job, 9, $info, $info.Length)
  [void][Vmforai.Job]::AssignProcessToJobObject($job, [Vmforai.Job]::GetCurrentProcess())
} catch { }
$tf = "$env:USERPROFILE\.config\vmforai\claude-env"
if (Test-Path -LiteralPath $tf) {
  foreach ($l in Get-Content -LiteralPath $tf) {
    if ($l -match "^(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=(\S+)$") { Set-Item "env:$($Matches[1])" $Matches[2] }
  }
}
$si = New-Object Diagnostics.ProcessStartInfo $env:ComSpec, ("/d /s /c `"" + (Get1 "$d\cmd") + " <`"$d\task`" >`"$d\log`" 2>&1`"")
$si.UseShellExecute = $false
$si.CreateNoWindow = $true
$si.WorkingDirectory = Get1 "$d\dir"
$p = [Diagnostics.Process]::Start($si)
$p.WaitForExit()
Put "$d\rc" $p.ExitCode
Put "$d\ended" (Now)
Remove-Item -LiteralPath "$d\pid" -ErrorAction SilentlyContinue
'

# Starts a run from the folder UPLOAD in the home folder (sent before with
# scp: task and run.ps1). Prints the run's ID.
win_run_start_ps() { # DIR UPLOAD CLAUDE_ARGS...
  local dir=$1 up=$2 a args=''
  shift 2
  for a in "$@"; do args+=" $a"; done  # fixed options, no quoting needed
  printf '%s' "$WIN_ENV_PS" "$WIN_RUNS_PS"
  cat <<EOF
\$up = Join-Path \$env:USERPROFILE $(psq "$up")
try {
  \$dir = Resolve-Dir $(psq "$dir")
  if (-not (Test-Path -LiteralPath \$dir)) { New-Item -ItemType Directory -Force -Path \$dir | Out-Null }
  \$dir = (Resolve-Path -LiteralPath \$dir).Path
  \$c = Get-Command claude -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
  if (-not \$c) { Err "Claude Code is not installed on the VM (vmforai setup installs it)"; exit 127 }
  New-Item -ItemType Directory -Force -Path \$r | Out-Null
  \$i = 1
  while (\$true) {
    try { New-Item -ItemType Directory -Path (Join-Path \$r \$i) -ErrorAction Stop | Out-Null; break } catch { \$i++ }
    if (\$i -gt 99999) { exit 1 }
  }
  \$d = Join-Path \$r \$i
  Move-Item -LiteralPath "\$up\task", "\$up\run.ps1" -Destination \$d
  Put "\$d\agent" "claude"
  Put "\$d\started" (Now)
  Put "\$d\dir" \$dir
  \$line = '"' + \$c.Source + '"'
  \$s = "\$env:USERPROFILE\.config\vmforai\claude-settings.json"
  if (Test-Path -LiteralPath \$s) { \$line += ' --settings "' + \$s + '"' }
  Put "\$d\cmd" (\$line + $(psq "$args"))
} finally { Remove-Item -LiteralPath \$up -Recurse -Force -ErrorAction SilentlyContinue }
\$cl = 'powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + "\$d\run.ps1" + '"'
\$x = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = \$cl; CurrentDirectory = \$dir }
if (\$x.ReturnValue -ne 0) { Err "could not start the run (Win32_Process.Create: \$(\$x.ReturnValue))"; exit 1 }
# Until the run notes its process, it would look interrupted.
for (\$n = 0; \$n -lt 50 -and -not (Test-Path -LiteralPath "\$d\pid") -and -not (Test-Path -LiteralPath "\$d\rc"); \$n++) { Start-Sleep -Milliseconds 100 }
"\$i"
exit 0
EOF
}

# shellcheck disable=SC2016
WIN_RUN_LIST_PS='if (-not (Test-Path -LiteralPath $r)) { exit 0 }
$o = [Console]::OpenStandardOutput()
Get-ChildItem -LiteralPath $r -Directory | Where-Object { $_.Name -match "^\d+$" } | Sort-Object { [int]$_.Name } | ForEach-Object {
  $d = $_.FullName
  $s = if (Test-Path -LiteralPath "$d\rc") { Get1 "$d\rc" } elseif (Alive $d) { "running" } else { "lost" }
  $t = (("" + (Get1 "$d\task")) -split "`n")[0].TrimEnd("`r")
  if ($t.Length -gt 200) { $t = $t.Substring(0, 200) }
  $b = [Text.Encoding]::UTF8.GetBytes((@($_.Name, (Get1 "$d\agent"), $s, (Get1 "$d\started"), (Get1 "$d\ended"), $t) -join [char]31) + "`n")
  $o.Write($b, 0, $b.Length)
}
$o.Flush()
exit 0
'

# shellcheck disable=SC2016
win_run_log_ps() { # ID FOLLOW
  printf '%s' "$WIN_ENV_PS" "$WIN_RUNS_PS"
  cat <<EOF
\$d = RunDir $(psq "$1")
\$follow = $(psq "$2")
EOF
  cat <<'EOF'
$o = [Console]::OpenStandardOutput()
function W($s) { $b = [Text.Encoding]::UTF8.GetBytes($s); $o.Write($b, 0, $b.Length); $o.Flush() }
$a = Get1 "$d\agent"
W ($(if ($a) { $a } else { "unknown" }) + "`n")
$pos = 0
function More {
  if (-not (Test-Path -LiteralPath "$d\log")) { return }
  $f = [IO.File]::Open("$d\log", "Open", "Read", "ReadWrite")
  try { [void]$f.Seek($script:pos, "Begin"); $f.CopyTo($o); $script:pos = $f.Position } finally { $f.Close() }
  $o.Flush()
}
if ($follow -eq "1") { while (Alive $d) { More; Start-Sleep 1 } }
More
if (Test-Path -LiteralPath "$d\rc") { W ("-- vmforai: the run ended, exit code " + (Get1 "$d\rc") + "`n") }
elseif (-not (Alive $d)) { W "-- vmforai: the run was interrupted (the VM restarted?)`n" }
exit 0
EOF
}

# shellcheck disable=SC2016
win_run_state_ps() { # ID
  printf '%s' "$WIN_RUNS_PS"
  printf '$d = Join-Path $r %s\n' "$(psq "$1")"
  cat <<'EOF'
if (-not (Test-Path -LiteralPath $d)) { "none" }
elseif (Test-Path -LiteralPath "$d\rc") { "done " + (Get1 "$d\rc") }
elseif (Alive $d) { "running" }
else { "lost" }
exit 0
EOF
}

# shellcheck disable=SC2016
win_run_stop_ps() { # ID
  printf '%s' "$WIN_ENV_PS" "$WIN_RUNS_PS"
  printf '$d = RunDir %s\n' "$(psq "$1")"
  cat <<'EOF'
# The run's process with everything it started (cmd, Claude, its tools).
if (Alive $d) { & taskkill.exe /T /F /PID (Get1 "$d\pid") 2>&1 | Out-Null }
if (-not (Test-Path -LiteralPath "$d\rc")) { Put "$d\rc" 143; Put "$d\ended" (Now) }
Remove-Item -LiteralPath "$d\pid" -ErrorAction SilentlyContinue
exit 0
EOF
}

# shellcheck disable=SC2016
WIN_RUN_CLEAN_PS='$n = 0
if (Test-Path -LiteralPath $r) {
  Get-ChildItem -LiteralPath $r -Directory | Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName "rc") } | ForEach-Object {
    Remove-Item -LiteralPath $_.FullName -Recurse -Force
    $n++
  }
}
"$n"
exit 0
'

# Runs one of the scripts above on the VM: sh on Linux, PowerShell on
# Windows. (Windows: every exit code but 0 arrives as 1.)
run_script() { # list|log|state|stop|clean ARGS...
  local kind=$1
  shift
  if [[ $C_OS == windows ]]; then
    case $kind in
      list) win_run "$WIN_RUNS_PS$WIN_RUN_LIST_PS" ;;
      log) win_run "$(win_run_log_ps "$@")" ;;
      state) win_run "$(win_run_state_ps "$@")" | tr -d '\r' ;;
      stop) win_run "$(win_run_stop_ps "$@")" ;;
      clean) win_run "$WIN_RUNS_PS$WIN_RUN_CLEAN_PS" | tr -d '\r' ;;
    esac
    return
  fi
  local s
  case $kind in
    list) s=$RUN_LIST_SH ;; log) s=$RUN_LOG_SH ;; state) s=$RUN_STATE_SH ;;
    stop) s=$RUN_STOP_SH ;; clean) s=$RUN_CLEAN_SH ;;
  esac
  run_ssh -T -- "$TARGET" "$(remote_cmd "$s" "$@")" </dev/null
}

# Claude Code's stream-json, readable: its text, and a line per tool it uses.
RUN_FORMAT_PY='import json, sys
def short(v, n=110):
    v = " ".join(str(v).split())
    return v if len(v) <= n else v[:n - 1] + "…"
for line in sys.stdin:
    line = line.rstrip("\n")
    try:
        e = json.loads(line)
    except ValueError:
        print(line, flush=True)
        continue
    if not isinstance(e, dict):
        continue
    t = e.get("type")
    if t == "assistant":
        for c in (e.get("message") or {}).get("content") or []:
            if c.get("type") == "text" and c.get("text", "").strip():
                print(c["text"].strip() + "\n", flush=True)
            elif c.get("type") == "tool_use":
                i = c.get("input") or {}
                arg = i.get("command") or i.get("file_path") or i.get("pattern") or i.get("url") or \
                    i.get("description") or ""
                print("* %s(%s)" % (c.get("name"), short(arg)), flush=True)
    elif t == "result":
        cost = e.get("total_cost_usd")
        print("-- %s: %s turns, %ss%s" % ("failed" if e.get("is_error") else "finished", e.get("num_turns", "?"),
              (e.get("duration_ms") or 0) // 1000, ", $%.2f" % cost if cost else ""), flush=True)
'

# The agent's options for a run (its task comes last).
run_args() { # AGENT
  case $1 in
    claude) printf '%s\n' -p --output-format stream-json --verbose --dangerously-skip-permissions ;;
    codex) printf '%s\n' exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox ;;
    gemini) printf '%s\n' --yolo -p ;;
    opencode) printf '%s\n' run --auto ;;
    aider) printf '%s\n' --yes-always --no-pretty --message ;;
  esac
}

agent_label() { # AGENT
  case $1 in
    claude) printf 'Claude Code' ;; codex) printf 'Codex' ;; gemini) printf 'Gemini CLI' ;;
    opencode) printf 'OpenCode' ;; *) printf '%s' "$1" ;;
  esac
}

desktop_notes() { [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v notify-send >/dev/null; }

notify_here() { # TITLE BODY [KIND]: on the desktop and the phone, unless NOTIFY is off
  [[ ${P[NOTIFY]:-on} == on ]] || return 0
  notify_all "$@"
}

run_note() { # ID STATE TASK: a run ended
  case $2 in
    "done 0") notify_here "$NAME: task $1 done" "$3" "done" ;;
    "done 143") notify_here "$NAME: task $1 stopped" "$3" ;;
    "done "*) notify_here "$NAME: task $1 failed (exit code ${2#done })" "$3" failed ;;
    *) notify_here "$NAME: task $1 interrupted" "$3" failed ;;
  esac
}

show_run_log() { # ID FOLLOW(0|1)
  run_script log "$1" "$2" | {
    local agent
    IFS= read -r agent || exit 4
    agent=${agent%$'\r'}
    if [[ $agent == claude ]] && command -v python3 >/dev/null; then python3 -u -c "$RUN_FORMAT_PY"; else cat; fi
  }
}

run_state() { # ID: running, done RC, lost, none (or empty when the VM cannot be asked)
  local -a SSH_OPTS=("${SSH_OPTS[@]}" -o BatchMode=yes)
  run_script state "$1" 2>/dev/null || true
}

# Windows: the task and the runner go over scp (a command line there holds
# at most 8191 characters), then the start script moves them in. Sets id.
win_start_run() { # TASK CLAUDE_ARGS...
  local task=$1 tmp up rc=0
  shift
  tmp=$(mktemp -d) || return 1
  up=vmforai-run-$$-$RANDOM
  mkdir "$tmp/$up"
  printf '%s\n' "$task" >"$tmp/$up/task"
  printf '%s' "$WIN_RUNNER_PS" >"$tmp/$up/run.ps1"
  run_scp -r "$tmp/$up" "$(scp_host):$up" || { rm -rf "$tmp"; die "could not send the task to $NAME (scp)"; }
  rm -rf "$tmp"
  id=$(win_run "$(win_run_start_ps "$C_DIR" "$up" "$@")") || rc=$?
  id=${id//$'\r'/}
  return "$rc"
}

cmd_run() {
  local name='' agent='' wait=0 rc=0 id state self task=''
  local -a words=() args=()
  while (($#)); do
    case $1 in
      --claude | --codex | --gemini | --opencode | --aider) agent=${1#--} ;;
      --wait) wait=1 ;;
      --hold) HOLD=1 ;;
      --) shift; words+=("$@"); break ;;
      -*) usage_error "run: unknown option $1 (the task after --, e.g. $PROG run dev -- \"$1 ...\")" ;;
      *) if [[ -z $name ]]; then name=$1; else words+=("$1"); fi ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "run: missing NAME"
  task=${words[*]}
  if [[ -z $task && ! -t 0 ]]; then task=$(cat); fi
  [[ -n ${task//[[:space:]]/} ]] || usage_error "run: give the task, e.g. $PROG run $name \"fix the failing tests\""
  load "$name"
  agent=${agent:-$C_AGENT}
  [[ -n $C_SESSION || $C_OS == windows ]] || die "runs need tmux on the VM; $NAME has no tmux session set (SESSION=)"
  [[ $C_OS == windows && $agent != claude ]] && die "only Claude Code runs on Windows VMs for now"
  mapfile -t args < <(run_args "$agent")
  project_connect
  local cmd
  if [[ $C_OS == windows ]]; then
    [[ $agent == claude ]] || { project_done; die "only Claude Code runs on Windows VMs for now"; }
    win_start_run "$task" "${args[@]}" || rc=$?
  else
    cmd=$(remote_cmd "$RUN_START_SH" "$C_DIR" "$agent" "${args[@]}")
    id=$(printf '%s\n' "$task" | run_ssh -T -- "$TARGET" "$cmd") || rc=$?
  fi
  if ((rc == 120)); then
    info "$agent is not installed on the VM yet; installing it."
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$AGENT_INSTALL_SH" "$agent")" </dev/null ||
      { project_done; die "installing $agent on the VM failed"; }
    note_agent "$agent"
    rc=0
    id=$(printf '%s\n' "$task" | run_ssh -T -- "$TARGET" "$cmd") || rc=$?
  fi
  if ((rc != 0)) || ! [[ $id =~ ^[0-9]+$ ]]; then project_done; die "could not start the run on $NAME (exit code $rc)"; fi
  [[ $agent == claude ]] || note_agent "$agent"
  if [[ $C_OS == windows ]]; then
    say "Run $id on $NAME: $(agent_label "$agent") works on it, without asking (in a process of its own)."
  else
    say "Run $id on $NAME: $(agent_label "$agent") works on it, without asking (in tmux session run-$id)."
  fi
  ((${RUN_STOP_AFTER:-0})) && WAS_OFF=1
  if ((!wait)); then
    local notify=0
    { desktop_notes || ntfy_conf; } && notify=1
    # Waits for the end to notify, and to shut down a VM that the run started.
    if ((notify || WAS_OFF)); then
      self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
      if command -v setsid >/dev/null; then
        setsid -f "$self" __runwait "$NAME" "$id" "$WAS_OFF" </dev/null >/dev/null 2>&1 || true
      else
        nohup "$self" __runwait "$NAME" "$id" "$WAS_OFF" </dev/null >/dev/null 2>&1 &
      fi
    fi
    ((notify)) && say "A notification comes when it ends."
    ((WAS_OFF)) && say "$NAME shuts down when it is done (unless something else uses it)."
    say "Follow it: $PROG runs $NAME $id -f    all runs: $PROG runs $NAME"
    [[ -n ${P[PROJECT]:-} ]] && say "Its changes: $PROG changes $NAME"
    return 0
  fi
  show_run_log "$id" 1 || true
  state=$(run_state "$id")
  ((QUIET)) || run_note "$id" "$state" "$task"
  [[ -n ${P[PROJECT]:-} ]] && ((!QUIET)) && say "Its changes: $PROG changes $NAME    as a branch here: $PROG take $NAME"
  project_done
  if ((HOLD)); then
    printf 'Press Enter to close.' >&2
    read -r _ || true
  fi
  [[ $state == "done 0" ]]
}

# Waits in the background for run $2 on $1 to end, then notifies; shuts
# the VM down again when the run had to start it ($3 = 1) and nothing else
# uses it.
cmd___runwait() {
  load "$1"
  local id=$2 state fails=0 task
  resolve_target >/dev/null 2>&1 || return 0
  build_ssh_opts
  while :; do
    sleep "${VMFORAI_WATCH_INTERVAL:-15}"
    if [[ -n $C_DOMAIN && $(domstate) != running ]]; then return 0; fi
    state=$(run_state "$id")
    case $state in
      running) fails=0; continue ;;
      "") ((++fails < 20)) || return 0; continue ;;
    esac
    break
  done
  task=$(run_script list 2>/dev/null | awk -F '\037' -v id="$id" '$1 == id { print $6 }') || task=''
  run_note "$id" "$state" "$task"
  if [[ ${3:-0} == 1 ]]; then autostop >/dev/null 2>&1 || true; fi
}

cmd_runs() {
  local name='' id='' follow=0 stop=0 clean=0 json=0 line i a s st en t sep=''
  while (($#)); do
    case $1 in
      -f | --follow) follow=1 ;;
      --hold) HOLD=1 ;;
      --stop) stop=1 ;;
      --clean) clean=1 ;;
      --json) json=1 ;;
      -*) usage_error "runs: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1
        elif [[ -z $id ]]; then [[ $1 =~ ^[0-9]+$ ]] || usage_error "runs: not a run ID: $1"; id=$1
        else usage_error "runs: too many arguments"
        fi ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "runs: missing NAME"
  load "$name"
  if [[ -n $C_DOMAIN && $(domstate 2>/dev/null) != running ]]; then
    ((json)) && { echo '[]'; return 0; }
    die "$NAME is off; its runs are on the VM (start it: $PROG start $NAME)"
  fi
  resolve_target
  build_ssh_opts
  if ((clean)); then
    say "Deleted $(run_script clean) run(s) that ended."
    return 0
  fi
  if [[ -n $id ]]; then
    if ((stop)); then
      run_script stop "$id" || die "no run $id on $NAME"
      say "Run $id on $NAME stopped."
      return 0
    fi
    show_run_log "$id" "$follow" || die "no run $id on $NAME"
    if ((HOLD)); then
      printf 'Press Enter to close.' >&2
      read -r _ || true
    fi
    return 0
  fi
  ((stop)) && usage_error "runs: --stop needs the run's ID"
  local out
  out=$(run_script list) || die "could not list the runs of $NAME"
  if ((json)); then
    printf '['
    while IFS=$'\037' read -r i a s st en t; do
      [[ $i =~ ^[0-9]+$ ]] || continue
      printf '%s\n {"id": %d, "agent": %s, "state": %s, "started": %s, "ended": %s, "task": %s}' "$sep" "$i" \
        "$(json_str "$a")" "$(json_str "$s")" "${st:-null}" "${en:-null}" "$(json_str "$t")"
      sep=,
    done <<<"$out"
    printf '\n]\n'
    return 0
  fi
  if [[ -z $out ]]; then
    say "No runs on $NAME yet. Start one: $PROG run $NAME \"the task\""
    return 0
  fi
  printf '%-4s %-12s %-13s %-17s %s\n' ID AGENT STATE STARTED TASK
  while IFS=$'\037' read -r i a s st en t; do
    [[ $i =~ ^[0-9]+$ ]] || continue
    case $s in
      running) s="running" ;;
      lost) s="interrupted" ;;
      0) s="done" ;;
      143) s="stopped" ;;
      *) s="failed ($s)" ;;
    esac
    printf '%-4s %-12s %-13s %-17s %s\n' "$i" "$(agent_label "$a")" "$s" "$(date -d "@${st:-0}" '+%Y-%m-%d %H:%M' 2>/dev/null)" "$t"
  done <<<"$out"
}

# ------------------------------------------------------------------ fix: from an issue to a pull request

# "vmforai fix NAME 42": issue 42 of the project's GitHub repository goes to
# an agent as a run, on a fresh copy of the project on the VM. Then the
# project's tests run there (--test, kept in the profile as TEST); when they
# fail, the agent gets their output and tries again (--tries in all). When
# they pass, the work comes back as the branch vmforai/issue-42, which is
# pushed, with a pull request that closes the issue. Only this computer talks
# to GitHub: the VM gets the issue's text, nothing more.

# The issue: a line with number, state, author, the comments' authors, URL
# and title (separated by \037), then its text with the comments.
# shellcheck disable=SC2016
FIX_ISSUE_JQ='([(.number | tostring), .state, .author.login, ([.comments[].author.login] | unique | join(" ")), .url, .title] | join("\u001f"))
  + "\nIssue #\(.number): \(.title)\n\(.url)\n\n\(.body)"
  + ([.comments[] | "\n\n--- Comment by \(.author.login):\n\n\(.body)"] | join(""))'

# Runs the tests: $1 the project's folder, $2 the command. With the proxy of
# a restricted network, like the agents. New files they leave (caches,
# reports) are deleted again: they are not part of the work.
# shellcheck disable=SC2016
FIX_TEST_SH='p=$HOME/.config/vmforai/proxy-env; [ -r "$p" ] && { set -a; . "$p"; set +a; }
cd_dir "$1" || exit 1
new_files() { git -c core.quotepath=off ls-files -o --exclude-standard; }
b_=$(mktemp) || exit 1
new_files >"$b_"
sh -c "$2" </dev/null 2>&1
r_=$?
new_files | grep -vxF -f "$b_" | while IFS= read -r f; do rm -f -- "$f"; done
rm -f "$b_"
exit "$r_"
'

# shellcheck disable=SC2016 # backquotes for the agent, not for the shell
fix_task() { # NUM ISSUE_TEXT TEST [TEST_OUTPUT]
  printf 'Fix this GitHub issue of the project in this folder.\n\n%s\n\n' "$2"
  printf 'When the fix is done:\n'
  if [[ -n $3 ]]; then
    printf -- '- run the tests with `%s`; they must pass\n' "$3"
  else
    printf -- '- run the tests of the project, if it has any; they must pass\n'
  fi
  printf -- '- commit your work, with a message that says what changed and ends with "Fixes #%s";\n' "$1"
  printf '  only what you commit is taken, so leave out what does not belong to the fix\n'
  printf 'There is no access to GitHub from here: do not push, and do not open a pull request.\n'
  if [[ -n ${4:-} ]]; then
    printf '\nYou already worked on it; your changes are in this folder. But the tests fail:\n\n$ %s\n%s\n\n' "$3" "$4"
    printf 'Find out why, and fix it.\n'
  fi
}

cmd_fix() {
  local name='' issue='' test='' tries=2 pr=1 draft=0 yes=0 branch='' agent='' discard=0 a
  while (($#)); do
    case $1 in
      --test) (($# >= 2)) || usage_error "fix: --test needs a command"; test=$2; shift ;;
      --tries)
        if (($# < 2)) || ! [[ $2 =~ ^[1-9]$ ]]; then usage_error "fix: --tries takes 1 to 9"; fi
        tries=$2; shift ;;
      --branch) (($# >= 2)) || usage_error "fix: --branch needs a name"; branch=$2; shift ;;
      --no-pr) pr=0 ;;
      --draft) draft=1 ;;
      -y | --yes) yes=1 ;;
      --discard) discard=1 ;;
      --hold) HOLD=1 ;;
      --claude | --codex | --gemini | --opencode | --aider) agent=$1 ;;
      -*) usage_error "fix: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1
        elif [[ -z $issue ]]; then issue=$1
        else usage_error "fix: too many arguments"
        fi ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "fix: missing NAME"
  [[ -n $issue ]] || usage_error "fix: which issue? e.g. $PROG fix $name 42"
  issue=${issue#\#}
  project_load "$name"
  [[ $C_OS != windows ]] || die "fix needs a project, and projects work with Linux VMs only"
  [[ -n $C_SESSION ]] || die "fix runs a task, and runs need tmux on the VM; $NAME has no tmux session set (SESSION=)"
  command -v gh >/dev/null || die "fix needs the GitHub CLI (gh) on this computer: https://cli.github.com"
  if [[ -n $test && $test != "${P[TEST]:-}" ]]; then
    P[TEST]=$test
    write_profile "$NAME"
  fi
  test=${test:-${P[TEST]:-}}

  local data meta text num state author others url title me w
  local -a who=()
  data=$(cd "$PROJ" && gh issue view "$issue" --json number,state,author,comments,url,title,body --jq "$FIX_ISSUE_JQ") ||
    die "could not read issue $issue with gh (in $PROJ)"
  meta=${data%%$'\n'*} text=${data#*$'\n'}
  IFS=$'\037' read -r num state author others url title <<<"$meta"
  [[ $num =~ ^[0-9]+$ ]] || die "gh gave no issue for $issue"
  # The issue's text steers the agent: say so when others wrote some of it.
  me=$(gh api user --jq .login 2>/dev/null) || me=''
  for w in $author $others; do
    [[ $w == "$me" || " ${who[*]} " == *" $w "* ]] || who+=("$w")
  done
  if ((${#who[@]} && !yes)); then
    info "Issue #$num has text by ${who[*]}, not you. The agent follows it as it is, without asking,"
    info "on $NAME (which has no access to your GitHub; what it makes comes back as a branch to look at)."
    if [[ -t 0 ]]; then
      read -r -p "Go on? [y/N] " a || a=''
      [[ $a == [yYeE]* ]] || exit 1
    else
      die "not going on without --yes"
    fi
  fi
  [[ $state == OPEN ]] || info "Note: issue #$num is ${state,,}."

  branch=${branch:-vmforai/issue-$num}
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "not a valid branch name: $branch"
  [[ $(git -C "$PROJ" symbolic-ref -q --short HEAD) != "$branch" ]] ||
    die "$branch is checked out in $PROJ; switch to another branch first"
  local base
  base=$(git -C "$PROJ" symbolic-ref -q --short HEAD) || base=''
  if ((pr)); then
    git -C "$PROJ" remote get-url origin >/dev/null 2>&1 || die "$PROJ has no remote origin to push to (or use --no-pr)"
    gh auth status >/dev/null 2>&1 || die "gh is not logged in: gh auth login (or use --no-pr)"
  fi

  say "Issue #$num: $title"
  project_connect
  local rc=0
  # A fresh copy of the project: work taken back before (a branch here) may go.
  (
    QUIET=1 SEND_TAKEN=1
    if ((discard)); then cmd_project "$NAME" --discard; else cmd_project "$NAME"; fi
  ) || rc=$?
  if ((rc)); then
    ((rc == 5)) && info "Or let fix set that work aside on the VM: $PROG fix $NAME $num --discard"
    project_done
    hold_prompt
    exit "$rc"
  fi

  local n=1 out task passed=0 hold=$HOLD
  out=$(mktemp)
  HOLD=0  # for the runs; fix waits at its end
  task=$(fix_task "$num" "$text" "$test")
  while :; do
    ((tries == 1)) || info "-- Try $n of $tries"
    rc=0
    (
      QUIET=1
      if [[ -n $agent ]]; then cmd_run "$NAME" --wait "$agent" -- "$task"; else cmd_run "$NAME" --wait -- "$task"; fi
    ) || rc=$?
    if ((rc)); then
      rm -f "$out"
      HOLD=$hold
      project_done
      die "the agent's run on $NAME did not finish well; nothing taken back (see: $PROG runs $NAME)"
    fi
    [[ -n $test ]] || break
    info "-- Running the tests on $NAME: $test"
    if run_ssh -T -- "$TARGET" "$(remote_cmd "$REMOTE_ENV$FIX_TEST_SH" "$C_DIR" "$test")" </dev/null | tee "$out"; then
      passed=1
      info "-- The tests pass."
      break
    fi
    info "-- The tests fail."
    ((n < tries)) || break
    n=$((n + 1))
    task=$(fix_task "$num" "$text" "$test" "$(tail -n 80 "$out" | cut -c1-300)")
  done
  rm -f "$out"
  HOLD=$hold

  rc=0
  fetch_work 1 || rc=$?
  project_done
  ((rc != 10)) || die "the agent changed nothing on $NAME: no branch, no pull request (what it did: $PROG runs $NAME)"
  # The agent's commits; what it did not commit (caches, notes) only when it
  # committed nothing.
  local work=refs/vmforai/$NAME/work sent=refs/vmforai/$NAME/base left=''
  if [[ $(git -C "$PROJ" log -1 --format=%s "$work") == "Work not committed on the VM" &&
    $(git -C "$PROJ" rev-parse "$work^") != "$(git -C "$PROJ" rev-parse "$sent")" ]]; then
    left=$(git -C "$PROJ" diff --name-only "$work^" "$work")
    work=$work^
  fi
  git -C "$PROJ" branch -f "$branch" "$work" >/dev/null || die "could not make the branch $branch"
  say "The work is the branch $branch in $PROJ:"
  git -C "$PROJ" --no-pager log --format='  %h %s' "$sent..$branch"
  git -C "$PROJ" --no-pager diff --stat "$sent" "$branch"
  [[ -z $left ]] || say "Left out, as the agent did not commit it: $(printf '%s' "$left" | tr '\n' ' ')"
  if [[ -n $test ]] && ((!passed)); then
    notify_here "$NAME: issue #$num, the tests still fail" "$title (the work: branch $branch)" failed
    say "The tests ($test) still fail after $tries tries, so no pull request. Look at the branch:"
    say "  git log -p $branch    more tries: $PROG fix $NAME $num --tries 3"
    hold_prompt
    return 1
  fi
  if ((!pr)); then
    notify_here "$NAME: issue #$num done" "$title (branch $branch)" "done"
    say "Merge it (git merge $branch), or a pull request: $PROG take $NAME --branch $branch --pr"
    hold_prompt
    return 0
  fi

  local url_pr body out
  # (Quiet: GitHub's own "create a pull request" hint would mislead here.)
  out=$(git -C "$PROJ" push -q --force-with-lease -u origin "$branch" 2>&1) ||
    { printf '%s\n' "$out" >&2; die "could not push $branch to origin"; }
  url_pr=$(cd "$PROJ" && gh pr view "$branch" --json url,state --jq 'select(.state == "OPEN") | .url' 2>/dev/null) || url_pr=''
  if [[ -n $url_pr ]]; then
    say "Pushed; its pull request was open already: $url_pr"
  else
    body="Fixes #$num."$'\n\n'$(git -C "$PROJ" log --reverse --format='- %s' "$sent..$branch")$'\n\n'
    if [[ -n $test ]]; then body+="The tests (\`$test\`) pass on the VM."
    else body+="Not tested by vmforai (no test command)."
    fi
    a=${agent#--}
    body+=$'\n\n'"Made by $(agent_label "${a:-$C_AGENT}") with \`vmforai fix\`, in a virtual machine."
    local -a args=(--head "$branch" --title "Fix #$num: $title" --body "$body")
    [[ -n $base ]] && args+=(--base "$base")
    ((draft)) && args+=(--draft)
    url_pr=$(cd "$PROJ" && gh pr create "${args[@]}") || die "gh pr create failed (the branch $branch is pushed)"
    url_pr=${url_pr##*$'\n'}
    say "Pull request: $url_pr"
  fi
  notify_here "$NAME: issue #$num, pull request ready" "$title
$url_pr" "done"
  hold_prompt
}

# ------------------------------------------------------------------ try: one task, several clones

# Copies of a libvirt VM, made in seconds: each disk is cloned in the pool
# (vol-clone keeps the shared base image as backing, so only the VM's own
# changes are copied; its internal snapshots are not). The copies get a new
# name (NAME-t1, ...), UUID and MAC address, their own profile (TRY=NAME)
# and the project's state; then each gets the task, with the agents taking
# turns. They shut down when their task ends.

try_names() { # NAME: the profiles that are tries of NAME
  local n
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    [[ $(sed -n 's/^TRY=//p' "$(profile_file "$n")" 2>/dev/null) == "$1" ]] && printf '%s\n' "$n"
  done < <(profile_names)
  return 0
}

clone_domain() { # SOURCE CLONE MEMORY_MB(or empty): defines CLONE as a copy of SOURCE's disks and settings
  local src=$1 dst=$2 mem=$3 xml tmp target path pool vol newvol newpath out
  local -a from=() to=()
  xml=$(vsh dumpxml --inactive "$src") || die "libvirt: cannot read VM $src"
  [[ $xml != *"<nvram"* ]] || die "$src boots with UEFI; try cannot copy its firmware settings yet"
  while read -r target path; do
    [[ -n $path && $path == /* ]] || continue
    pool=$(vsh vol-pool "$path" 2>/dev/null) || die "the disk $path of $src is not in a libvirt pool; cannot copy it"
    vol=${path##*/}
    if [[ $vol == "$src"* ]]; then newvol=$dst${vol#"$src"}; else newvol=$dst-$vol; fi
    if [[ $vol == "$src-seed.iso" ]]; then
      # A new cloud-init seed: a new instance with its own name. cloud-init
      # then writes new network settings for the card the copy has (the old
      # ones name the old card's MAC address) and new SSH host keys. (Its
      # own network-config would not do: cloud-init's networkd output
      # ignores name patterns.)
      [[ -f $C_KEY.pub ]] || die "no $C_KEY.pub for the copy's cloud-init settings"
      tmp=$(mktemp -d)
      mkdir "$tmp/seed"
      cloud_user_data "$dst" "$C_USER" "$(<"$C_KEY.pub")" copy >"$tmp/seed/user-data"
      printf 'instance-id: %s-%s\nlocal-hostname: %s\n' "$dst" "$(date +%s)" "$dst" >"$tmp/seed/meta-data"
      upload_seed "$pool" "$newvol" "$tmp/seed" || { rm -rf "$tmp"; die "$SEED_ERR"; }
      rm -rf "$tmp"
    else
      out=$(vsh vol-clone --pool "$pool" "$vol" "$newvol" 2>&1) || die "libvirt: $out"
    fi
    newpath=$(vsh vol-path --pool "$pool" "$newvol") || die "libvirt: no path for $newvol"
    from+=("$path") to+=("$newpath")
  done < <(vsh domblklist "$src" --details 2>/dev/null | awk '$2 == "disk" || $2 == "cdrom" { print $3, $4 }')
  tmp=$(mktemp)
  FROM=$(printf '%s\n' "${from[@]}") TO=$(printf '%s\n' "${to[@]}") NAME_NEW=$dst SRC=$src KIB=$((${mem:-0} * 1024)) awk '
    BEGIN { n = split(ENVIRON["FROM"], f, "\n"); split(ENVIRON["TO"], t, "\n") }
    /^ *<uuid>/ || /<mac address=/ { next }
    !named && /^ *<name>/ { sub(/<name>.*<\/name>/, "<name>" ENVIRON["NAME_NEW"] "</name>"); named = 1 }
    /<description>/ { sub(/<description>.*<\/description>/, "<description>created by vmforai (try of " ENVIRON["SRC"] ")</description>") }
    ENVIRON["KIB"] > 0 && /^ *<(memory|currentMemory)[ >]/ { sub(/>[0-9]+</, ">" ENVIRON["KIB"] "<") }
    /<source file=/ { for (i = 1; i <= n; i++) if ((k = index($0, f[i])) && f[i] != "") {
        $0 = substr($0, 1, k - 1) t[i] substr($0, k + length(f[i])); break } }
    { print }
  ' <<<"$xml" >"$tmp"
  out=$(vsh define "$tmp" 2>&1) || { rm -f "$tmp"; die "libvirt: $out"; }
  rm -f "$tmp"
  vsh desc "$dst" --config "created by vmforai (try of $src)" >/dev/null 2>&1 || true
}

# Starts copy NAME and waits until cloud-init has finished its first start
# there, connected without keeping the host key (cloud-init replaces it) and
# checking that the address really is this copy's (its hostname).
wait_copy() { # NAME
  load "$1"
  vsh start "$C_DOMAIN" >/dev/null 2>&1 || true
  build_ssh_opts
  local deadline=$((SECONDS + BOOT_TIMEOUT + 120)) out tries=0
  local -a nokeep=(-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR -o BatchMode=yes
    -o ConnectTimeout=5)
  while ((SECONDS < deadline)); do
    ((tries++)) && sleep 3
    check_still_running
    find_ip || continue
    out=$(ssh "${nokeep[@]}" "${SSH_OPTS[@]}" -T -- "$FOUND_IP" \
      'cloud-init status --wait >/dev/null 2>&1; cat /etc/hostname' </dev/null 2>/dev/null) || continue
    [[ ${out//[$'\r\n ']/} == "$NAME" ]] || continue
    # Its address may have changed with the new DHCP identity: once more.
    find_ip || continue
    out=$(ssh "${nokeep[@]}" "${SSH_OPTS[@]}" -T -- "$FOUND_IP" 'cat /etc/hostname' </dev/null 2>/dev/null) || continue
    [[ ${out//[$'\r\n ']/} == "$NAME" ]] || continue
    if [[ -f $KNOWN_HOSTS ]]; then
      ssh-keygen -R "vmforai-$NAME" -f "$KNOWN_HOSTS" >/dev/null 2>&1 || true
      rm -f "$KNOWN_HOSTS.old"
    fi
    return 0
  done
  return 1
}

cmd_try() {
  local name='' count='' agents='' mem='' stop=0 clean=0 i n k task='' avail need src_mem
  local -a words=() made=() list=() ags=()
  while (($#)); do
    case $1 in
      --agents | --memory)
        (($# >= 2)) || usage_error "try: $1 needs a value"
        case $1 in --agents) agents=${2// /} ;; --memory) mem=$2 ;; esac
        shift ;;
      --stop) stop=1 ;;
      --clean) clean=1 ;;
      --) shift; words+=("$@"); break ;;
      -*) usage_error "try: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1
        elif [[ -z $count && $1 =~ ^[0-9]+$ ]]; then count=$1
        else words+=("$1")
        fi ;;
    esac
    shift
  done
  [[ -n $name ]] || usage_error "try: missing NAME"
  load "$name"
  local src=$NAME a
  if ((clean)); then
    mapfile -t list < <(try_names "$src")
    ((${#list[@]})) || { say "$src has no tries."; return 0; }
    for n in "${list[@]}"; do
      ( cmd_delete "$n" --yes ) || warn "could not delete $n"
      [[ -n ${P[PROJECT]:-} ]] && git -C "${P[PROJECT]}" update-ref -d "refs/vmforai/$n/base" 2>/dev/null
      [[ -n ${P[PROJECT]:-} ]] && git -C "${P[PROJECT]}" update-ref -d "refs/vmforai/$n/work" 2>/dev/null
      true
    done
    say "Deleted the tries of $src (branches you took from them stay)."
    return 0
  fi
  [[ $count =~ ^[1-9]$ ]] || usage_error "try: how many copies, 1 to 9: $PROG try $src 3 \"the task\""
  [[ -n ${P[TRY]:-} ]] && die "$src is itself a try of ${P[TRY]}; try from ${P[TRY]}"
  [[ ${P[CREATED]:-} == 1 && -n $C_DOMAIN ]] || die "try copies VMs made with \"$PROG create\" only"
  [[ -z $mem || $mem =~ ^[1-9][0-9]*$ ]] || die "--memory takes MB, e.g. 2048"
  task=${words[*]}
  if [[ -z $task && ! -t 0 ]]; then task=$(cat); fi
  if [[ -n $agents ]]; then
    agent_list_ok "$agents" || die "--agents takes a comma-separated list of: $AGENTS"
  else
    agents=$C_AGENT
  fi
  IFS=, read -r -a ags <<<"$agents"
  # Memory: the copies run at the same time.
  src_mem=$(vsh dominfo "$C_DOMAIN" | awk '/^Max memory:/ { printf "%d", $3 / 1024 }')
  need=$((count * ${mem:-${src_mem:-2048}}))
  avail=$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo 2>/dev/null || echo 0)
  if ((avail > 0 && need > avail - 1024)); then
    die "$count copies need ${need} MB of memory; this computer has ${avail} MB free. Fewer copies, or less each: --memory $(( (avail - 1024) / count / 256 * 256 ))"
  fi
  case $(domstate) in
    "shut off") ;;
    *)
      ((stop)) || die "$src is running, and its disk changes while it runs. Leave it first, or add --stop to shut it down"
      info "Shutting $src down first, so its disk holds still."
      stop_vm 0 || die "could not shut $src down" ;;
  esac
  # The copies' names: NAME-t1, NAME-t2, ... (the first free ones).
  i=1
  while ((${#made[@]} < count)); do
    n=$src-t$i
    i=$((i + 1))
    profile_exists "$n" && continue
    vsh dominfo "$n" >/dev/null 2>&1 && continue
    valid_name "$n" || die "invalid name: $n"
    info "Copying $src to $n..."
    clone_domain "$src" "$n" "$mem"
    local -A copy=()
    for k in "${!P[@]}"; do copy[$k]=${P[$k]}; done
    P=()
    for k in "${!copy[@]}"; do P[$k]=${copy[$k]}; done
    # The agents take turns.
    P[DOMAIN]=$n P[TRY]=$src P[AUTOSNAP]=0 P[CREATED]=1 P[AGENT]=${ags[${#made[@]} % ${#ags[@]}]}
    unset 'P[HOST]'
    write_profile "$n"
    # cloud-init makes the copy new SSH host keys: forget any old ones of that name.
    if [[ -f $KNOWN_HOSTS ]]; then
      ssh-keygen -R "vmforai-$n" -f "$KNOWN_HOSTS" >/dev/null 2>&1 || true
      rm -f "$KNOWN_HOSTS.old"
    fi
    [[ -n ${P[PROJECT]:-} ]] && git -C "${P[PROJECT]}" update-ref "refs/vmforai/$n/base" "refs/vmforai/$src/base" 2>/dev/null
    made+=("$n")
    load "$src"
  done
  # One after the other: each first boot makes a new cloud-init instance
  # (machine-id, DHCP identity, SSH host keys) before the next one asks for
  # an address.
  for n in "${made[@]}"; do
    info "Starting $n (its first start sets it apart from the others)..."
    wait_copy "$n" || warn "$n did not finish its first start in time; see: virsh -c $C_URI console $n"
  done
  load "$src"
  say "Made ${#made[@]} copies of $src: ${made[*]}"
  if [[ -z ${task//[[:space:]]/} ]]; then
    say "No task given: they are yours to use (vmforai ${made[0]}). Delete them all: $PROG try $src --clean"
    return 0
  fi
  for n in "${made[@]}"; do
    ( RUN_STOP_AFTER=1 cmd_run "$n" -- "$task" ) || warn "could not start the task on $n"
  done
  say ""
  say "Each copy works on the task and shuts down when it is done (a notification comes for each)."
  say "Compare: $PROG tries $src    one's changes: $PROG changes ${made[0]}    take the best: $PROG take ${made[0]}"
  say "Delete them all afterwards: $PROG try $src --clean"
}

cmd_tries() {
  local name=${1:-} n state run rest out
  [[ -n $name ]] || usage_error "tries: missing NAME"
  load "$name"
  local src=$NAME
  local -a list=()
  mapfile -t list < <(try_names "$src")
  ((${#list[@]})) || { say "$src has no tries. Make some: $PROG try $src 3 \"the task\""; return 0; }
  printf '%-14s %-10s %-12s %s\n' COPY VM AGENT TASK
  for n in "${list[@]}"; do
    read_profile "$n"
    C_URI=${P[LIBVIRT_URI]:-qemu:///system}
    state=$(virsh -c "$C_URI" domstate "${P[DOMAIN]}" 2>/dev/null | head -n 1) || state=missing
    run=''
    if [[ -n ${P[PROJECT]:-} ]] && git -C "${P[PROJECT]}" rev-parse -q --verify "refs/vmforai/$n/work" >/dev/null 2>&1; then
      rest=$(git -C "${P[PROJECT]}" diff --shortstat "refs/vmforai/$n/base" "refs/vmforai/$n/work" 2>/dev/null)
      run=${rest:+changes:$rest}
    fi
    printf '%-14s %-10s %-12s %s\n' "$n" "${state:-?}" "$(agent_label "${P[AGENT]:-claude}")" "${run:-(vmforai runs $n; changes: vmforai changes $n)}"
  done
}

