class NewVM(Screen):
    def __init__(self, info, names):
        super().__init__()
        self.info, self.names = info or {}, names
        self._bindings = BindingsMap(self.make_bindings())

    @staticmethod
    def make_bindings():
        return [Binding("escape", "app.pop_screen", T("Back")), Binding("ctrl+s", "create", T("Create")),
                Binding("tab", "app.focus_next", show=False), Binding("shift+tab", "app.focus_previous", show=False)]

    def compose(self):
        host = self.info.get("host", {})
        images = self.info.get("images", [])
        total = host.get("memory_mb") or 8192
        free = host.get("memory_available_mb")
        cpus = host.get("cpus") or 2
        yield Header()
        with VerticalScroll(id="form"):
            yield Static(T("[b]New VM[/b]  A Linux VM from an official cloud image, with the AI assistants you "
                           "choose, ready to use."), classes="intro")
            if not host.get("libvirt", False) or host.get("missing"):
                need = ", ".join(host.get("missing") or []) or "libvirt"
                yield Static(T("[red]Cannot create VMs here yet: missing {need}.[/]\nDebian/Ubuntu: sudo apt "
                               "install libvirt-daemon-system virtinst xorriso curl\nArch: sudo pacman -S libvirt "
                               "virt-install libisoburn dnsmasq qemu-desktop curl", need=need), classes="error")
            templates = self.info.get("templates") or []
            if templates:
                yield Label(T("Template [dim](fills in the rest, and installs its packages)[/]"))
                yield Select([(T("None"), "")] + [(f"{t['name']}  [dim]{t['description']}[/]", t["name"])
                                                  for t in templates], value="", allow_blank=False, id="template",
                             compact=True)
            yield Label(T("Name"))
            yield Input(placeholder="dev", id="name", compact=True)
            yield Label(T("System"))
            yield Select([(f"{i['description']}{T('  (downloaded)') if i['downloaded'] else ''}", i["name"])
                          for i in images] or [("Debian 13", "debian13")],
                         value=images[0]["name"] if images else "debian13", allow_blank=False, id="image",
                         compact=True)
            avail = host.get("pool_available_gb")
            with Horizontal(classes="row"):
                with Vertical():
                    yield Label(T("RAM [dim](here: {total}, free {free})[/]", total=gb(total), free=gb(free)))
                    yield Select([(gb(m), m) for m in MEMORY_MB if m <= max(total - 1024, 1024)],
                                 value=4096 if total >= 6144 else 2048, allow_blank=False, id="memory", compact=True)
                with Vertical():
                    yield Label(T("CPUs [dim](here: {n})[/]", n=cpus))
                    yield Select([(str(c), c) for c in range(1, cpus + 1)], value=min(2, cpus), allow_blank=False,
                                 id="cpus", compact=True)
                with Vertical():
                    yield Label(T("Disk GB") + (T(" [dim]({n} free)[/]", n=avail) if avail is not None else ""))
                    yield Input("20", type="integer", id="disk", compact=True)
            yield Label(T("AI assistants [dim](the first one checked opens with \"vmforai NAME\")[/]"))
            with Horizontal(id="agents"):
                for key, label in AGENTS:
                    yield Checkbox(label, key == "claude", id=f"agent-{key}", compact=True)
            with Horizontal(classes="row"):
                with Vertical():
                    yield Label(T("Ports [dim](reach them here while connected)[/]"))
                    yield Input(placeholder=T("e.g. 3000,5173"), id="ports", compact=True)
                with Vertical():
                    yield Label(T("Shut down when unused for"))
                    yield Select([(idle_label(m), m) for m in IDLE_MINUTES], value=30, allow_blank=False, id="idle",
                                 compact=True)
            yield Label(T("Project [dim](a git repository of this computer, to work on in the VM; optional)[/]"))
            yield Input(home_short(HERE), placeholder="~/code/app", id="project", compact=True)
            yield Static("", id="error", classes="error")
            yield Static("", id="command", classes="command")
            with Horizontal(classes="buttons"):
                yield Button(T("Create  (Ctrl-S)"), id="create", variant="primary",
                             disabled=not host.get("libvirt", False) or bool(host.get("missing")))
                yield Button(T("Back"), id="back")
        yield Footer()

    def on_mount(self):
        self.query_one("#name", Input).focus()
        self.refresh_command()

    def values(self):
        def val(i):
            return self.query_one(f"#{i}")
        return {
            "name": val("name").value.strip(),
            "image": val("image").value,
            "memory": val("memory").value,
            "cpus": val("cpus").value,
            "disk": val("disk").value.strip(),
            "agents": [k for k, _ in AGENTS if self.query_one(f"#agent-{k}", Checkbox).value],
            "ports": val("ports").value.replace(" ", ""),
            "idle": val("idle").value,
            "project": os.path.expanduser(val("project").value.strip()),
            "template": self.query_one("#template", Select).value if self.query("#template") else "",
        }

    def problem(self, v):
        if not v["name"]:
            return T("Give the VM a name.")
        if not NAME_RE.match(v["name"]):
            return T("The name may have letters, digits, . _ and - only.")
        if v["name"] in self.names:
            return T("There is a VM named {n} already.", n=v["name"])
        if not v["disk"].isdigit() or not 5 <= int(v["disk"]) <= 4096:
            return T("Disk: a size in GB, at least 5.")
        avail = self.info.get("host", {}).get("pool_available_gb")
        if avail is not None and int(v["disk"]) > avail:
            return T("Disk: the libvirt pool has {n} GB free (the disk grows as it fills, but not beyond that).",
                     n=avail)
        if not v["agents"]:
            return T("Choose at least one AI assistant.")
        if v["ports"] and not re.match(r"^[0-9]+(,[0-9]+)*$", v["ports"]):
            return T("Ports: numbers separated by commas, e.g. 3000,5173.")
        if v["ports"] and any(not 1 <= int(p) <= 65535 for p in v["ports"].split(",")):
            return T("Ports go from 1 to 65535.")
        if v["project"] and not git_top(v["project"]):
            return T("Project: {p} is not a git repository.", p=home_short(v["project"]))
        return ""

    def refresh_command(self):
        v = self.values()
        v2 = dict(v, name=v["name"] or "NAME", agents=v["agents"] or ["claude"], disk=v["disk"] or "20")
        self.query_one("#command", Static).update(T("[dim]The same from a terminal: vmforai {cmd}[/]",
                                                    cmd=shlex.join(create_args(v2))))

    @on(Select.Changed, "#template")
    def template_chosen(self, e):
        t = next((t for t in self.info.get("templates") or [] if t["name"] == e.value), None)
        if not t:
            return
        images = {i["name"] for i in self.info.get("images", [])}
        if t["image"] in images:
            self.query_one("#image", Select).value = t["image"]
        for key, value in (("#memory", t["memory"]), ("#cpus", t["cpus"])):
            select = self.query_one(key, Select)
            options = [v for _, v in select._options]
            # The nearest there is here (less RAM or fewer CPUs than it asks for).
            fits = [v for v in options if isinstance(v, int) and v <= value]
            if fits:
                select.value = max(fits)
        self.query_one("#disk", Input).value = str(t["disk"])
        for key, _ in AGENTS:
            self.query_one(f"#agent-{key}", Checkbox).value = key in t["agents"]
        self.query_one("#ports", Input).value = ",".join(map(str, t["ports"]))

    @on(Input.Changed)
    @on(Select.Changed)
    @on(Checkbox.Changed)
    def changed(self):
        self.query_one("#error", Static).update("")
        self.refresh_command()

    @on(Button.Pressed, "#back")
    def back(self):
        self.app.pop_screen()

    @on(Button.Pressed, "#create")
    def action_create(self):
        if self.query_one("#create", Button).disabled:
            return
        v = self.values()
        if err := self.problem(v):
            self.query_one("#error", Static).update(err)
            return
        self.app.pop_screen()
        self.app.start_create(v)


class Creating(Vertical):
    """A tab that runs "vmforai create" and shows what it prints. The rest of
    the UI stays usable meanwhile (Ctrl+] or Esc: the list)."""
    BINDINGS = [Binding("escape", "app.home", show=False)]

    def __init__(self, v, **kw):
        super().__init__(**kw)
        self.v, self.proc, self.rc = v, None, None

    def compose(self):
        yield Static(T("[b]Creating {n}[/b]: downloading the image (once), making the VM, then installing tmux and "
                       "the AI assistants. This takes a few minutes.", n=self.v["name"]), id="status")
        yield RichLog(id="output", wrap=True, markup=False)
        with Horizontal(classes="buttons"):
            agent = self.v["agents"][0]
            yield Button(T("Open {agent}", agent=AGENT_NAMES[agent]), id="open", variant="success", disabled=True)
            yield Button(T("Shell"), id="shell", disabled=True)
            if "claude" in self.v["agents"]:
                yield Button(T("Log Claude in"), id="login", disabled=True)
            yield Button(T("Cancel"), id="cancel", variant="error")
            yield Button(T("Close"), id="back", disabled=True)

    def on_mount(self):
        self.run_create()

    def focus_default(self):
        if self.app.current_pane() != self.id:  # a retry after you went to another tab
            return
        b = [b for b in self.query(Button) if not b.disabled and b.id != "cancel"]
        try:
            (b[0] if b else self.query_one("#output", RichLog)).focus()
        except NoMatches:  # not there yet
            self.call_after_refresh(self.focus_default)

    def status_label(self):
        if self.rc is None:
            return T("creating…")
        return T("ready") if self.rc == 0 else T("failed")

    @work(thread=True)
    def run_create(self):
        log = self.query_one("#output", RichLog)
        args = create_args(self.v)
        self.app.call_from_thread(log.write, "$ vmforai " + shlex.join(args))
        try:
            self.proc = subprocess.Popen([VMFORAI, *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                         stdin=subprocess.DEVNULL, text=True, bufsize=1, start_new_session=True)
        except OSError as e:
            self.app.call_from_thread(log.write, str(e))
            self.app.call_from_thread(self.finished, 1)
            return
        for line in self.proc.stdout:
            self.app.call_from_thread(log.write, line.rstrip("\n").replace("\r", ""))
        self.app.call_from_thread(self.finished, self.proc.wait())

    def finished(self, rc):
        self.rc = rc
        status = self.query_one("#status", Static)
        if rc == 0:
            status.update(T("[green]Done.[/] {n} is ready.", n=self.v["name"]))
            for b in self.query(Button):
                b.disabled = b.id == "cancel"
            if self.app.current_pane() == self.id:
                self.query_one("#open", Button).focus()
        else:
            status.update(T("[red]Creating {n} failed[/] (exit code {rc}); see above. If a half-made VM is left, "
                            "delete it in the list (d).", n=self.v["name"], rc=rc))
            self.query_one("#cancel", Button).disabled = True
            self.query_one("#back", Button).disabled = False
        self.app.create_finished(self)

    @on(Button.Pressed, "#cancel")
    def cancel(self):
        if self.proc and self.proc.poll() is None:
            os.killpg(self.proc.pid, signal.SIGTERM)

    def running(self):
        return self.rc is None and self.proc is not None and self.proc.poll() is None

    @on(Button.Pressed, "#open")
    def open_vm(self):
        self.app.open_session(self.v["name"], self.v["agents"][0])
        self.app.close_pane(self.id)

    @on(Button.Pressed, "#shell")
    def open_shell(self):
        self.app.open_session(self.v["name"], "shell")
        self.app.close_pane(self.id)

    @on(Button.Pressed, "#login")
    def login(self):
        self.app.open_session(self.v["name"], "login")
        self.app.close_pane(self.id)

    @on(Button.Pressed, "#back")
    def close(self):
        if self.rc is not None:
            self.app.close_pane(self.id)


