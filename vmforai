# The proxy: python3 -c "$PROXY_PY" ALLOW_FILE LOG_FILE BIND PORT URI DOMAIN.
# It ends when the VM is no longer running.
PROXY_PY='import asyncio, os, subprocess, sys, time
allow_file, log_file, bind, port, uri, domain = sys.argv[1:7]
patterns, mtime = [], None

def load():
    global patterns, mtime
    try:
        m = os.stat(allow_file).st_mtime
    except OSError:
        patterns, mtime = [], None
        return
    if m != mtime:
        mtime = m
        patterns = [l.split("#", 1)[0].strip().lower() for l in open(allow_file, encoding="utf-8")]
        patterns = [p for p in patterns if p]

def allowed(host, port):
    load()
    host = host.lower().rstrip(".")
    for p in patterns:
        hp, _, pp = p.partition(":")
        if (pp and pp != str(port)) or (not pp and port not in (80, 443)):
            continue
        if hp == host or (hp.startswith("*.") and (host == hp[2:] or host.endswith(hp[1:]))):
            return True
    return False

def note(host, port):
    try:
        with open(log_file, "a", encoding="utf-8") as f:
            f.write("%d %s:%d\n" % (time.time(), host, port))
    except OSError:
        pass

async def pipe(r, w):
    try:
        while True:
            data = await r.read(65536)
            if not data:
                break
            w.write(data)
            await w.drain()
    except Exception:
        pass
    finally:
        try:
            w.close()
        except Exception:
            pass

async def refuse(writer, status, text):
    writer.write(("HTTP/1.1 %s\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\n%s\n" % (status, text)).encode())
    try:
        await writer.drain()
    finally:
        writer.close()

async def handle(reader, writer):
    try:
        head = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), 30)
        method, target, version = head.split(b"\r\n", 1)[0].decode("latin-1").split(" ", 2)
    except Exception:
        writer.close()
        return
    connect = method.upper() == "CONNECT"
    try:
        if connect:
            host, _, p = target.rpartition(":")
            host, p, first = host.strip("[]"), int(p), b""
        elif target.lower().startswith("http://"):
            hostport, _, path = target[7:].partition("/")
            host, _, p = hostport.partition(":")
            p = int(p or 80)
            lines = [l for l in head.split(b"\r\n") if not l.lower().startswith(b"proxy-")]
            lines[0] = ("%s /%s %s" % (method, path, version)).encode("latin-1")
            first = b"\r\n".join(lines)
        else:
            return await refuse(writer, "400 Bad Request", "vmforai proxy: use it as a proxy")
    except ValueError:
        return await refuse(writer, "400 Bad Request", "vmforai proxy: bad request")
    if not allowed(host, p):
        note(host, p)
        return await refuse(writer, "403 Forbidden",
                            "vmforai: %s is not allowed from this VM (on this computer: vmforai net %s allow %s)"
                            % (host, domain, host))
    try:
        ur, uw = await asyncio.wait_for(asyncio.open_connection(host, p),
                                        float(os.environ.get("VMFORAI_PROXY_CONNECT_TIMEOUT", "20")))
    except Exception as e:
        return await refuse(writer, "502 Bad Gateway", "vmforai proxy: %s:%d: %s" % (host, p, e))
    if connect:
        writer.write(b"HTTP/1.1 200 Connection established\r\n\r\n")
        await writer.drain()
    else:
        uw.write(first)
        await uw.drain()
    await asyncio.gather(pipe(reader, uw), pipe(ur, writer))

async def watch():
    every = float(os.environ.get("VMFORAI_PROXY_WATCH", "20"))
    while True:
        await asyncio.sleep(every)
        r = subprocess.run(["virsh", "-c", uri, "domstate", domain], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.startswith("running"):
            os._exit(0)

async def main():
    server = await asyncio.start_server(handle, bind, int(port))
    async with server:
        await asyncio.gather(server.serve_forever(), watch())

asyncio.run(main())
'

# On the VM: proxy settings. $1 the proxy URL. Without sudo only what
# vmforai starts uses it (proxy-env, read by the launcher).
# shellcheck disable=SC2016
NET_GUEST_ON_SH='h=$HOME/.config/vmforai
mkdir -p "$h" || exit 1
p=$1 n=localhost,127.0.0.1,::1
