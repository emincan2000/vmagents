# ------------------------------------------------------------------ update

# vmforai puts itself at its latest release: the script (or the .deb) from
# the GitHub release, checked against the release's SHA256SUMS, in place of
# this one. VMFORAI_UPDATE_URL: another place with the same layout (tests).
UPDATE_URL=${VMFORAI_UPDATE_URL:-https://github.com/emincan2000/vmforai}
UPDATE_RAW=${VMFORAI_UPDATE_RAW:-https://raw.githubusercontent.com/emincan2000/vmforai}

latest_version() { # prints it; with 1, a check from the last day will do
  local f=$CACHE_DIR/latest v
  if [[ ${1:-0} == 1 && -f $f ]] && [[ -n $(find "$f" -mmin -1440 2>/dev/null) ]]; then
    v=$(cat "$f")
  else
    # The latest release's page is .../releases/tag/vX.Y.Z.
    v=$(curl -fsSL -m 20 -o /dev/null -w '%{url_effective}' "$UPDATE_URL/releases/latest" 2>/dev/null) || return 1
    v=${v##*/tag/v}
    [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    mkdir -p "$CACHE_DIR" && printf '%s\n' "$v" >"$f"
  fi
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && printf '%s\n' "$v"
}

newer() { # A B: 0 when version A is newer than B
  [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1) == "$1" ]]
}

# FILE NAME VERSION: checks FILE against the release's SHA256SUMS, when it
# has one (releases before 0.23.0 do not).
release_sum_ok() {
  local sums want got
  sums=$(curl -fsSL -m 30 "$UPDATE_URL/releases/download/v$3/SHA256SUMS" 2>/dev/null) || return 0
  want=$(awk -v n="$2" '$2 == n || $2 == "*" n { print $1 }' <<<"$sums")
  [[ -n $want ]] || return 0
  got=$(sha256sum "$1" | cut -d' ' -f1)
  [[ $got == "$want" ]]
}

cmd_update() {
  local check=0 json=0 cached=0 latest self dir tmp deb
  while (($#)); do
    case $1 in
      --check) check=1 ;;
      --json) json=1 ;;
      --cached) cached=1 ;;
      *) usage_error "update: unknown argument $1" ;;
    esac
    shift
  done
  command -v curl >/dev/null || die "update needs curl"
  latest=$(latest_version "$cached") || die "could not find the latest version on $UPDATE_URL (no internet?)"
  if ((json)); then
    printf '{"current": %s, "latest": %s, "newer": %s}\n' "$(json_str "$VERSION")" "$(json_str "$latest")" \
      "$(newer "$latest" "$VERSION" && echo true || echo false)"
    return 0
  fi
  if ! newer "$latest" "$VERSION"; then
    say "vmforai $VERSION is the latest."
    return 0
  fi
  say "vmforai $latest is out (this is $VERSION). What is new: $UPDATE_URL/releases/tag/v$latest"
  if ((check)); then
    say "Update: $PROG update"
    return 0
  fi
  self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
  dir=${self%/*}
  # Installed some other way: updated that way.
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 && [[ -f $dir/install.sh ]]; then
    die "this vmforai runs from a git checkout ($dir): git pull there (or install it: $dir/install.sh)"
  fi
  if command -v pacman >/dev/null && pacman -Qo "$self" >/dev/null 2>&1; then
    die "vmforai came from the AUR here: update it the same way (e.g. yay -S vmforai)"
  fi
  if command -v dpkg >/dev/null && dpkg -S "$self" >/dev/null 2>&1; then
    tmp=$(mktemp -d)
    deb=$tmp/vmforai_${latest}_all.deb
    info "Downloading vmforai_${latest}_all.deb..."
    curl -fsSL -m 120 -o "$deb" "$UPDATE_URL/releases/download/v$latest/vmforai_${latest}_all.deb" ||
      { rm -rf "$tmp"; die "could not download the package"; }
    release_sum_ok "$deb" "vmforai_${latest}_all.deb" "$latest" || { rm -rf "$tmp"; die "the package is not the one released (its checksum differs)"; }
    chmod 755 "$tmp" && chmod 644 "$deb"
    info "Installing it (sudo asks for your password)..."
    sudo apt-get install -y "$deb" || { rm -rf "$tmp"; die "installing the package failed; it is the .deb from $UPDATE_URL/releases"; }
    rm -rf "$tmp"
  else
    [[ -w $dir ]] || die "cannot write $dir: update as the user who installed vmforai there"
    tmp=$(mktemp "$dir/.vmforai-update.XXXXXX") || die "cannot write $dir"
    curl -fsSL -m 120 -o "$tmp" "$UPDATE_URL/releases/download/v$latest/vmforai" 2>/dev/null ||
      curl -fsSL -m 120 -o "$tmp" "$UPDATE_RAW/v$latest/vmforai" ||
      { rm -f "$tmp"; die "could not download vmforai $latest"; }
    if ! grep -qx "VERSION=$latest" "$tmp" || ! bash -n "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      die "what came down is not vmforai $latest; nothing changed"
    fi
    release_sum_ok "$tmp" vmforai "$latest" || { rm -f "$tmp"; die "the download is not the one released (its checksum differs); nothing changed"; }
    chmod 755 "$tmp"
    mv -f "$tmp" "$self" || { rm -f "$tmp"; die "could not replace $self"; }
  fi
  rm -f "$CACHE_DIR/latest"
  say "Updated: $("$self" --version)."
  # The phone page comes from the server that runs: the new one.
  if phone_running; then
    "$self" phone off >/dev/null 2>&1 && "$self" phone >/dev/null 2>&1 &&
      say "The phone server runs the new version too (the link is the same)."
  fi
  return 0
}

